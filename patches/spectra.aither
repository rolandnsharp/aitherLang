# spectra — one held note whose partials move: a string bends into a
# metal bar and then into a golden-ratio spectrum no instrument has.
#
# Not a crossfade. acid_complex's PARADIGM knobs mix finished sounds by
# volume, so half way you hear two. Here every partial's FREQUENCY moves:
# the 2nd glides from 2x toward 2.778x, the 3rd from 3x toward 5.444x,
# and the note dissolves into metal as one sound. The ratios blend
# geometrically (a^(1-u) * b^u), so the glide is even in pitch.
#
#   string  n                      harmonic: the partials fuse into a note
#   bar     ((2n + 1) / 3)^2       a free metal bar (Euler-Bernoulli):
#                                  1, 2.778, 5.444, 9, 13.44 ...
#   phi     1.618^(n - 1)          each partial the golden ratio above the
#                                  last: no physical object rings this way
#
# On the gamepad (tools/pad, then aither midi connect aither-pad); all at 0
# is a dark harmonic drone on E2:
#   A  up/down  morph     string -> bar -> phi
#      l/r      stretch   piano stiffness, taken past any piano
#   B  up/down  jitter    each partial drifts at a rate set by its own n,
#                         so the spectrum shimmers instead of sitting
#      l/r      bright    how slowly the partials roll off
#   X  up/down  pitch     E2, two octaves up
#      l/r      strike    0 sustains; up, it is struck, high partials
#                         dying first, the way a bell does
#   Y  up/down  rate      strikes per second, 0.25 .. 4
#      l/r      space     reverb

let morph   = midi_cc(20)
let stiff   = 0.004 * midi_cc(21) * midi_cc(21)
let jitter  = 0.02 * midi_cc(22)
let rolloff = 1.2 - midi_cc(23)
let f0      = 82.41 * pow(2, 2 * midi_cc(24))
let strike  = midi_cc(25)
let rate    = 0.25 * pow(16, midi_cc(26))
let space   = midi_cc(27)

# Where partial n sits, as a multiple of f0. u runs string -> bar over
# the first half of the morph knob, w runs bar -> phi over the second. The blend
# is geometric, done in logs: ln n, ln bar(n) and ln phi(n) are
# constants once sum unrolls n, so a partial costs one exp, not the five
# pows the direct form took (too slow for the uConsole's cores).
def partial(n, u, w):
  let lnBar = 2 * log((2 * n + 1) / 3)
  let lnPhi = (n - 1) * log(1.618)
  exp(log(n) * (1 - u) + lnBar * (u - w) + lnPhi * w)

let u    = clamp(morph * 2, 0, 1)
let w    = clamp(morph * 2 - 1, 0, 1)
let hits = impulse(rate)

play tone:
  sum(20, n =>
    let drift = abs(phasor(n / 44 + 0.01) * 4 - 2) - 1   # a slow triangle, rate set by n
    let pf = f0 * partial(n, u, w) * sqrt(1 + n * n * stiff)
      * (1 + jitter * drift)
    let ring = discharge(hits, 1.5 + n * 0.8)
    let env = (1 - strike) + strike * ring
    if pf >= sr * 0.45 then 0
    else env * sin(TAU * phasor(pf)) * exp(-rolloff * log(n)))
  * 0.12

tone
|> tanh
|> reverb(1.5 + 3 * space, 0.15 + 0.45 * space)
