# spinfield: a sound field turned every way, by spin (notes/spinors-
# 2026-11-05.md; SPEC "Pairs of pairs").
#
# Three sounds sit round a listener, one low ahead, one circling
# overhead, one going round at the height of the ears. Each sound's
# direction is a pair of pairs whose first number is 0 (Hamilton's
# vector, x ahead, y to the left, z up). The field they make is held as
# its first modes: W, everywhere at once, and the dipole, a direction
# and a size, to which a sound s adds s along its direction.
#
# The head is a rotation, a pair of pairs: a yaw, a pitch and a roll,
# each `about` its axis, composed by Hamilton's product. Hearing turns
# each ear's direction by the head (`apply`), and reads the field there:
# (W + ear . dipole) / 2, a cardioid. No matrix anywhere: a rotation of
# the whole field, every way, is one value turning another.
#
# The ears are two cardioids pointing a little behind the sides, not a
# head: the left and right come through, a sound overhead comes through
# when the head rolls, and front, back, up and down are otherwise alike,
# as two such microphones hear them (the note's "Hearing height" says
# what a head and pinnae would add). It is the algebra, to be measured
# and read, before anything sounds like being there. For headphones.
#
# The gamepad (tools/pad): hold A and press left and right to turn the
# head (CC 21), up and down to roll it (CC 20); hold B and press up and
# down to look up and down (CC 22).
#   tools/pad & AITHER_MIDI=aither-pad ./aither patches/spinfield.aither | tools/play hw:rockchipes8388c 20

# ---------------------------------------------------------------- directions

# A direction: theta from straight up, phi round from ahead.
def toward(theta, phi): [[0, sin(theta) * cos(phi)], [sin(theta) * sin(phi), cos(theta)]]

# Two directions' dot product: minus the first number of Hamilton's
# product of them (the rest is their cross product).
def dot(a, b):
  let [[w, _], [_, _]] = turn(a, b)
  -w

# ---------------------------------------------------------------- the head

# Yaw about the vertical (k), pitch about the ears' axis (j), roll about
# the line ahead (i); pitch turns inside the yaw, and roll inside that.
let yaw   = (midi_cc(21) - 0.5) * TAU
let pitch = (midi_cc(22) - 0.5) * PI
let roll  = (midi_cc(20) - 0.5) * PI
let head = turn(turn(about(k, yaw), about(j, pitch)), about(i, roll))

# ---------------------------------------------------------------- sounds

# Low ahead and a little left: a drone.
let drone = (sin(TAU * phasor(110)) + 0.4 * sin(TAU * phasor(220.6)) + 0.2 * sin(TAU * phasor(331.1))) * 0.25
let d_theta = 0.62 * PI
let d_phi = 0.7
# Circling overhead: a bird, chirping falling notes every 1.3 s.
let cu = (t mod 1.3) / 1.3
let chirp = if cu < 0.12 then sin(PI * cu / 0.12) else 0
let bird = sin(TAU * phasor(3200 - 1400 * cu / 0.12)) * chirp * 0.3
let b_theta = 0.2 * PI
let b_phi = t * TAU / 17
# Going round at the ears' height, the other way: a hiss of rain.
let rain = bpf(noise(), 2500, 0.3) * 0.25
let r_theta = 0.5 * PI
let r_phi = -t * TAU / 23

# ---------------------------------------------------------------- the field

let W = drone + bird + rain
let dipole = toward(d_theta, d_phi) * drone + toward(b_theta, b_phi) * bird + toward(r_theta, r_phi) * rain

# ---------------------------------------------------------------- hearing

# An ear's direction in the head, turned by the head into the world, and
# the field read there as a cardioid.
def heard(head, ear, W, dipole): (W + dot(apply(head, ear), dipole)) * 0.5

let ear_az = 100 * PI / 180                                # a little behind the sides
let left = heard(head, toward(PI / 2, ear_az), W, dipole)
let right = heard(head, toward(PI / 2, -ear_az), W, dipole)

[left, right] |> reverb(1.2, 0.08)
