# spectrum_medium — a sound's spectrum as a string, stretched along pitch.
#
# Like spectrum_freeze, this patch hears a spectrum: it goes between
# tools/fft and tools/ifft, 4096 samples a frame, so input() is a bin at
# a time, 2048 bins a frame, 11 Hz apart.
#
#   cd ~/aitherLang
#   ./aither patches/field_didge.aither | tools/fft 4096 \
#     | AITHER_SOCK=/tmp/medium.sock ./aither patches/spectrum_medium.aither \
#     | tools/ifft 4096 | tools/play
#
# The bins are the places of a string, one after another up the
# spectrum. The string rests in the sound's shape: how loud the sound is
# at each bin is where that place of the string sits when nothing moves.
# So a steady sound leaves it still, and the sound passes as it came. When
# the sound changes, the string is shaken as a string is when the hand
# holding it moves: it lags, swings past, and the swing travels along it,
# up and down in pitch, as waves that pass through each other and come
# back off the ends of the spectrum. A note's start, a mouth that moves,
# a strike, all leave the spectrum rippling after them.
#
# Where the string swings above the sound, what it holds beyond the sound
# is added. Where the bin has sound in it, that is the sound made louder,
# in its own phase, or the two would beat; where the bin is all but
# empty (between partials, where a ripple has come) it rings by itself, as
# an oscillator at the frequency the sound last had there (as
# spectrum_smear's tail does), a few bins together at the speed of the
# loudest, so a ripple through a harmonic stays one tone. A frame is 46
# ms, coarse for a swing, so each bin's extra swells and fades over a few
# frames rather than jumping a frame at a time, which would pop.
#
# The string's numbers are the patch's, below.

let frame = 2048
let bin = pixel_index(frame, 1)

let grip = 0.15         # the spring back to the sound's shape: how fast a swing comes back
let speed2 = 0.8        # the waves' speed squared, bins a frame (0.9 bins, 200 Hz a second)
let loss = 0.04         # how much of its swing the string loses a frame
let shake = 2           # how hard the sound's changes shake it
let hold = 0.75         # how much of the extra a bin keeps from the frame before
# grip + 4 * speed2 + 2 * loss past 4 and the string blows up

$w = array(frame, 0, every = frame)          # the string: how far from the sound's shape, at each bin
$was = array(frame, 0, every = frame)        # the string a frame ago
$past = array(frame, 0, every = frame)       # how loud the sound was, a frame ago
$older = array(frame, 0, every = frame)     # and the frame before that
$soft = array(frame, 0, every = frame)       # each bin's extra, as it swells and fades
$turn = array(frame, 0, every = frame)       # where each bin's oscillator points
$speed = array(frame, 0, every = frame)      # how far it turns in a frame
$heard = array(frame, (0, 0), every = frame) # the bin as it came, a frame ago

let [in_re, in_im] = input()
let here = (in_re, in_im)
let loud = amplitude(here)

# the string's law, at this place, as the distance from the sound: its own
# swing, kept but for the loss; its neighbours' pull; the spring back; and
# the sound's own acceleration, which the string, having mass, lags
let now = $w[bin]
let pull = $w[bin - 1] - 2 * now + $w[bin + 1]
let jolt = loud - 2 * $past[bin] + $older[bin]
let next = now + (1 - loss) * (now - $was[bin]) + speed2 * pull - grip * now - shake * jolt
let above = max(next, 0)                     # how far the string swings above the sound
let extra = $soft[bin] * hold + above * (1 - hold)

# how far the sound turned in this bin since the last frame (see spectrum_smear)
let strayed = phase(here * conj($heard[bin]) * (if bin mod 2 == 1 then -1 else 1))
let measured = PI * bin + strayed
let following = loud >= extra                # the sound is at least the extra: it leads
let lower = max(bin - 1, 0)
let upper = min(bin + 1, frame - 1)
let lead_low = if $soft[lower] > $soft[bin] then lower else bin
let lead = if $soft[upper] > $soft[lead_low] then upper else lead_low
let turned = ($turn[bin] + $speed[lead]) mod TAU

$w[bin] = next
$was[bin] = now
$older[bin] = $past[bin]
$past[bin] = loud
$soft[bin] = extra
$heard[bin] = here
$speed[bin] = if following then measured else $speed[bin]
$turn[bin] = if following then phase(here) else turned

# the extra, shared out by how much of the bin the sound is: that much in
# the sound's phase, the rest the oscillator's
let own = loud / (loud + extra + 0.000000001)
if bin == 0 then here else here * (1 + extra * own / (loud + 0.000000001)) + rotate((extra * (1 - own), 0), turned)
