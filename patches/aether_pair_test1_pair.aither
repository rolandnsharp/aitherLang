# aether_pair_test1_pair — Test 1 pair-mode patch.
#
# Same as aether_pair_test1_scalar.aither but magScale=1.0 (full pair
# mode) and rotationAngle = pi/2 so the receiver reads the pure
# magnetic tap. If the (dielectric, magnetic) decomposition preserves
# phase information that the scalar can't, this voice's phase relative
# to strike should be peaked across many strikes.

$aetherDie = 0.0
$aetherMag = 0.0
$prevStrike = 0.0

let driveAmp      = 10000000.0
let burstAmp      = 1000000.0
let aetherWrite   = 0.1
let aetherDecay   = 0.95
let coupling      = 1.0
let damping       = 0.001
let magScale      = 1.0     # PAIR mode
let rotationAngle = 1.5707963267948966   # pi/2 → pure magnetic read
let strikeRate    = 2.0

play test1:
  let trig    = impulse(strikeRate)
  let burst   = pluck(trig, 0.03)
  let strike  = trig * driveAmp + noise() * burst * burstAmp

  let dieDrive = strike
  let magDrive = strike - $prevStrike
  $prevStrike  = strike

  $aetherDie = $aetherDie * aetherDecay + dieDrive * aetherWrite
  $aetherMag = $aetherMag * aetherDecay + magDrive * aetherWrite * magScale

  let pair  = rotate($aetherDie, $aetherMag, rotationAngle)
  let aRead = pair[0] * coupling

  # Single receiver voice — rings at 277.18 Hz, never directly struck
  let v2 = dho(aRead, 277.18, damping)
  let s = v2 * 0.15
  [s, s]

test1
