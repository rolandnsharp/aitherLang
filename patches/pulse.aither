# pulse: four on the floor at 124 for vis to dance to. A kick that drops
# in pitch, a bass on the offbeats, sixteenth hats, and a chord that
# ducks under every kick (the pump), wide in stereo so its phase turns.
#
#   ./aither patches/pulse.aither | tools/play hw:rockchipes8388c 20 | tools/vis fields/bloom.aither

let pos = t - start_t
let tempo = 124 / 60
let beat = phasor(tempo)                     # 0..1 through each beat
let bar = int(pos * tempo / 4)

# Kick: a sine falling from about 230 Hz to 48, gone in a tenth of a second.
let kEnv = exp(-beat * 14)
let kick = sin(TAU * phasor(48 + 180 * exp(-beat * 30))) * kEnv * 0.75

# Bass: the offbeat, root of the bar's chord, a filtered saw.
let roots = [55, 43.65, 65.41, 49]           # A1 F1 C2 G1
let off = beat - 0.5
let bEnv = if off > 0 then exp(-off * 9) else 0
let bass = osc(saw, roots[bar % 4]) |> lpf(180 + bEnv * 900, 0.6) |> gain(0.35 * bEnv)

# Hats: sixteenths, the offbeat one open.
let six = phasor(tempo * 4)
let hEnv = exp(-six * (if int(beat * 4) == 2 then 12 else 40))
let hat = noise() * hEnv |> hpf(7000, 0.3) |> gain(0.12)

# Chord: Am F C G, three saws a voice spread left and right, pumped.
let third = [130.81, 110, 164.81, 123.47]
let fifth = [164.81, 130.81, 196, 146.83]
def voice(f): [osc(saw, f * 0.997), osc(saw, f * 1.003)]
let chord = (voice(roots[bar % 4] * 4) + voice(third[bar % 4] * 2) + voice(fifth[bar % 4] * 2)) |> lpf(1400, 0.3)
let pump = 1 - exp(-beat * 6)                # ducks on the kick, back by the offbeat

[kick + bass + hat, kick + bass + hat] + chord * 0.07 * pump
