# chaos — Lorenz attractor. strange attractor = classical-physics fractal.
# ẋ = σ(y - x)
# ẏ = x(ρ - z) - y
# ż = xy - βz
# L = x / 25, R = (z - 25) / 25  → on X-Y scope: the butterfly.

let pos    = sweep
let fadeIn = ease(pos / 6)

# time scaling: Lorenz natural time ≈ 1s. we want audio-rate chaos but still
# recognisable shape on the scope — compromise at ~50 orbits/sec.
let ddt    = dt * 55

let sigma  = 10.0
let rho    = 28.0 + sin(TAU * pos * 0.031) * 2.5         # ρ breathes → attractor morphs
let beta   = 8.0 / 3.0

$lx = 0.1
$ly = 0.0
$lz = 0.0

# The midpoint step: the rates here, half a step along them, the rates
# there, and the whole step along those. With time sped up 55 times, a
# step that takes only the rates here (Euler) is 0.1 to 0.4 off the true
# path 10 to 30 ms in (x spans ±20); this one is 1e-4 to 5e-4 off, and
# its error quarters each time the rate doubles (notes/rates-2026-10-30.md).
let dx = sigma * ($ly - $lx)
let dy = $lx * (rho - $lz) - $ly
let dz = $lx * $ly - beta * $lz
let mx = $lx + dx * ddt / 2
let my = $ly + dy * ddt / 2
let mz = $lz + dz * ddt / 2
$lx = $lx + sigma * (my - mx) * ddt
$ly = $ly + (mx * (rho - mz) - my) * ddt
$lz = $lz + (mx * my - beta * mz) * ddt

# map to audio. x in ±20 → L, z centred around 25 ± 15 → R.
let xNorm = $lx / 22.0
let zNorm = ($lz - 25.0) / 18.0

# tame with a low-pass so it sits warm in the mix (else chaos = harsh noise).
let L = xNorm |> lpf(2500, 0.3)
let R = zNorm |> lpf(2500, 0.3)

[L * fadeIn * 0.16, R * fadeIn * 0.16]
