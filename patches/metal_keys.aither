# metal_keys — a keyboard where every note's spectrum moves while it
# sounds. A strike throws the partials toward metal, as far as the
# velocity says, and the note settles back toward where the base knob
# sits; a bloom does the reverse, drifting a held note toward metal.
# Real struck things work this way: a harder blow excites more of the
# inharmonic modes, and those die first.
#
# The partials move along the spectral morph from spectra.aither
# (COMPOSING.md, "Spectral morph"): string n -> bar ((2n + 1) / 3)^2 ->
# phi 1.618^(n - 1), blended geometrically, one exp per partial.
#
# Notes from a MIDI keyboard; knobs from the gamepad (tools/pad):
#   A  up/down  base      where a note settles: 0 string .. 1 phi
#      l/r      strike    how far velocity throws the attack toward metal
#   B  up/down  settle    how long the metal takes to fade, 0.05 .. 3 s
#      l/r      bloom     a held note drifts toward metal instead
#   X  up/down  bright    partial roll-off (velocity brightens too)
#      l/r      release   0.1 .. 4 s
#   Y  up/down  space     reverb
#      l/r      stretch   piano stiffness on top of the morph
# All knobs at 0: soft string tones that bark metal on a hard strike.

let base    = midi_cc(20)
let strike  = 0.4 + 0.6 * midi_cc(21)
let settle  = 0.05 * pow(60, midi_cc(22))
let bloom   = midi_cc(23)
let rolloff = 1.3 - 0.9 * midi_cc(24)
let release = 0.1 * pow(40, midi_cc(25))
let space   = midi_cc(26)
let stiff   = 0.004 * midi_cc(27) * midi_cc(27)

def partial(n, m):
  let u = clamp(m * 2, 0, 1)
  let w = clamp(m * 2 - 1, 0, 1)
  exp(log(n) * (1 - u) + 2 * log((2 * n + 1) / 3) * (u - w)
      + (n - 1) * log(1.618) * w)

def note(freq, gate, vel):
  let hit = if gate > 0.5 and prev(gate) < 0.5 then 1 else 0
  let metal = pluck(hit, settle) * vel * strike      # thrown, then settling
  let grow  = swell(gate, 2.5, 0.3) * bloom          # drifting the other way
  let m = clamp(base + metal + grow, 0, 1)
  let r = rolloff - 0.5 * metal                      # a hard strike is brighter
  sum(8, n =>
    let pf = freq * partial(n, m) * sqrt(1 + n * n * stiff)
    if pf >= sr * 0.45 then 0
    else sin(TAU * phasor(pf)) * exp(-r * log(n)))
  * adsr(gate, 0.003, 0.5, 0.55, release) * (0.3 + 0.7 * vel) * 0.09

play keys:
  midi_keyboard((freq, gate, vel) => note(freq, gate, vel))

keys
|> tanh
|> reverb(1.5 + 3 * space, 0.12 + 0.45 * space)
