# al_muqabala — UNVERIFIED SKETCH of the cybernetic-synthesis pattern
# in aither. The earlier "DOCUMENTED NEGATIVE RESULT" header that
# previously sat here overclaimed what we actually know — RETRACTED.
#
# WHAT WE HONESTLY KNOW
# This patch was sketched in one session as a translation of the
# New-Uses-for-Old-Circuits episode 8 al-Muqabala patch (driver LFO +
# carrier-into-loop excitation + dual nonlinearity + envelope-follower
# regulator). At default knob positions (all CCs = 0, hard-coded
# defaults of K1=0.5 K2=0.3 K3=0.4 K7=0.3) the user heard a "fire
# alarm, very consistent" sound — a fixed-pitch sweeping tone, not
# the dynamic chaotic motion the original episode produces.
#
# WHAT WE DO NOT KNOW
# How this patch behaves under live performance. The al-Muqabala
# tradition is fundamentally about *exploring parameter space by hand*
# — the patcher tunes by ear over many minutes and the patch passes
# through dozens of distinct attractors as the knobs move. We
# evaluated this patch with NO MIDI controller plugged in, at fixed
# default values, with a few audit-only iterations of guessed
# parameter values. That's not enough evidence to conclude the
# substrate can or cannot host cybernetic-synthesis patches. The
# evaluation was undersampled, not the substrate.
#
# THE EARLIER NEGATIVE-RESULT FRAMING WAS PREMATURE
# Specifically retracted claims:
#  - "fold and drive are clean digital nonlinearities that lack the
#    emergent character" — based on inadequate parameter exploration
#  - "lpf with high resonance in a feedback loop runs away within
#    milliseconds" — true at the few Q values we tried, but the
#    safe-Q region was not systematically explored
#  - "fold |> drive |> lp1 in series cannot produce cybernetic chaos"
#    — based on a fixed-knob audit, not on hand-tuned exploration
# The substrate has produced every other thing we asked of it on the
# first try; one undertested patch is not adequate evidence to invert
# that track record.
#
# WHAT THIS PATCH IS HONESTLY USEFUL FOR
# The structure is a reasonable starting sketch. When the user has
# MIDI plugged in, a live exploration of the four knobs (K1 drive
# gain, K2 regulator pull, K3 tone, K7 reverb) might reveal regions
# of interesting motion, narrow regions of NaN runaway, or genuine
# dead zones. Until that exploration happens, the patch is a sketch
# awaiting evaluation, NOT a documented negative result.
#
# ============================================================ KNOBS
#   K1 (CC 74) — DRIVE GAIN       how hard the LFO sweeps the carrier
#                                  freq + folder amount (chaos parameter)
#   K2 (CC 71) — REGULATOR PULL   how hard the observer pulls back when
#                                  the loop gets loud (0 = none, 1 = strong)
#   K3 (CC 76) — TONE             output filter cutoff (cleanup)
#   K7 (CC 19) — REVERB           wet level
#
# Try this:
#   1. K1 ~0.4, K2 = 0, K3 ~0.6 — naked feedback chaos
#   2. K2 to ~0.5 — the system starts to BREATHE
#   3. K1 sweep at fixed K2 walks through different attractors

# Knobs default to musically useful values so the patch sounds immediately
# without a MIDI controller. Move the CCs to override the defaults.
let driveGain   = max(midi_cc(74), 0.5)
let regulator   = max(midi_cc(71), 0.3)
let toneCut     = max(midi_cc(76), 0.4)
let revAmt      = max(midi_cc(19), 0.3)

play almuqabala:
  $loop = 0.0
  $obs  = 0.0

  # TWO LFOs at incommensurate rates so the system never repeats exactly.
  let lfo1 = (sin(TAU * phasor(0.073)) + 1) * 0.5   # ~13.7s, 0..1
  let lfo2 = (sin(TAU * phasor(0.117)) + 1) * 0.5   # ~8.5s, 0..1, prime ratio

  # Observer — envelope follower on the loop amplitude (the integrator-as-
  # cybernetic-regulator pattern from cybernetics.md).
  $obs = lp1(abs($loop), 3.0)
  let pull = max(0.05, 1 - $obs * 4 * regulator)

  # Audio-rate excitation. Frequency drifts slowly with lfo1; AMPLITUDE
  # is scaled by lfo2 so the system breathes in and out of activity
  # (silent at lfo2 troughs, fully driven at peaks). driveGain controls
  # how loud the peaks get.
  let exciteFreq = 100 + lfo1 * 80
  let exciteAmp  = lfo2 * driveGain * 0.7
  let excite = sin(TAU * phasor(exciteFreq)) * exciteAmp

  # Heart — excitation injected into a feedback loop. The loop's own
  # state ring-modulates the excitation, then a wave folder generates
  # rich harmonics, then drive saturates. The folder's BIAS is set by
  # the loop itself — feedback into bias is what creates chaos rather
  # than just FM. The pull regulator scales the loop-into-bias coupling.
  let modulated = excite * (1 + $loop * 0.4 * pull)
  let folded = fold(modulated + $loop * 0.3 * pull, 1.4)
  let driven = drive(folded, 2.0)
  $loop = driven * 0.93

  # Output cleanup — first-order low-pass (unconditionally stable).
  let cut = 300 + toneCut * 5000
  let cleaned = $loop |> lp1(cut)
  let s = cleaned * 0.25
  [s, s]

# ===== MASTER =====
let dry  = almuqabala
let mono = (dry[0] + dry[1]) * 0.5
let wet  = mono |> reverb(3.5, 0.5)
([dry[0], dry[1]] + [wet, wet] * revAmt * 0.5) * 0.7
