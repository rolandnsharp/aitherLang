# aether_ring: a ring whose masses move every way, carrying compression
# and twist at their own speeds, from one product
# (notes/nabla-and-medium-2026-11-06.md; scanned_ring is its plainer sister).
#
# Each mass's displacement is a direction, one of Hamilton's numbers: i
# along the ring, j out from its centre, k up from its plane. Hamilton's
# nabla along the ring is his unit i times a difference, and it is his
# product, so what it gives has two parts:
#
#   the scalar part   how the ring is squeezed there: convergence
#   the vector part   how it is twisted there: curl
#
# The law takes each part back through nabla with its own stiffness, in one
# line. So one strike, leaning along and across the ring at once, splits in
# two: a fast squeeze and a slow twist, leaving together and drawing apart.
#
# Heard and drawn from one value: the ring is read round at the note, a
# squeeze moves a mass along the ring, so the reading runs ahead and behind
# (heard as frequency, drawn as the beam bunching and thinning), and a twist
# moves it out from the circle (heard as size, drawn as a bump). Up from the
# plane shows through a slight tilt.
#
# Measured: a quarter of the way round from a strike the squeeze arrives
# at about 0.16 s and the twist at about 0.37 s, as a 0.63 s ring and sqrt
# of twist's 0.17 say. A strike along the ring makes no twist and one across
# it no squeeze, to the last digit: the two parts stay apart.
#
#   ./aither patches/aether_ring.aither | tools/scope --decay 0.9 | tools/play hw:rockchipes8388c 20
#
# The gamepad (tools/pad): A strikes along the ring, B out across it, X up
# from its plane; hold A and press left and right for the note (CC 21), up
# and down for how stiff it is to squeeze (CC 20); hold B and press up and
# down for how stiff it is to twist (CC 22).
#   tools/pad & AITHER_MIDI=aither-pad ./aither patches/aether_ring.aither | tools/scope --decay 0.9 | tools/play hw:rockchipes8388c 20

# ---------------------------------------------------------------- the field

let squeeze = 1 + 1.4 * midi_cc(20)                        # how stiff to squeeze, against the ring as it is
let twist = 0.17 + 0.57 * midi_cc(22)                      # how stiff to twist, against squeezing it
let held = 71                                              # how strongly a mass keeps its place
let loss = 0.41                                            # shrink, a second

$d = ring(period = 0.63, start = ((0, 0), (0, 0)))         # where each mass is: a squeeze goes round in 0.63 s
$v = ring(period = 0.63, start = ((0, 0), (0, 0)))         # how it is moving

$v = ($v - slope(convergence($d)) * squeeze * dt - curl(curl($d)) * twist * dt - $d * held * dt) * (1 - loss * dt)
$d = $d + $v * dt

# ---------------------------------------------------------------- the strike

# A strike is a function of its age (COMPOSING, "How long since"). The ring
# strikes itself every 7 s, leaning along and across at once, so both waves
# start; a pad strikes one way. It is a write head sweeping across the ring
# where it lands, each a golden angle round from the last.
let golden = 0.381966
let own = phasor(1 / 7) * 7
let pad_a = midi_trig(36)
let pad_b = midi_trig(37)
let pad_x = midi_trig(38)
let age_a = since(pad_a)
let age_b = since(pad_b)
let age_x = since(pad_x)
$where = 0.0
$where = ($where + (pad_a + pad_b + pad_x) * golden) mod 1

let stroke = 0.003                                         # how long a blow takes
let age = min(own, min(age_a, min(age_b, age_x)))
let way = (if own < stroke then (i + j) * sqrt(0.5) else 0) + (if age_a < stroke then i else 0) + (if age_b < stroke then j else 0) + (if age_x < stroke then k else 0)
let landed = if own < stroke then floor(sweep / 7) * golden else $where
let head = age / stroke * 2 - 1                            # across the stretch, -1 to 1
$v[landed + head * 0.094] = way * (if age < stroke then 1.62 / stroke * exp(-head * head * 9) else 0)

# ---------------------------------------------------------------- reading

# Round the ring at the note.
let note = 110 * pow(2, floor(midi_cc(21) * 25) / 12)
let round = phasor(note)
let ((_, along), (out, height)) = $d[round]

# Each point of the ring where it has gone, seen a little from the side.
let (x, y) = rotate((0.45 + out, 0), TAU * round + along * 3)
let ((_, sx), (sy, _)) = apply(about(i, 0.4), ((0, x), (y, height)))
(sx, sy)
