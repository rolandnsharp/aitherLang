# qigong_light — a calm qigong session sized for a Pinebook Pro.
#
# Cheap enough to run well under one ARM core, and nothing below
# ~200 Hz so the small laptop speakers don't crackle. D minor.
#
#   breath  — everything swells on a 10 s cycle (6 breaths a minute)
#   pad     — D4 / A4 / F5, each a slightly detuned pair of sines
#   bowl    — a soft singing bowl every 19 s, five inharmonic partials
#   flute   — a slow pentatonic line around D5, with breath noise
#
# One pipe per let: chained pipes currently miscompile.

let pos    = t - start_t
let fadeIn = ease(pos / 10)
let breath = (sin(TAU * pos / 10 - PI / 2) + 1) * 0.5    # 0..1, 10 s

# ---- pad ---------------------------------------------------------------
play pad:
  let d = sin(TAU * phasor(293.66)) + sin(TAU * phasor(294.4))
  let a = sin(TAU * phasor(440.0)) + sin(TAU * phasor(440.9))
  let f = sin(TAU * phasor(698.46)) + sin(TAU * phasor(699.6))
  let s = (d * 0.5 + a * 0.3 + f * 0.12) * (0.25 + breath * 0.75) * 0.05
  pan(s, sin(TAU * pos / 47) * 0.4)

# ---- singing bowl --------------------------------------------------------
play bowl:
  let hit = impulse(1 / 19)
  let env = discharge(hit, 0.35)
  let b = sin(TAU * phasor(587.33)) + sin(TAU * phasor(587.33 * 2.71)) * 0.5 + sin(TAU * phasor(587.33 * 5.15)) * 0.2 + sin(TAU * phasor(589.0)) * 0.6 + sin(TAU * phasor(587.33 * 8.2)) * 0.08
  pan(b * env * 0.04, -0.3)

# ---- flute -----------------------------------------------------------------
play flute:
  # D minor pentatonic around D5: D F G A C D
  let wander = (sin(TAU * pos * 0.031) + sin(TAU * pos * 0.019) + 2) * 0.5 * 6
  let idx    = int(wander) mod 6
  let step   = if idx == 0 then 0 else if idx == 1 then 3 else if idx == 2 then 5 else if idx == 3 then 7 else if idx == 4 then 10 else 12
  let target = 587.33 * pow(2, step / 12)
  let freq   = slew(target, 0.25)
  let vf     = freq * (1 + sin(TAU * phasor(4.8)) * 0.006)
  let air    = noise() |> bpf(vf, 0.5)
  let tone   = sin(TAU * phasor(vf)) + sin(TAU * phasor(vf * 2)) * 0.08 + air * 0.05
  let phrase = (sin(TAU * pos / 23 - PI / 2) + 1) * 0.5
  pan(tone * (0.2 + phrase * 0.8) * (0.4 + breath * 0.6) * 0.035, 0.25)

# ---- mix ---------------------------------------------------------------------
let dry = pad + bowl + flute
let dl  = dry[0]
let dr  = dry[1]
let wl  = dl |> reverb(3.0, 0.5)
let wr  = dr |> reverb(3.0, 0.5)
[(dl * 0.6 + wl * 0.6) * fadeIn, (dr * 0.6 + wr * 0.6) * fadeIn]
