# aether_pair_test2_scalar — Test 2 control (scalar baseline).
#
# magScale = 0 so the medium degenerates to scalar; the rotation
# sweep below has nothing to rotate (mag = 0). Centroid should be
# approximately constant across the 30-second audit, confirming
# rotation has no effect on the scalar version.

$aetherDie = 0.0
$aetherMag = 0.0
$prevStrike = 0.0

let driveAmp      = 10000000.0
let burstAmp      = 1000000.0
let aetherWrite   = 0.1
let aetherDecay   = 0.95
let coupling      = 1.0
let damping       = 0.001
let magScale      = 0.0       # scalar control
let strikeRate    = 2.0

play test2:
  let trig    = impulse(strikeRate)
  let burst   = pluck(trig, 0.03)
  let strike  = trig * driveAmp + noise() * burst * burstAmp

  let dieDrive = strike
  let magDrive = strike - $prevStrike
  $prevStrike  = strike

  $aetherDie = $aetherDie * aetherDecay + dieDrive * aetherWrite
  $aetherMag = $aetherMag * aetherDecay + magDrive * aetherWrite * magScale

  let rotationAngle = phasor(1.0 / 30.0) * TAU
  let pair  = rotate($aetherDie, $aetherMag, rotationAngle)
  let aRead = pair[0] * coupling

  let v2 = dho(aRead, 277.18, damping)
  let s = v2 * 0.15
  [s, s]

test2
