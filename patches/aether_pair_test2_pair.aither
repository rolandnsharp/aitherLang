# aether_pair_test2_pair — Test 2 pair-mode patch with rotation sweep.
#
# Same source/receiver topology as test1, but rotationAngle sweeps
# slowly (one full 2*pi rotation per 30 seconds). Per the test's
# claim, the receiver's spectral character should shift continuously
# as theta sweeps; with scalar (mag=0) the rotation has no effect and
# centroid should be roughly constant.

$aetherDie = 0.0
$aetherMag = 0.0
$prevStrike = 0.0

let driveAmp      = 10000000.0
let burstAmp      = 1000000.0
let aetherWrite   = 0.1
let aetherDecay   = 0.95
let coupling      = 1.0
let damping       = 0.001
let magScale      = 1.0
let strikeRate    = 2.0

play test2:
  let trig    = impulse(strikeRate)
  let burst   = pluck(trig, 0.03)
  let strike  = trig * driveAmp + noise() * burst * burstAmp

  let dieDrive = strike
  let magDrive = strike - $prevStrike
  $prevStrike  = strike

  $aetherDie = $aetherDie * aetherDecay + dieDrive * aetherWrite
  $aetherMag = $aetherMag * aetherDecay + magDrive * aetherWrite * magScale

  # Slow rotation sweep — one full turn in 30 seconds
  let rotationAngle = phasor(1.0 / 30.0) * TAU
  let pair  = rotate($aetherDie, $aetherMag, rotationAngle)
  let aRead = pair[0] * coupling

  let v2 = dho(aRead, 277.18, damping)
  let s = v2 * 0.15
  [s, s]

test2
