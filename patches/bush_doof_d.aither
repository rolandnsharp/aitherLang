# bush_doof_d — a bush doof in D minor around a physical didgeridoo in D,
# a handpan in D Kurd, clapsticks and a whipbird in the trees. Built on
# the same instruments as bush_doof_didge (see there for the physics).
#
# Everything is physics or signal, nothing is a sample:
#   lips    a mass-spring valve (dho) pushed open by the pressure drop
#           between the mouth and the bore; Bernoulli flow through the
#           opening; the lips slap shut every cycle.
#   bore    a waveguide: the outgoing wave travels one period down a
#           conical tube and comes back lowpassed by wall and radiation
#           loss. A cone closed at the lips resonates at every harmonic,
#           so the drone sits at 110 Hz with the full series above it.
#   voice   the sung notes (A minor) modulate the MOUTH PRESSURE, so the
#           lip valve makes the growl and beating with the drone itself.
#   tract   three formants after the bell: the jaw sweeps oo → ah, the
#           tongue flicks toward ee on each "dik" of the rhythm.
#   breath  circular breathing every 5.3 s, with the intake noise.
#   sticks  two hardwood bars struck together, heavily damped (a hand),
#           the contact click carrying most of the sound.
#   handpan a struck steel shell: eight tone fields (ding A3, then C D E
#           G A C E), each three tuned modes (1 : 2 : 3) on damped
#           oscillators with a soft hand strike; every field rings on its
#           own. The melody wanders the scale from slow LFOs.
#   doof    kick, bass, hats and clap in the bush_doof idiom, high-passed
#           for the laptop speakers (the bass is its harmonics).
#
# The session evolves on three incommensurate cycles — 173 s (doof
# presence), 97 s (handpan density, register), 61 s (stick pattern,
# hats, wah) — plus a two-bar break every 32 bars with a riser in its
# last bar and two sung phrases alternating every 32 s. The combination
# never lines up the same way twice. All of it runs off the wall clock
# `t`, so a hot-reload never knocks the parts out of step.
#
# Pinebook speakers: everything high-passed at 180–200 Hz, lowpassed at
# 7 kHz, soft attacks, moderate level.

def didge_bore(mouth, lipF, lipD, f0):
  $pm = 0.0                             # wave arriving back at the lips
  $dp = 0.0                             # pressure drop across the lips
  let lip = dho($dp * 1200000.0, lipF, lipD)[0]
  let a   = clamp(0.05 + lip, 0.0, 1.0) # lip opening; 0 = lips shut
  let u   = a * (if $dp >= 0 then sqrt($dp) else -sqrt(-$dp))   # Bernoulli flow
  let pplus = u * 0.8 + $pm             # outgoing wave: injected flow + reflection
  let p     = pplus + $pm               # pressure at the lips
  $dp = lp1(mouth - p, 840.34)
  let back = delay(pplus, 1.0 / f0, 0.05)
  $pm = lp1(back, 358.42) * 0.93          # reflected, in phase, lossy
  back - lp1(back, 28.702)                 # what leaves the bell

def formant(x, f, res):
  bpf(x, f, res) * (2 * (1 - res))      # unity gain at the peak

# Clapsticks: a hardwood bar held in the hand, so heavily damped. The
# pitched "tok" lasts ~15 ms, the higher modes a few ms, and the contact
# click carries most of the sound. (Let the modes ring and it's a bell.)
def stick(strike, freq, decay, bright):
  sum(3, n =>
    let ratio = bar_partials(n)
    let omega = TAU * freq * ratio
    let omega2 = omega * omega
    let gamma = (1 + (n - 1) * 1.5) / decay
    let amp = if n == 1 then 1.0 else bright / (n * n)
    $x = 0.0
    $dx = 0.0
    $dx = $dx + (-2 * gamma * $dx - omega2 * $x + strike * omega2) * dt
    $x = $x + $dx * dt
    $x * amp)

# One tone field of a handpan: fundamental, octave and twelfth, lightly
# damped (seconds), with the slow doublet shimmer of a real shell.
def pan_field(strike, fund):
  sum(3, n =>
    let ratio = if n == 1 then 1.0 else if n == 2 then 1.998 else 3.0
    let drift = 1 + 0.0008 * sin(TAU * t * (0.11 * n) + n)
    let omega = TAU * fund * ratio * drift
    let omega2 = omega * omega
    let gamma = (0.35 + (n - 1) * 0.45) * sqrt(fund / 220)
    let amp = if n == 1 then 1.0 else if n == 2 then 0.9 else 0.6
    $x = 0.0
    $dx = 0.0
    $dx = $dx + (-2 * gamma * $dx - omega2 * $x + strike * omega2) * dt
    $x = $x + $dx * dt
    $x * amp)

let tempo = 140 / 60.0

# ---------------------------------------------------------------- clocks
# One bar of sixteenths and two bars of eighths, all from the wall clock.
let barPh  = (t * tempo / 4) mod 1
let beatPh = (barPh * 4) mod 1
let stepPh = (barPh * 16) mod 1
let stepIx = int(barPh * 16)
let trigB  = if beatPh < prev(beatPh) then 1 else 0
let trig16 = if stepPh < prev(stepPh) then 1 else 0
let bar2Ph = (t * tempo / 8) mod 1
let ePh    = (bar2Ph * 16) mod 1
let eIx    = int(bar2Ph * 16)
let trig8  = if ePh < prev(ePh) then 1 else 0
let step32 = int(bar2Ph * 32)
let bars   = floor(t * tempo / 4)
let beatIx = int(barPh * 4)

# ------------------------------------------------ movement 2: build → drop
# `$m2start` takes the time this version was first loaded, so the build
# starts on the next bar after the hot-swap: 8 bars of build (the kick
# drops out, the mouth opens, sticks and clap roll in the last two bars
# under a sung whoop), half a bar of breath, then the drop: 32 bars of
# full doof with toots on the one and a second didge in E, then 8 bars
# to relax back into the cycles. Pure arithmetic on t: no new state.
$m2start = t
let m2bar   = t * tempo / 4 - (floor($m2start * tempo / 4) + 1)   # bars since the build began
let tension = clamp(m2bar / 8, 0, 1) * (if m2bar < 8 then 1 else 0)
let gap     = if m2bar >= 7.5 and m2bar < 8 then 1 else 0          # the breath before the drop
let dropEnv = (if m2bar >= 8 then 1 else 0) * (1 - ease((m2bar - 40) / 8))
let dropHit = if m2bar >= 8 and m2bar < 8.02 then 1 else 0
let roll    = if tension > 0.75 and gap < 0.5 then 1 else 0         # last two bars of the build
let toot    = dropEnv * (if beatIx == 0 and beatPh < 0.45 then 1 else 0)

# ------------------------------------------------------------- evolution
let arcA = (sin(TAU * t / 173) + 1) * 0.5           # doof presence
let arcB = (sin(TAU * t / 97 + 1.0) + 1) * 0.5      # handpan density, register
let arcC = (sin(TAU * t / 61 + 2.0) + 1) * 0.5      # stick pattern, hats, wah
let doof = max(ease((arcA - 0.35) / 0.3) * (1 - ease((tension - 0.4) * 5)), dropEnv)   # 0 → 1 as the doof arrives
let brkRaw = max((if (bars mod 32) >= 30 then 1 else 0) * (1 - dropEnv) * (if tension > 0 then 0 else 1), gap)   # two-bar break every 32 bars
let brk    = slew(brkRaw, 0.12)
let riser  = max((if (bars mod 32) == 31 then ease(barPh) else 0) * (1 - dropEnv), tension * tension)   # last bar of a break; the build

# Circular breathing: a short intake near the end of each 5.3 s cycle.
let cycle = phasor(1 / 5.3)
let gulp  = ease((cycle - 0.93) * 20) * (1 - ease((cycle - 0.985) * 60))

# Jaw: slow oo → ah with a wah riding on it; the wah doubles in the doof,
# and the riser opens the mouth all the way.
let jawSlow = (sin(TAU * phasor(0.31)) + 1) * 0.5
let jawFast = (sin(TAU * phasor(1.75)) + 1) * 0.5
let jawDoof = (sin(TAU * phasor(3.5)) + 1) * 0.5
let jaw     = clamp(jawSlow * 0.55 + (jawFast * (1 - doof) + jawDoof * doof) * 0.45 * jawSlow + riser * 0.6, 0, 1)

# Tongue: two dik-a-dik-a patterns, crossfaded by the 61 s cycle; the
# break calms it to the accents only.
let tongueA = [1, 0.25, 0.5, 0.3, 0.8, 0.25, 0.55, 0.3, 1, 0.3, 0.5, 0.25, 0.7, 0.35, 0.6, 0.45]
let tongueB = [1, 0.4, 0.3, 0.7, 0.5, 0.3, 0.9, 0.3, 0.8, 0.35, 0.3, 0.7, 0.5, 0.3, 0.9, 0.5]
let tongueV = (tongueA[stepIx] * (1 - arcC) + tongueB[stepIx] * arcC) * (1 - brk * 0.6) * (1 + tension * 0.6 + dropEnv * 0.3)
let tongue  = slew(discharge(trig16 * tongueV, 14), 0.006)

# Sung notes over the drone, two 16-second phrases in A minor. 0 = rest.
let phraseA = [220.0, 220.0, 220.0, 0, 293.66, 293.66, 261.63, 220.0, 174.61, 174.61, 220.0, 0, 196.0, 233.08, 220.0, 0]
let phraseB = [293.66, 0, 349.23, 329.63, 293.66, 293.66, 261.63, 233.08, 220.0, 196.0, 174.61, 0, 196.0, 220.0, 146.83, 0]
let phraseIx = int(((t / 16) mod 1) * 16)
let whoop   = if tension > 0.75 then 293.66 * pow(2, (tension - 0.75) * 4) else 0   # A3 → A4 into the drop
let sungRaw = if whoop > 0 then whoop else (if ((t / 32) mod 2) < 1 then phraseA[phraseIx] else phraseB[phraseIx])
$sung = 220.0
$sung = if sungRaw > 0 then sungRaw else $sung
let sungF  = slew($sung, 0.12) * (1 + sin(TAU * phasor(5.3)) * 0.006)
let singOn = swell(if sungRaw > 0 then 1 else 0, 0.25, 0.35)
let voice  = pow(max(0, sin(TAU * phasor(sungF))), 3) * singOn

play didge:
  let pressure = max(0.05, 0.92 + tension * 0.1 + toot * 0.2 - gulp * 0.45 - gap * 0.6 + tongue * 0.12) * (1 + voice * 0.2)
  let bore   = didge_bore(pressure, 63.4 + toot * 70, 0.1, 73.42)    # a toot: the lips lock onto the 2nd mode
  let intake = (noise() |> bpf(1800, 0.8)) * max(gulp, gap) * 0.03
  let src    = bore + intake
  let f1 = slew(320 + jaw * 420 - tongue * 60, 0.02)
  let f2 = slew(850 + jaw * 350 + tongue * 1100, 0.012)
  let f3 = slew(2300 + jaw * 300 + tongue * 500, 0.02)
  let tract = formant(src, f1, 0.93) + formant(src, f2, 0.94) * 0.7 + formant(src, f3, 0.95) * 0.35
  (tract * 0.9 + src * 0.35) |> drive(1.4)

# Clapsticks: pattern A keeps the beats with a pickup; pattern B works
# the offbeats. Harder hits are brighter. They stay through the break.
let stickA = [1, 0, 0.6, 0.4, 0.9, 0, 0.75, 0, 1, 0.4, 0.6, 0, 0.9, 0.5, 0.7, 0.4]
let stickB = [1, 0.4, 0.6, 0.4, 0.9, 0.35, 0.6, 0.5, 1, 0.4, 0.6, 0.4, 0.9, 0.5, 0.6, 0.6]
play sticks:
  let trigS  = if roll > 0.5 then trig16 else trig8
  let vel    = if roll > 0.5 then 0.35 + (tension - 0.75) * 2.6 else stickA[eIx] * (1 - arcC) + stickB[eIx] * arcC
  let hit    = slew(discharge(trigS * vel, 2500), 0.0004)      # ~0.4 ms contact
  let bright = 0.4 + vel * 0.6
  let struck = stick(hit * 2.0, 1650, 0.016, bright)
  let holder = stick(hit * 1.3, 1240, 0.012, bright * 0.7)
  let click  = (noise() |> bpf(2600, 0.55)) * discharge(trigS * vel, 450) * 1.0
  let thump  = (noise() |> lpf(900, 0.3)) * discharge(trigS * vel, 700) * 0.5
  (struck + holder + click + thump) * 0.125 * (1 - gap)

# Handpan: a sparse and a busy two-bar pattern crossfaded by the 97 s
# cycle; the note wanders the scale (higher fields open up as the cycle
# rises), the ding opens every second bar. Ducked by the kick, rests in
# the break.
let panFields = [146.83, 220.0, 233.08, 261.63, 293.66, 329.63, 349.23, 440.0]
let panSparse = [1, 0, 0, 0.6, 0, 0, 0.8, 0, 0, 0.5, 0, 0, 0.7, 0, 0.4, 0, 0.9, 0, 0, 0.5, 0, 0.6, 0, 0, 0.8, 0, 0, 0.5, 0, 0, 0.6, 0.4]
let panBusy   = [1, 0, 0.5, 0.6, 0, 0.4, 0.8, 0, 0.5, 0.5, 0, 0.4, 0.7, 0, 0.4, 0.5, 0.9, 0, 0.5, 0.5, 0, 0.6, 0.4, 0, 0.8, 0, 0.4, 0.5, 0, 0.5, 0.6, 0.4]
let walk    = 4 + 3.4 * sin(TAU * t / 23) * cos(TAU * t / 7.3) + 1.5 * sin(TAU * t / 3.1)
let panHi   = if arcB > 0.5 or tension > 0.3 or dropEnv > 0.5 then 7 else 5
let panB    = max(arcB, tension)
let fieldIx = if step32 == 0 then 0 else clamp(int(walk), 1, panHi)
let kEnv = discharge(trigB * doof * (1 - brk), 10)
let sc   = 1 - kEnv * 0.5
play handpan:
  let vel = (panSparse[step32] * (1 - panB) + panBusy[step32] * panB) * (1 - brk * 0.8)
  let hit = slew(discharge(trig16 * vel, 350), 0.002)        # a hand, ~5 ms
  let slap = (noise() |> lpf(500, 0.3)) * discharge(trig16 * vel, 400) * 0.12
  let shell = sum(8, k =>
    let strike = if fieldIx == k - 1 then hit else 0
    pan_field(strike * 1.0, panFields[k - 1]))
  ((shell + slap) * 0.3 |> drive(1.6)) * 0.6 * sc     # soft-clip the strike peaks

# Doof: kick on the beats, bass on the offbeat eighths (A A A G A C A E),
# hats on the sixteenths, clap on 2 and 4. All gated by the 173 s cycle
# and silenced by the break.
let doofOn = doof * (1 - brk)
play kick:
  let p = 200 + discharge(trigB, 30) * 300                    # 500 → 200 Hz
  $kph = 0.0
  $kph = if trigB > 0.5 then 0.0 else ($kph + p * dt) mod 1.0  # phase reset: no click
  let body  = sin(TAU * $kph) * kEnv
  let click = (noise() |> lpf(3000, 0.3)) * discharge(trigB * doofOn, 600) * 0.4
  (body + click) * doofOn * 0.5

let bassNotes  = [146.83, 146.83, 146.83, 130.81, 146.83, 174.61, 146.83, 220.0]
let bassNotes2 = [146.83, 146.83, 220.0, 146.83, 196.0, 146.83, 261.63, 220.0]   # the drop
play bass:
  $bNote = 146.83
  $bNote = if trig8 > 0.5 then (if dropEnv > 0.5 then bassNotes2[int(barPh * 8)] else bassNotes[int(barPh * 8)]) else $bNote
  let accent = if (eIx mod 2) == 1 then 1 else 0.3 + dropEnv * 0.4
  let bEnv = discharge(trig8 * accent, 14)
  # A plucked string (Karplus-Strong): a noise burst into a tuned,
  # lossy delay loop. Harder hits are brighter.
  let excite = (noise() |> lpf(1500 + accent * 2500, 0.3)) * slew(discharge(trig8 * accent, 300), 0.0005)
  let raw  = pluck_string(excite, $bNote, 0.45 + arcC * 0.3)
  raw * (0.4 + bEnv * 0.6) * sc * doofOn * 0.5

let hatPat = [0.3, 0.7, 0.3, 0.9, 0.3, 0.7, 0.3, 0.9, 0.3, 0.7, 0.3, 0.9, 0.3, 0.7, 0.5, 0.9]
play hats:
  let hv = hatPat[stepIx] * max(arcC, dropEnv * 0.8)
  (noise() |> bpf(5500, 0.5)) * pluck(trig16 * hv, 0.04) * doofOn * 0.1

play clap:
  let on = if roll > 0.5 then 0.3 + (tension - 0.75) * 2.8 else (if stepIx == 4 or stepIx == 12 then 1 else 0)
  (noise() |> bpf(1500, 0.3)) * pluck(trig16 * on, 0.12) * max(doofOn, roll) * 0.3

# ------------------------------------------------- movement 2: new players
# A second didge in E enters on the drop: its own lips, bore and mouth,
# breathing on its own 6.1 s cycle, toots answering on beat three. Below
# the drop its mouth pressure is too low to set the lips going.
play didge2:
  let cycle2 = (t / 6.1) mod 1
  let gulp2  = ease((cycle2 - 0.93) * 20) * (1 - ease((cycle2 - 0.985) * 60))
  let toot2  = dropEnv * (if beatIx == 2 and beatPh < 0.45 then 1 else 0)
  let p2     = max(0.05, (0.95 + toot2 * 0.2 - gulp2 * 0.45 + tongue * 0.08) * dropEnv)
  let bore2  = didge_bore(p2, 95 + toot2 * 105, 0.1, 110)
  let g1     = slew(380 + jawSlow * 300, 0.02)
  let tract2 = formant(bore2, g1, 0.93) + formant(bore2, 1100 + jawFast * 400, 0.94) * 0.6
  (tract2 * 0.9 + bore2 * 0.35) |> drive(1.4)

# Eastern whipbird in the trees: a long whistle, the whip-crack, the
# mate's "choo-choo". About every 13 s, never on the same beat.
play whipbird:
  let wb = (t / 13.3) mod 1
  let u  = wb / 0.12
  let whistle = if u < 0.72 then 1 else 0
  let crack   = if u >= 0.72 and u < 0.8 then 1 else 0
  let answer  = if (u >= 0.86 and u < 0.9) or (u >= 0.94 and u < 0.98) then 1 else 0
  let cu = (u - 0.72) / 0.08
  let f  = if whistle > 0 then 2300 + u * 260 else if crack > 0 then 1800 + 4600 * sin(PI * cu) else 3300
  let amp = whistle * ease(u * 10) * 0.6 + crack * 0.9 * (1 - cu) + answer * 0.5
  sin(TAU * phasor(f)) * slew(amp, 0.004) * 0.05

# The drop's crash: a 2 ms attack, then a long hiss.
play crash:
  (noise() |> bpf(5000, 0.2)) * slew(discharge(dropHit, 1.2), 0.002) * 0.25

# ------------------------------------------------------------------ mix
let out   = (didge + didge2 * 0.6) |> hpf(200, 0.29) |> hpf(200, 0.29) |> lpf(7000, 0.2)
let roomD = reverb(mono(out), 1.3, 0.1)
let roomS = reverb(mono(sticks) |> lpf(6500, 0.2), 0.6, 0.06)   # dry: a hand, not a hall
let roomP = reverb(mono(handpan), 2.2, 0.25)
let drums = (mono(kick) + mono(bass) + mono(hats) + mono(clap) + mono(crash)) |> hpf(180, 0.29) |> lpf(7000, 0.2)
(haas(roomD * 3.4, 8) + pan(roomS * 1.0, 0.3) + pan(roomP * 3.0, -0.3) + haas(drums * 0.45, -5) + pan(reverb(mono(whipbird), 2.5, 0.3) * 1.5, 0.45)) * 0.7
