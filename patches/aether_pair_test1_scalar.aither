# aether_pair_test1_scalar — Test 1 control (scalar baseline).
#
# Same write convention as aether_pair_sympathy.aither, but magScale=0
# zeroes the magnetic component so the medium degenerates to the scalar
# version. One source voice (struck at A=220), one receiver voice
# (rings at C#=277.18). Receiver reads the rotated dielectric tap;
# at magScale=0 rotation has no effect.

$aetherDie = 0.0
$aetherMag = 0.0
$prevStrike = 0.0

let driveAmp      = 10000000.0
let burstAmp      = 1000000.0
let aetherWrite   = 0.1
let aetherDecay   = 0.95
let coupling      = 1.0
let damping       = 0.001
let magScale      = 0.0     # SCALAR control
let rotationAngle = 0.0
let strikeRate    = 2.0

play test1:
  let trig    = impulse(strikeRate)
  let burst   = pluck(trig, 0.03)
  let strike  = trig * driveAmp + noise() * burst * burstAmp

  let dieDrive = strike
  let magDrive = strike - $prevStrike
  $prevStrike  = strike

  $aetherDie = $aetherDie * aetherDecay + dieDrive * aetherWrite
  $aetherMag = $aetherMag * aetherDecay + magDrive * aetherWrite * magScale

  let pair  = rotate($aetherDie, $aetherMag, rotationAngle)
  let aRead = pair[0] * coupling

  # Single receiver voice — rings at 277.18 Hz, never directly struck
  let v2 = dho(aRead, 277.18, damping)
  let s = v2 * 0.15
  [s, s]

test1
