# acid_complex — kick + acid bass + didgeridoo + Tesla-organ keys.
# Four instruments, four sliders, two effect knobs each on the
# autonomous parts, two aither-specific shape knobs on the didge.
#
# 130 BPM, 4-on-the-floor kick, 16-step D-minor pentatonic acid bass.
# Didgeridoo drones in D, Tesla organ plays whatever you press.
#
# ============================================================ SLIDERS
#   S1 (CC 82) — KICK VOL
#   S2 (CC 83) — BASS VOL
#   S3 (CC 85) — DIDGERIDOO VOL
#   S4 (CC 17) — FLUTE VOL        (the keyboard instrument; white keys
#                                   scale-lock to D minor pentatonic
#                                   so every key fits the song)
#
# ============================================================ KICK KNOBS
#   K1 (CC 74) — KICK PARADIGM    crossfade three kick recipes:
#                                   A — 808 sub (pitch-swept sine)
#                                   B — DHO body strike (physical)
#                                   C — FM-distorted boom
#   K2 (CC 71) — KICK PUNCH       sweep depth + body damp combined
#   K3 (CC 76) — KICK SHIFT       freq_shift on kick output, ±400 Hz
#
# ============================================================ BASS KNOBS
#   K4 (CC 77) — BASS PARADIGM    acid / bell / noise-formant
#   K5 (CC 93) — BASS DENSITY     mono / +oct / +5th / +7th cluster
#   K6 (CC 18) — BASS SHIFT       freq_shift on bass output, ±400 Hz
#
# ============================================================ DIDGE KNOBS
#   K7 (CC 19) — WAH RATE         how fast the mouth opens and closes.
#                                   K7=0    : ~0.5 Hz (slow drone)
#                                   K7=1    : ~6 Hz (rapid wakka-wakka)
#   K8 (CC 16) — WAH DEPTH        how far the cutoff swings.
#                                   K8=0    : nearly fixed, dark drone
#                                   K8=1    : full vowel-range sweep
#                                            (200 → 2000 Hz), bright
#                                            articulation
#
# Synthesised didge is one of the hardest sounds to make convincingly
# (real didges depend on coupling between the player's vocal tract
# and the bore — a non-linear feedback loop no pure synthesis
# captures). What this gets you: a "digital didge" character —
# saw + resonant LPF + LFO sweep, the recipe that gets to 90%
# according to every source. Don't expect a recording-quality
# imitation; expect a characterful aither voice.

let kickVol  = midi_cc(82)
let bassVol  = midi_cc(83)
let didgeVol = midi_cc(85)
let fluteVol = midi_cc(17)

let kickParadigm = midi_cc(74)
let kickPunch    = midi_cc(71)
let kickShift    = (midi_cc(76) - 0.5) * 800

let bassParadigm = midi_cc(77)
let bassDensity  = midi_cc(93)
let bassShift    = (midi_cc(18) - 0.5) * 800

let wahRate  = 0.5 + midi_cc(19) * 5.5
let wahDepth = midi_cc(16)

let tempo = 130 / 60.0

# 16-step D-minor pentatonic acid pattern.
let bassNotes = [
  73.42,  73.42,  146.83, 73.42,
  87.31,  73.42,  98.0,   73.42,
  110.0,  73.42,  73.42,  146.83,
  87.31,  110.0,  73.42,  73.42
]
let bassAccent = [
  1.0, 0.4, 1.0, 0.4,
  0.4, 0.4, 1.0, 0.4,
  1.0, 0.4, 0.4, 1.0,
  0.4, 1.0, 0.4, 0.4
]

# Master clock
let stepRate = tempo * 4
let bPhase   = phasor(stepRate / 16)
let bIdx     = int(bPhase * 16)
let bAcc     = bassAccent[bIdx]
let bFreq    = bassNotes[bIdx]
let bTrig    = impulse(stepRate)
let bEnv     = pluck(bTrig, 0.12 + bAcc * 0.25)
let kTrig    = impulse(tempo)
let kEnv     = discharge(kTrig, 8)

# Didgeridoo breath — slow, irregular pulse from two incommensurate
# LFOs. Adds the natural rise-and-fall of a real didge instead of a
# perfectly steady drone.
let breathA  = (sin(TAU * t * 0.27) + 1) * 0.5
let breathB  = (sin(TAU * t * 0.41) + 1) * 0.5
let breath   = 0.4 + breathA * breathB * 0.6

play acid:
  # ===== KICK =====
  let sweepDepth = 60 + kickPunch * 180
  let pSweep   = 35 + discharge(kTrig, 30) * sweepDepth
  let kickA    = sin(TAU * phasor(pSweep)) * kEnv

  let bodyDamp = 0.04 - kickPunch * 0.025
  let kickB    = dho(kTrig * 50000000.0, 200, bodyDamp) * 0.5

  let fmDepth  = 0.5 + kickPunch * 4.0
  let modSig   = sin(TAU * phasor(pSweep * 1.5)) * fmDepth
  let kickC    = sin(TAU * phasor(pSweep) + modSig) * kEnv * 0.7

  let kwA = max(0, 1 - kickParadigm * 2)
  let kwB = (if kickParadigm < 0.5
             then kickParadigm * 2
             else 1 - (kickParadigm - 0.5) * 2)
  let kwC = max(0, (kickParadigm - 0.5) * 2)
  let kickClick = noise() * discharge(kTrig, 200) * 0.3
  let kickRaw   = kickA * kwA + kickB * kwB + kickC * kwC + kickClick
  let kickShifted = freq_shift(kickRaw, kickShift)
  let kickSig     = kickShifted * kickVol * 0.5

  # ===== BASS =====
  let saw   = additive(bFreq, saw_shape, 10)
  let cutA  = 600 + bEnv * 3200 * (0.5 + bAcc * 0.5)
  let bassA = dho(saw * 80000.0, cutA, 0.025) * bEnv * (0.4 + bAcc * 0.6)

  let bForceB = 22000.0 * bFreq
  let bassB   = dho(bTrig * bForceB, bFreq, 0.008) * bEnv * (0.5 + bAcc * 0.5) * 0.4

  let nAmp  = bEnv * (0.3 + bAcc * 0.7) * 6000000.0
  let bassC = dho(noise() * nAmp, bFreq * 3, 0.025) * 6.0

  let bwA = max(0, 1 - bassParadigm * 2)
  let bwB = (if bassParadigm < 0.5
             then bassParadigm * 2
             else 1 - (bassParadigm - 0.5) * 2)
  let bwC = max(0, (bassParadigm - 0.5) * 2)
  let bassMix = bassA * bwA + bassB * bwB + bassC * bwC

  let envH  = bEnv * (0.4 + bAcc * 0.6)
  let h_oct = additive(bFreq * 2.0,  saw_shape, 6) * envH
  let h_fth = additive(bFreq * 3.0,  saw_shape, 5) * envH
  let h_7th = additive(bFreq * 3.56, saw_shape, 4) * envH
  let w_oct = clamp(bassDensity / 0.33,          0, 1)
  let w_fth = clamp((bassDensity - 0.33) / 0.33, 0, 1)
  let w_7th = clamp((bassDensity - 0.66) / 0.34, 0, 1)
  let bassStack = (bassMix
               + h_oct * w_oct * 0.36
               + h_fth * w_fth * 0.30
               + h_7th * w_7th * 0.26)
  let bassShifted = freq_shift(bassStack, bassShift)
  let bassSig     = bassShifted * bassVol * 0.5

  # ===== DIDGERIDOO =====
  # Built from real didgeridoo acoustics, not a generic vowel pad:
  #
  #   1. Lip-buzz harmonic stack — 16 partials at 73.42 Hz with the
  #      characteristic 1/n^0.6 amplitude falloff of a conical bore.
  #      Per-partial slow incommensurate drift (breath turbulence)
  #      keeps the spectrum alive.
  #   2. Three MOVING vocal-tract formants (F1 throat, F2 mouth,
  #      F3 tongue) — the formant frequencies sweep on slow
  #      incommensurate LFOs, so the timbre breathes and "wahs"
  #      naturally. This is what makes a real didge sound alive
  #      vs a static drone.
  #   3. Vocal layer (K7) — a hum at the perfect 5th above fundamental
  #      plus a sub-octave growl, mixed in by K7. Players vocalise
  #      while playing; the bore transmits both lip buzz and voice.
  #      Beat frequencies between the two pitches give the
  #      characteristic animal/throat-singing quality.
  #   4. Tonguing accents — 3 Hz percussive bursts on the F3 region.
  #   5. Circular breathing — dual-LFO amplitude pulse already in
  #      `breath` above.

  # Canonical didge recipe — saw → resonant LPF → LFO sweep.
  # The recipe every synthesist agrees gets to 90%. Rejected the
  # over-engineered formant/articulation stack — it was fighting
  # itself. Simple beats clever here.
  let didgeFund = 73.42

  # Sawtooth lip buzz (additive — saw IS the 1/n harmonic series).
  let lipBuzz = additive(didgeFund, saw_shape, 12)

  # Wah LFO — single sine at K7-controlled rate, depth controlled by K8.
  # At K8=0 the cutoff barely moves (dark drone). At K8=1 it sweeps
  # 200..2000 Hz (full mouth-shape modulation).
  let lfo      = sin(TAU * t * wahRate)
  let centerCut = 700
  let swing    = wahDepth * 800
  let mouthCut = max(centerCut + lfo * swing, 80)
  let voiced   = lipBuzz |> lpf(mouthCut, 0.95) |> drive(1.4)

  let didgeSig = voiced * breath * didgeVol * 0.5

  let mix = kickSig + bassSig + didgeSig
  [mix, mix]

# ===== FLUTE on the keys =====
# Additive flute via sum(8, n => ...). Real flute spectrum:
# strong fundamental + strong odd harmonics (3, 5, 7) + weak even
# harmonics (2, 4, 6). Soft swell envelope, gentle vibrato, and a
# hint of breath noise around the upper register.
#
# Every key is scale-locked to D minor pentatonic (D, F, G, A, C)
# so anything you press matches the kick + bass + didge.
play flute:
  midi_keyboard((freq, gate) =>
    # SCALE LOCK — snap incoming pitch to nearest D-minor pentatonic
    # note. Every key (white or black) lands on a scale tone.
    let n   = 12 * log2(freq / 440) + 69
    let oct = floor(n / 12)
    let pc  = n - oct * 12
    let q   = (if pc <= 1     then 0
               else if pc <= 3.5  then 2
               else if pc <= 6    then 5
               else if pc <= 8    then 7
               else if pc <= 10.5 then 9
               else                    12)
    let qFreq = 440 * pow(2, (oct * 12 + q - 69) / 12)

    # Envelope: soft swell for sustained tone, plus a per-strike
    # impulse for the chiff (air-against-edge) at attack.
    let env    = swell(gate, 0.05, 0.5)
    let strike = if gate > 0.5 and prev(gate) < 0.5 then 1.0 else 0.0
    let chiff  = (noise() |> hpf(2500, 0.5)) * pluck(strike, 0.06) * 0.18

    # IRREGULAR VIBRATO — sin of sin. The vibrato rate itself wobbles
    # so the modulation never repeats. Real players' vibrato is never
    # a perfect 5 Hz sine; this captures the "alive" quality.
    let vib = sin(TAU * t * 5.5 + sin(TAU * t * 0.7) * 0.4) * 0.005
    let f   = qFreq * (1 + vib)

    # Flute additive — same odd-harmonic-dominant amplitude shape,
    # but EACH PARTIAL has its own slow incommensurate drift. This is
    # the recipe that made fm_swarm and cello_max sound alive: every
    # harmonic wobbles at its own rate, so the spectrum is never
    # static. Tiny depth (0.2%) so it's coloration not detune.
    let voice = sum(8, n =>
      let amp = (if n == 1 then 1.00
                 else if n == 2 then 0.05
                 else if n == 3 then 0.45
                 else if n == 4 then 0.04
                 else if n == 5 then 0.25
                 else if n == 6 then 0.03
                 else if n == 7 then 0.12
                 else                0.02)
      let drift = 1 + 0.002 * sin(t * n / 13 + n * 0.4)
      let pf    = n * f * drift
      if pf >= 22000 then 0
      else amp * sin(TAU * phasor(pf)))

    # Continuous low-level breath noise.
    let breath = (noise() |> hpf(3000, 0.3)) * 0.025

    # BODY RESONANCE — DHO bandpass at the flute bore's natural
    # resonance (around 1400 Hz). Adds the "wooden tube" character;
    # without this it sounds like pure synthesis. Same trick as
    # cello_max's body BPFs, applied to the flute's signature
    # resonance frequency.
    let body = dho(voice * 6000.0, 1400, 0.12) * 0.18

    (voice * 0.18 + breath + body + chiff) * env * fluteVol)

# ===== HAND PAN — 8 pads, 8 D-minor-pentatonic notes =====
# Modeled on a high-end hand pan (Hang / RAV vast). The signature
# acoustic property is the COMPOUND CLANG MODE: each tongue is tuned
# so its three principal partials sit at the ratio 1 : 2 : 3
# (fundamental, exact octave, exact perfect-fifth-above-octave). That
# integer triad — almost impossible to achieve in a regular bell —
# is what gives a hand pan its meditative, perfectly-in-tune-with-itself
# character. Cheap pans miss this and sound clangy; expensive ones
# are tuned by hand to within a few cents of true.
#
# Per pad, the recipe is:
#   - Body sub-octave (the steel shell aura, very low amplitude)
#   - Fundamental (low damp, longest sustain)
#   - Octave above (medium damp, moderate amplitude)
#   - Perfect-fifth-above-octave (more damp, smaller amplitude)
#   - Crystalline 4× partial (quick decay, just for shimmer)
#   - Mallet click on attack
#
# Pad → note mapping (D KURD / D MINOR — the iconic Hang scale,
# the most popular hand pan tuning. Player ascends around the rim
# from D ding to A above):
#   Pad 1 (note 36) — D3  (146.83 Hz)  ding
#   Pad 2 (note 37) — A3  (220.00)
#   Pad 3 (note 38) — Bb3 (233.08)
#   Pad 4 (note 39) — C4  (261.63)
#   Pad 5 (note 40) — D4  (293.66)
#   Pad 6 (note 41) — E4  (329.63)
#   Pad 7 (note 42) — F4  (349.23)
#   Pad 8 (note 43) — G4  (392.00)
def handPan(trig, fund):
  # Damp values calibrated for a 4-6 second ring on the fundamental.
  # Per-partial slow drift (≈0.1%) keeps the spectrum alive during
  # the long sustain — same "secret sauce" as the cello/Tesla
  # recipes. Octave is detuned 3 cents flat for natural beating
  # (perfect octaves sound artificial; real expensive pans are
  # tuned with deliberate slight imperfection).
  let force = trig * 22000.0 * fund
  let d1 = 1 + 0.0010 * sin(t * 0.71 + 0.3)
  let d2 = 1 + 0.0008 * sin(t * 1.13 + 1.7)
  let d3 = 1 + 0.0012 * sin(t * 1.39 + 2.4)
  let d4 = 1 + 0.0015 * sin(t * 1.91 + 0.9)
  let body = dho(trig * 4000.0 * fund,  fund * 0.5,         0.0035) * 0.22
  let f1   = dho(force,                 fund * d1,           0.00020)
  let f2   = dho(force * 0.55,          fund * 1.998 * d2,   0.00050) * 0.55
  let f3   = dho(force * 0.32,          fund * 3.0 * d3,     0.00170) * 0.40
  let f4   = dho(force * 0.16,          fund * 4.0 * d4,     0.00500) * 0.22
  # Mallet attack — brief inharmonic chirp via additive sines at
  # phi-spaced ratios well above the fundamental. Metallic "ping"
  # that decays in ~40ms, leaving the tongue's ring to take over.
  let chirp = sum(6, n =>
    let r  = 5 + pow(1.618, n)
    let pf = fund * r
    if pf >= 22000 then 0
    else (1.0 / pow(n + 1, 0.65)) * sin(TAU * phasor(pf)))
  let click = chirp * pluck(trig, 0.04) * 0.10
  body + f1 + f2 + f3 + f4 + click

play pads:
  let p1 = handPan(midi_trig(36), 146.83)   # D3 ding
  let p2 = handPan(midi_trig(37), 220.00)   # A3
  let p3 = handPan(midi_trig(38), 233.08)   # Bb3
  let p4 = handPan(midi_trig(39), 261.63)   # C4
  let p5 = handPan(midi_trig(40), 293.66)   # D4
  let p6 = handPan(midi_trig(41), 329.63)   # E4
  let p7 = handPan(midi_trig(42), 349.23)   # F4
  let p8 = handPan(midi_trig(43), 392.00)   # G4
  let mix = (p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8) * 0.28

  # SYMPATHETIC RESONANCE HALO — high-Q DHO at the song's tonic D.
  # Whenever any pad's partials touch D (octaves of the ding, the
  # 5-up A's overtones, etc.), this resonator picks up the energy
  # and rings, creating the "wash of sympathetic vibration" you hear
  # from a real expensive hand pan when neighbouring tongues vibrate.
  let halo = dho(mix * 25.0, 146.83, 0.0006) * 0.5
  let out  = mix + halo
  [out, out]

# Master FX: drive + reverb hardcoded (knobs are now per-instrument).
let dry  = acid + flute + pads
let mono = (dry[0] + dry[1]) * 0.5
let dist = drive(mono, 1.8)
let wet  = dist |> reverb(2.8, 0.35)
([dist, dist] + [wet, wet] * 0.3) * 0.55
