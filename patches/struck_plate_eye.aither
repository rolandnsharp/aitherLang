# struck_plate_eye: the struck plate's Chladni figures, found in what you
# hear. It listens to struck_plate through input() and draws the plate.
#
# The plate's modes ring at known pitches, (m² + n²) / 2 times its lowest.
# A lock-in tuned to each (the sound times a wave at that pitch, smoothed:
# how a radio finds a station) says how much of it is ringing and in what
# phase. Each pickup hears every mode times its shape where it listens,
# so one channel gives a mode alone, and the two channels give a pair
# that ring together on a square, (m, n) and (n, m): two equations, two
# unknowns. Each mode found is drawn as its shape, m half-waves across
# and n down, and the plate is their sum: the figure the sound holds.
#
# Hue is phase: each side of a nodal line moves the other way, so shows
# the opposite colour, and the black lines between are where Chladni's
# sand gathers. Each mode turns at its pitch slowed 256 times, so a figure
# made of several shimmers as they come in and out of step. Brightness
# is against the frame before's strongest swing, so a figure shows whole
# as the plate dies away, the higher modes going first.
#
#   tools/pad --notes & ./aither patches/struck_plate.aither | tools/play hw:rockchipes8388c 20 |
#     AITHER_SOCK=/tmp/aither-picture.sock ./aither patches/struck_plate_eye.aither | tools/tv --size 48x27 --smooth

let w = 48
let h = 27
let k = pixel_index(w, h)
let x = k mod w
let y = int(k / w)
let p = (x - 10 + 0.5) / 27                          # the plate: a square, 27 across, centred
let q = (y + 0.5) / 27
let inside = x >= 10 and x <= 36
let rim = x == 9 or x == 37

let lowest = 293.66                                  # struck_plate's mode (1, 1)
let (l, r) = input()

def phi(m, n, p, q): sin(m * PI * p) * sin(n * PI * q)

# A lock-in: the sound turned back by a spin at the pitch, smoothed twice
# over 15 ms.
def hear(sig, back):
  $a = (0, 0)
  $b = (0, 0)
  $a = $a + (back * sig - $a) * (dt / 0.015)
  $b = $b + ($a - $b) * (dt / 0.015)
  $b * 2

# A mode alone at its pitch: both pickups, least squares.
def single(m, f, l, r, p, q):
  let back = conj(spin(f))
  let a1 = phi(m, m, 0.4, 0.81)
  let a2 = phi(m, m, 0.2, 0.4)
  let found = (hear(l, back) * a1 + hear(r, back) * a2) / (a1 * a1 + a2 * a2)
  found * spin(f / 256) * phi(m, m, p, q)

# Two modes at one pitch, (m, n) and (n, m): two pickups, solved.
def double(m, n, f, l, r, p, q):
  let back = conj(spin(f))
  let zl = hear(l, back)
  let zr = hear(r, back)
  let a = phi(m, n, 0.4, 0.81)
  let b = phi(n, m, 0.4, 0.81)
  let c = phi(m, n, 0.2, 0.4)
  let d = phi(n, m, 0.2, 0.4)
  let det = a * d - b * c
  let one = (zl * d - zr * b) / det
  let other = (zr * a - zl * c) / det
  (one * phi(m, n, p, q) + other * phi(n, m, p, q)) * spin(f / 256)

let f = lowest
let plate = single(1, f, l, r, p, q) + double(1, 2, 2.5 * f, l, r, p, q)
          + single(2, 4 * f, l, r, p, q) + double(1, 3, 5 * f, l, r, p, q)
          + double(2, 3, 6.5 * f, l, r, p, q) + double(1, 4, 8.5 * f, l, r, p, q)
          + single(3, 9 * f, l, r, p, q) + double(2, 4, 10 * f, l, r, p, q)
          + double(3, 4, 12.5 * f, l, r, p, q) + single(4, 16 * f, l, r, p, q)

# Brightness against the strongest swing of the frame before, so a figure
# shows whole however loud, until the plate is all but still.
let swing = if inside then amplitude(plate) else 0
$peak = 0.0
$last = 0.001
$last = if k == 0 then max(0.002, $peak) else $last
$peak = if k == 0 then swing else max($peak, swing)
let g = plate / $last
if inside then g / max(1, amplitude(g)) else if rim then (0.05, 0.05) else (0, 0)
