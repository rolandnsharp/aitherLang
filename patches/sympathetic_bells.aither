# sympathetic_bells: two bells resonating with each other through a field
# (notes/spinors-2026-11-05.md, "Instruments resonating through the
# field").
#
# Two bells of struck_bell's kind, each mode a doublet pair, the second
# an octave above the first, so they share modes: its hum is the first's
# prime (196 Hz), its prime the first's nominal (392 Hz). Between them is
# a field, held as its dipole part, a direction and a size: each bell
# pours its vibration into it along the way it faces, and is driven by
# it along the way it faces. That is COMPOSING's sympathetic strings
# ("Coupling: one sample of shared state") with the field for the
# bridge: every bell writes it and every bell reads it, a sample later.
# Resonance does the choosing: the field carries all of the first bell,
# and the second answers only on the modes they share.
#
# Like two antennas: facing the same way they share the field fully,
# turned crosswise they don't hear each other at all, turned to face
# opposite ways they answer inverted. The field and the ways the bells
# face are directions, pairs of pairs whose first number is 0 (Hamilton's
# vectors, SPEC "Pairs of pairs"); the second bell's facing is "ahead", i,
# turned by a rotation made of a turn and a tilt.
#
# Each bell hears the field less its own part (its own sound coming back
# to it would be a second, louder loop); the first bell is struck every
# 8 s by itself, so the second's answer can be heard without playing. The
# first bell is on the left, the second on the right.
#
#   ... | tools/scope --decay 0.9 | tools/play hw:rockchipes8388c 20    to see one bell against the other
#
# The gamepad (tools/pad): A strikes the first bell, B the second; hold A
# and press left and right to turn the second bell (CC 21), up and down
# to tilt it (CC 20); hold B and press up and down for a stronger field
# (CC 22), up to the edge where the two would feed each other without
# end.
#
# Measured, the first bell struck once: facing the same way, the second
# answers 20 dB under it on the shared modes (196 and 392 Hz), its answer
# growing over the first seconds; crosswise, 58 dB under, silent; half
# turned, 23 dB; turned to face opposite, as loud as aligned, inverted.
#   tools/pad & AITHER_MIDI=aither-pad ./aither patches/sympathetic_bells.aither | tools/play hw:rockchipes8388c 20

# ---------------------------------------------------------------- the bells

# Six modes: frequency over the prime, ring (s, to 1/e), level, how many
# times round the bell each winds, and how far its doublet is split (a
# bell with a flat side, as struck_bell).
let ratio = [0.5, 1.0, 1.2, 1.5, 2.0, 2.5]
let ring  = [9.0, 5.0, 4.0, 2.2, 3.0, 1.6]
let level = [0.7, 0.5, 0.45, 0.25, 0.55, 0.3]
let winds = [2, 2, 3, 3, 4, 4]
let split = [1.006, 1.0093, 1.0108, 1.0072, 1.0089, 1.0101]

# A bell: every push (a strike, or the field) reaches each mode's pair
# turned by the mode's winding at where it lands, over 2 pi f so a strike
# of area 1 rings each mode at its level.
def bell(push_in, prime, where):
  sum(6, k =>
    let f = prime * ratio[k - 1]
    let (pa, pb) = rotate((push_in / (TAU * f), 0), winds[k - 1] * where)
    let a = resonator(pa, f, 2 / ring[k - 1])
    let b = resonator(pb, f * split[k - 1], 2 / ring[k - 1])
    (a + b) * level[k - 1])

# A strike: a push of area 1 swelling and dying over a millisecond.
def push(trig): (discharge(trig, 1 / 0.001) - discharge(trig, 1 / 0.0003)) / 0.0007

# ---------------------------------------------------------------- facing

# The first bell faces ahead, i. The second: turned about the vertical,
# k, then tilted about j, from the knobs (each starting at 0: facing the
# same way). Composed rotations apply right first.
let yaw = slew(midi_cc(21), 0.05) * TAU
let tilt = slew(midi_cc(20), 0.05) * TAU
let face1 = i
let face2 = apply(about(j, tilt) * about(k, yaw), i)

# ---------------------------------------------------------------- the field

# The field as last sample's bells left it: its dipole, a direction and
# a size, each bell's own part along its facing, so each can hear the
# others.
$s1 = 0
$s2 = 0
let field = face1 * $s1 + face2 * $s2
# How strongly the bells share the field. A loop has a gain: measured
# (struck once, left to ring 40 s), the ringing dies away up to about
# 0.55, the bells holding each other longer the stronger it is; at 0.7
# it barely holds, and from 0.85 it grows until the engine's guard mutes
# it. So the knob goes 0.4 to 0.6.
let strength = 0.4 + 0.2 * midi_cc(22)
# What a bell hears: the field along its facing, less its own part. For
# two directions Hamilton's product is minus their dot product, then
# their cross product: the dot product is minus its first number.
def along(face, v):
  let ((w, _), (_, _)) = face * v
  -w
let heard1 = along(face1, field - face1 * $s1) * strength
let heard2 = along(face2, field - face2 * $s2) * strength

# ---------------------------------------------------------------- playing

let auto = impulse(1 / 8)                                  # the first bell strikes itself every 8 s
let hit1 = push(auto + midi_trig(36)) * 0.9
let hit2 = push(midi_trig(37)) * 0.9
let b1 = bell(hit1 + heard1, 196, 0.4)
let b2 = bell(hit2 + heard2, 392, 1.1)
$s1 = b1
$s2 = b2

# The first bell on the left, the second on the right, each a side to
# itself, the second's answer lifted to be heard. On the scope the pair
# is one bell against the other: a flat line while the second is silent,
# opening into figures as it answers, the figure mirrored when it answers
# inverted.
let mix = [b1 * 0.35, b2 * 0.9]
mix |> reverb(2.2, 0.12) |> tanh
