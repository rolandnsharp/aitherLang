# spectrum_freeze — hold a sound's spectrum and let it go on sounding.
#
# This patch hears a spectrum, not a sound: it goes between tools/fft and
# tools/ifft, with 4096 samples a frame, so input() is a bin at a time,
# 2048 bins a frame, 11 Hz apart.
#
#   cd ~/aitherLang; pgrep -x pad > /dev/null || { tools/pad & sleep 1; }
#   aither patches/field_didge.aither | tools/fft 4096 \
#     | AITHER_SOCK=/tmp/freeze.sock AITHER_MIDI=aither-pad aither patches/spectrum_freeze.aither \
#     | tools/ifft 4096 | tools/play
#
# X with up on the uConsole's pad (tools/pad, knob 24) holds the spectrum,
# until X with down: A, B and the arrows stay free to play the field going
# in (field_didge, scanned_ring, string_keys use those). Held, each bin is an oscillator ringing on at
# the frequency the sound had there: how far the bin turned from one frame
# to the next says how far its frequency lies from the bin's. A harmonic
# lies across a few bins, and they turn together, at the speed of the
# loudest, so they ring as the one wave they are, and the held sound goes
# on as the waves it was. A frame is a row and a bin a pixel,
# so the arrays that hold it step once a frame, as a picture's do.

let frame = 2048
let bin = pixel_index(frame, 1)

$level = array(frame, 0, every = frame)      # how loud each bin was
$turn = array(frame, 0, every = frame)       # where its oscillator points
$speed = array(frame, 0, every = frame)      # how far it turns in a frame
$heard = array(frame, (0, 0), every = frame) # the bin as it came, a frame ago

let frozen = midi_cc(24) > 0

let [in_re, in_im] = input()
let here = (in_re, in_im)                    # a spectrum's bin: one complex number

# how far the sound turned in this bin since the last frame: half a turn a
# bin, as the frame steps half its length, and what it strays from that is
# how far its frequency lies from the bin's
let strayed = phase(here * conj($heard[bin]) * (if bin mod 2 == 1 then -1 else 1))

let below = max(bin - 1, 0)
let above = min(bin + 1, frame - 1)
let lead_low = if $level[below] > $level[bin] then below else bin
let lead = if $level[above] > $level[lead_low] then above else lead_low
let turned = ($turn[bin] + $speed[lead]) mod TAU

$heard[bin] = here
$level[bin] = if frozen then $level[bin] else amplitude(here)
$speed[bin] = if frozen then $speed[bin] else PI * bin + strayed
$turn[bin] = if frozen then turned else phase(here)
if not frozen then here else if bin == 0 then (0, 0) else rotate(($level[bin], 0), turned)
