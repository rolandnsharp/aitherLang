# aether_pair_v2_test2_pair — Test 2 with analytic-signal pair.
#
# Same single-voice topology as test1, with the rotation angle
# sweeping at 1/30 Hz across the audit (one full turn over 30 sec).
# The diagnosis from the derivative-pair run predicts this should
# produce a smooth spectral-character morph if the analytic
# decomposition truly preserves equal-magnitude pair components.

$aetherDie = 0.0
$aetherMag = 0.0

let driveAmp      = 10000000.0
let burstAmp      = 1000000.0
let aetherWrite   = 0.1
let aetherDecay   = 0.95
let coupling      = 1.0
let damping       = 0.001
let magScale      = 1.0
let strikeRate    = 2.0

play test2:
  let trig    = impulse(strikeRate)
  let burst   = pluck(trig, 0.03)
  let strike  = trig * driveAmp + noise() * burst * burstAmp

  let strikePair = analytic(strike)
  let dieDrive   = strikePair[0]
  let magDrive   = strikePair[1]

  $aetherDie = $aetherDie * aetherDecay + dieDrive * aetherWrite
  $aetherMag = $aetherMag * aetherDecay + magDrive * aetherWrite * magScale

  let rotationAngle = phasor(1.0 / 30.0) * TAU
  let pair  = rotate($aetherDie, $aetherMag, rotationAngle)
  let aRead = pair[0] * coupling

  let v2 = dho(aRead, 277.18, damping)
  let s = v2 * 0.15
  [s, s]

test2
