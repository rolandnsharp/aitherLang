# aether_pair_test3_scalar — Test 3, SCALAR control patch.
#
# The scalar aether has no representation of theta. Voice 2 writes its
# strike as a scalar add, regardless of any nominal pair-angle. This
# patch is invariant in theta; running it twice should produce
# identical RMS, which proves scalar can't represent the phase
# difference. (Used only for documentation — the test runs this once
# to establish the baseline for comparison.)

$aether = 0.0

let driveAmp      = 10000000.0
let burstAmp      = 1000000.0
let aetherWrite   = 0.1
let aetherDecay   = 0.95
let coupling      = 1.0
let damping       = 0.001
let strikeRate    = 2.0

play test3:
  let trig    = impulse(strikeRate)
  let burst   = pluck(trig, 0.03)
  let strike1 = trig * driveAmp + noise() * burst * burstAmp
  let strike2 = trig * driveAmp + noise() * burst * burstAmp

  # Scalar aether sums both voices' strikes — no rotation possible
  $aether = $aether * aetherDecay + (strike1 + strike2) * aetherWrite

  let v3 = dho($aether * coupling, 277.18, damping)
  let s = v3 * 0.15
  [s, s]

test3
