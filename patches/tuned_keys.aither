# tuned_keys — metal_keys with a tuning that follows the spectrum. The
# morph knob moves every note's partials AND the keyboard's intervals
# from a string's to a metal bar's to golden-ratio ones, together, so a
# chord stays consonant all the way as it turns to metal.
#
# Why: which intervals sound smooth depends on the partials (Sethares).
# Harmonic partials make 5/4, 3/2 and the octave consonant; a metal
# bar's partials don't, and played in ordinary tuning bar chords clash.
# Retuned to the bar's own consonances they ring. Gamelan does this
# with its metallophones; here a knob does it while you play.
# patches/lib/spectral.aither has the tables, tools/consonance.py makes
# them. White keys only: 7 degrees, C4 = degree 0. The scale repeats at
# the octave for the string, at 2.778 for the bar (it has no consonant
# octave), at phi^2 for phi.
#
# Notes from a MIDI keyboard; knobs from the gamepad (tools/pad):
#   A  up/down  morph     timbre and tuning: 0 string .. 0.5 bar .. 1 phi
#      l/r      strike    how far velocity throws the attack toward metal
#   B  up/down  settle    how long the strike's metal takes to fade
#      l/r      bloom     a held note drifts toward metal
#   X  up/down  bright    partial roll-off
#      l/r      release   0.1 .. 4 s
#   Y  up/down  space     reverb
#      l/r      (free)
# The strike and bloom move only the timbre; the tuning follows morph.

import "lib/spectral.aither"

let morph   = midi_cc(20)
let strike  = 0.4 + 0.6 * midi_cc(21)
let settle  = 0.05 * pow(60, midi_cc(22))
let bloom   = midi_cc(23)
let rolloff = 1.3 - 0.9 * midi_cc(24)
let release = 0.1 * pow(40, midi_cc(25))
let space   = midi_cc(26)

def note(key, gate, vel):
  let hit = if gate > 0.5 and prev(gate) < 0.5 then 1 else 0
  let metal = pluck(hit, settle) * vel * strike
  let grow  = swell(gate, 2.5, 0.3) * bloom
  let m = clamp(morph + metal + grow, 0, 1)
  let r = rolloff - 0.5 * metal
  let f = spectral_key(key, morph)               # 0 for a black key
  sum(8, n =>
    let pf = f * partial(n, m)
    if pf <= 0 or pf >= sr * 0.45 then 0
    else sin(TAU * phasor(pf)) * exp(-r * log(n)))
  * adsr(gate, 0.003, 0.5, 0.55, release) * (0.3 + 0.7 * vel) * 0.09

play keys:
  midi_keyboard((freq, gate, vel, key) => note(key, gate, vel))

keys
|> tanh
|> reverb(1.5 + 3 * space, 0.12 + 0.45 * space)
