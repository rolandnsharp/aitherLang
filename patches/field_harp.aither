# field_harp: five strings the wind plays
# (aeolian, as fields).
#
# Wind past a string sheds vortices at a rate that follows the wind. The wake
# is an oscillator of its own (a van der Pol, the wake-oscillator model:
# see aeolian's references), its lift pushes the string at a point, and the
# string's motion there pulls the wake back. So it locks: the string sings a
# harmonic, and as the wind rises it jumps to the next it can reach. Nobody
# plays the notes: measured on a rising wind it goes 1, 2, 3, 4, 7, 9, skipping
# the harmonics with a node near where the wind meets it.
#
# A string is a def: a pair whose period can move, so its harmonics are exact
# and the note can be slid, and a wake, a law on plain state. Each call is its
# own string, so the harp is five calls, all tuned to one note but of
# different thickness, the wind meeting each at its own place: thin strings
# shed faster and sing higher harmonics, as aeolian's do. The wind gusts by
# itself. Two points of each string go to left and right, so on the scope the
# harmonics are figures, snapping to others as the wind moves.
#
#   ./aither patches/field_harp.aither | tools/scope --decay 0.9 | tools/play hw:rockchipes8388c 20
#
# The gamepad (tools/pad): hold A and press up and down to take the wind in
# hand (CC 20: down is the gusts, up is a gale, each press about a harmonic
# in between), left and right for the note (CC 21); hold B and press up and
# down for how long the string holds its energy (CC 22).
#   tools/pad & AITHER_MIDI=aither-pad ./aither patches/field_harp.aither | tools/scope --decay 0.9 | tools/play hw:rockchipes8388c 20

# ---------------------------------------------------------------- a string

def string(note, wind, thin, at, loss):
  $v = field(period = 1 / note, ends = fixed)
  $i = field(period = 1 / note, ends = free)
  let shed = TAU * note * (0.5 + wind * 11.5) * thin       # vortices a second, as the wind
  let moving = $v(at)                                      # the string where the wind meets it
  $q = 0.1
  $r = 0
  $r' = -$q * shed ^ 2 + shed * 0.1 * (1 - $q ^ 2) * $r + moving * 0.5 * shed ^ 2
  $q' = $r
  $v' = -∇$i - $v * loss + $q * 0.01 * δ(at)                # the wake's lift, where the wind meets it
  $i' = -∇$v - $i * loss
  [$v(0.13), $v(0.71)]

# ---------------------------------------------------------------- the harp

# The gusts blow by themselves until the knob takes over. Vortices are
# counted against the note, so the wind picks a harmonic and the note moves
# the whole sound. That is a liberty: real wind doesn't care how the string is
# tuned, and without it the note hardly moves the pitch, which stays with the wind.
let note = 110 * pow(2, slew(floor(midi_cc(21) * 25) / 12, 0.08))
let loss = 0.03 - 0.02 * midi_cc(22)                       # what it loses, a round
let gust = 0.4 + 0.25 * sin(TAU * phasor(1 / 23)) + 0.12 * sin(TAU * phasor(1 / 7.1))
let hand = midi_cc(20)
let wind = slew(gust * (1 - hand) + hand, 0.15)

let thin = [0.6, 0.8, 1, 1.3, 1.7]
let at = [0.37, 0.29, 0.41, 0.23, 0.33]
sum(5, n => string(note, wind, thin[n - 1], at[n - 1], loss)) * 2 |> tanh
