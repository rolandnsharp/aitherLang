# tuned_chords — tuned_keys playing itself, for when there's no keyboard.
# A four-chord cycle on the white keys (C-E-G, F-A-C, G-B-D, A-C-E, a
# little strummed, with a bass note) while the gamepad knobs stay live.
# Sweep A up/down: the chords' timbre AND intervals bend from a string's
# to a metal bar's to golden-ratio ones together, so they stay consonant
# as they turn to metal. See tuned_keys.aither for why; the knobs are
# the same, and Y l/r sets how long each chord lasts (2 .. 8 s).
#
#   A  up/down  morph     timbre and tuning: 0 string .. 0.5 bar .. 1 phi
#      l/r      strike    how far velocity throws the attack toward metal
#   B  up/down  settle    how long the strike's metal takes to fade
#      l/r      bloom     a held note drifts toward metal
#   X  up/down  bright    partial roll-off
#      l/r      release   0.1 .. 4 s
#   Y  up/down  space     reverb
#      l/r      length    seconds per chord, 2 .. 8

import "lib/spectral.aither"

let morph   = midi_cc(20)
let strike  = 0.4 + 0.6 * midi_cc(21)
let settle  = 0.05 * pow(60, midi_cc(22))
let bloom   = midi_cc(23)
let rolloff = 1.3 - 0.9 * midi_cc(24)
let release = 0.1 * pow(40, midi_cc(25))
let space   = midi_cc(26)
let length  = 2 * pow(4, midi_cc(27))

# The knobs come in as arguments: a def sees only what it's given.
def note(key, gate, vel, morph, strike, settle, bloom, rolloff, release):
  let hit = if gate > 0.5 and prev(gate) < 0.5 then 1 else 0
  let metal = pluck(hit, settle) * vel * strike
  let grow  = swell(gate, 2.5, 0.3) * bloom
  let m = clamp(morph + metal + grow, 0, 1)
  let r = rolloff - 0.5 * metal
  let f = spectral_key(key, morph)               # 0 for a black key
  sum(8, n =>
    let pf = f * partial(n, m)
    if pf <= 0 or pf >= sr * 0.45 then 0
    else sin(TAU * phasor(pf)) * exp(-r * log(n)))
  * adsr(gate, 0.003, 0.5, 0.55, release) * (0.3 + 0.7 * vel) * 0.09

# The cycle: a clock in chords, so the length knob can move without a jump.
$clock = 0.0
$clock = $clock + dt / length
let chord = floor($clock) mod 4
let pos = ($clock - floor($clock)) * length            # seconds into the chord
let chords = [60, 64, 67, 65, 69, 72, 67, 71, 74, 69, 72, 76]   # MIDI keys
def held(pos, from, until): if pos >= from and pos < until then 1 else 0
let hold = length - 0.35                               # a gap, so each chord strikes

play keys:
  note(chords[chord * 3], held(pos, 0.0, hold), 0.8, morph, strike, settle, bloom, rolloff, release)
  + note(chords[chord * 3 + 1], held(pos, 0.05, hold), 0.6, morph, strike, settle, bloom, rolloff, release)
  + note(chords[chord * 3 + 2], held(pos, 0.1, hold), 0.7, morph, strike, settle, bloom, rolloff, release)
  + note(chords[chord * 3] - 12, held(pos, 0.0, hold), 0.9, morph, strike, settle, bloom, rolloff, release)

keys
|> tanh
|> reverb(1.5 + 3 * space, 0.12 + 0.45 * space)
