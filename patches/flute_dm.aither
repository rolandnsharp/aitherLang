# flute_dm — a low, slow flute line in D minor (bass-flute register, from D3).
# Same voice as flute.aither: breathy sine + odd harmonics + vibrato, legato.

let pos = t - start_t

# fade in over 4s.
let fadeIn = ease(pos / 4)

# D natural minor from D3: D E F G A Bb C D
let wander = (sin(TAU * pos * 0.043) + sin(TAU * pos * 0.027) + 2) * 0.5 * 8
let idx    = int(wander) mod 8
let step   = if idx == 0 then 0 else if idx == 1 then 2 else if idx == 2 then 3 else if idx == 3 then 5 else if idx == 4 then 7 else if idx == 5 then 8 else if idx == 6 then 10 else 12
let target = 146.83 * pow(2, step / 12)
let freq   = slew(target, 0.1)

# vibrato: slower and a touch wider than the high flute.
let vib     = sin(TAU * phasor(4.6)) * 0.009
let vFreq   = freq * (1 + vib)

# low flutes are breathier: more noise, slightly more 2nd/3rd harmonic.
# One pipe per let: chaining `|> bpf(...) |> hpf(...)` currently blows up.
let air     = noise() |> bpf(vFreq * 2, 0.6)
let breath  = air |> hpf(vFreq, 0.2)
let tone    = osc(sin, vFreq) * 0.7 + osc(sin, vFreq * 2) * 0.05 + osc(sin, vFreq * 3) * 0.08 + osc(sin, vFreq * 5) * 0.02 + breath * 0.07

# phrasing: slow amplitude curve over 16s, so it breathes in long notes.
let phrase  = (sin(TAU * pos / 16 - PI / 2) + 1) * 0.5
let phrG    = 0.35 + phrase * 0.5

let voice   = tone * phrG |> lpf(vFreq * 3.5, 0.25)
let wet     = voice |> reverb(3.0, 0.45)
let mix     = voice * 0.5 + wet * 0.6

# slow pan on a 60s cycle.
let pan     = sin(TAU * pos / 60) * 0.6
let ang     = (pan + 1) * PI / 4
let l       = mix * cos(ang) * 1.41
let r       = mix * sin(ang) * 1.41

[l * fadeIn * 0.18, r * fadeIn * 0.18]
