# follow — a synth that follows the pitch you play into the mic.
#
# Pitch is how fast a phasor turns. analytic() makes the mic's
# fundamental (low-passed until little else is left) into a turning
# pair; turned back by last sample's conjugate, what is left is the
# angle it turned in one sample, and that angle over TAU dt is its
# frequency, at every sample, with no zero crossings to wait for. Its
# length is how loud it is: that opens the voice. A slew smooths the
# pitch, and it holds its last note through the gaps. It plays above you,
# with a sub an octave below. Tracks a clean sung glide to about 1%; a
# loud kick in the same mic pulls it about, so give it one instrument.
#
#   tools/card -- aither patches/follow.aither
#
# K1 (CC 74) the interval above you: unison to an octave.

let [mic, _] = input()
let z = analytic(lp1(lp1(mic, 700), 700))           # the fundamental, as a turning pair
let level = magnitude(z)
let step = phase(turn(z, conj(prev(z))))            # the angle it turned this sample
$pitch = 110
$pitch = if level > 0.01 then step / (TAU * dt) else $pitch   # hold the last pitch through the gaps
let f = slew(clamp($pitch, 40, 2000), 0.03)

let ratio = pow(2, floor(midi_cc(74) * 12.99) / 12)     # semitones above, 0..12
let gate = swell(if level > 0.01 then 1 else 0, 0.02, 0.4)
let voice = (osc(saw, f * ratio) + osc(saw, f * ratio * 1.004)) * 0.5 |> lpf(f * ratio * 4, 0.3)
let sub = osc(sin, f / 2)

(voice * 0.25 + sub * 0.3) * gate
