# slide_line: a plucked line whose length moves while it rings
# (notes/field-by-its-period-2026-11-06.md).
#
# Its period is a signal, so the note slides under the pluck, as a finger
# slides up a string. A line whose period moves is held as its two travelling
# waves, d'Alembert's: the same laws, stepped by the engine a different way,
# so its harmonics are exact and it costs about a tenth of a uConsole core.
# It is voltage and current on a line, or a string's velocity and its slope,
# which is the form that stays two travelling waves.
#
# The strike is a short blow at a point: the shorter, the brighter. The scope
# shows the line's two fields at one place against each other.
#
#   ./aither patches/slide_line.aither | tools/scope --decay 0.9 | tools/play hw:rockchipes8388c 20
#
# The gamepad (tools/pad): A plucks, B plucks softly; hold A and press left and
# right to slide the note (CC 21); hold B and press up and down for how long it
# rings (CC 22). It plucks itself every 3 s, and drifts up a fifth and back.
#   tools/pad & AITHER_MIDI=aither-pad ./aither patches/slide_line.aither | tools/scope --decay 0.9 | tools/play hw:rockchipes8388c 20

let drift = 0.5 - 0.5 * cos(TAU * phasor(1 / 12))
let note = 110 * pow(2, slew(floor(midi_cc(21) * 25) / 12, 0.08)) * pow(1.5, drift)
let loss = 0.012 - 0.01 * midi_cc(22)                      # what it loses, a round

$v = line(period = 1 / note, ends = fixed)
$i = line(period = 1 / note, ends = free)

$v' = -slope($i) - $v * loss
$i' = -slope($v) - $i * loss

let own = phasor(1 / 3) * 3
let hard = min(own, since(midi_trig(36)))
let soft = since(midi_trig(37))
let stroke = if soft < hard then 0.0012 else 0.0004        # how long a blow takes
$v'[0.3] += if min(hard, soft) < stroke then 0.0014 / stroke else 0

[$v[0.13], $i[0.13]] * 0.4 |> tanh
