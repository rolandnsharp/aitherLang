# gaelic_fairy — Irish low whistle showcase with bodhrán backing.
# Stripped from the multi-instrument version to focus expression on
# the whistle. Cello and harp removed — only bodhrán + whistle.
#
# Whistle is hardcoded to D MIXOLYDIAN — the iconic Irish trad scale
# (D, E, F#, G, A, B, C-natural) with the flat 7 that gives Celtic
# tunes their distinctive sound. Every key the player presses snaps
# to a Mixolydian degree, so any combination is in the right key.
#
# ============================================================ SLIDERS
#   S1 (CC 82) — BODHRÁN VOL     Irish frame drum, auto-rhythm
#   S2 (CC 83) — HAND PAN VOL    D-Kurd hand pan, 3-level cascade ladder
#   S3 (CC 85) — HAND PAN 2 VOL  Second hand pan, 4-level rhythm+melody ladder
#   S4 (CC 17) — AITHER VOICE    pure aither-native auto-playing pad,
#                                  4-level ladder of synthesis paradigms
#
# ============================================================ BODHRÁN (K1-K2)
#   K1 (CC 74) — RHYTHM PATTERN  3-zone crossfade:
#                                  K1=0    : slow heartbeat (pulse only)
#                                  K1=0.5  : 6/8 jig
#                                  K1=1    : driving 4/4 reel
#   K2 (CC 71) — DRIVE           clean wood thump → fat saturated boom
#
# ============================================================ HAND PAN 2 (K3)
#   K3 (CC 76) — PAN 2 LADDER    4-level rhythm + melody ladder for the
#                                 second hand pan (S3). Each level has
#                                 its own VELOCITY array AND its own NOTE
#                                 sequence — so going up the ladder
#                                 progresses BOTH the rhythm density AND
#                                 the melodic complexity:
#                                  K3=0     L1  D-A alternation, 2 hits
#                                  K3=0.33  L2  D-F-A triad arpeggio
#                                  K3=0.67  L3  full up/down arp pattern
#                                  K3=1     L4  arp + octave jump (A4 high)
#
# ============================================================ AITHER VOICE (K4)
#   K4 (CC 77) — AITHER LADDER   4-level ladder of aither-native synthesis
#                                  paradigms. The same auto-played D-minor
#                                  pentatonic note progression, but each
#                                  level applies a different aither-only
#                                  technique on top:
#                                  K4=0     L1  WARM ADDITIVE — 6 partials
#                                                with per-partial slow drift
#                                                (the "alive spectrum"
#                                                technique from Tesla/cello)
#                                  K4=0.33  L2  SPECTRAL HALO — same +
#                                                freq_shift output, complex
#                                                algebra coherent
#                                                inharmonicity (no other
#                                                synth can do this in one op)
#                                  K4=0.67  L3  TESLA SWARM — 12 partials
#                                                with per-partial FM, the
#                                                fm_swarm gothic recipe
#                                  K4=1     L4  PHASE FRACTAL — Tesla
#                                                + cmul(analytic, analytic)
#                                                phase-locked octave shimmer
#                                                (complex algebra applied
#                                                to its own analytic signal)
#
# ============================================================ MASTER + DJEMBE
#   K7 (CC 19) — REVERB          combined size + wet (both scale together)
#   K8 (CC 16) — PAN COMPLEXITY  3-zone velocity ladder for the hand pan:
#                                  K8=0    LEVEL 1  meditative — one
#                                                    root D per cycle
#                                  K8=0.5  LEVEL 2  flowing 8-hit cascade
#                                                    ("do do do doo doo")
#                                  K8=1    LEVEL 3  cascade + octave-up
#                                                    sparkle layer on top
#                                  3 zones because the hand pan's long
#                                  sustain blurs finer distinctions —
#                                  3 audibly-different states beats 4
#                                  similar-sounding ones.

let bodhranVol = midi_cc(82)
let panVol     = midi_cc(83)
let pan2Vol    = midi_cc(85)
let aitherVol  = midi_cc(17)     # was whistle vol; now aither voice

let bodPattern = midi_cc(74)
let bodDrive   = midi_cc(71)

let pan2Ladder    = midi_cc(76)
let aitherLadder  = midi_cc(77)  # was whistle vibrato; now aither ladder

# K7 controls reverb size AND wet together (one knob, more space)
let revAmt     = midi_cc(19)
let panComplex = midi_cc(16)

# ===== BODHRÁN — Irish frame drum (kept from previous version) =====
let bodSlow = [1.0, 0,   0,   0,   0,   0,   0.7, 0,   0,   0,   0,   0]
let bodJig  = [1.0, 0,   0.4, 0.5, 0,   0.4, 0.7, 0,   0.4, 0.5, 0,   0.4]
let bodReel = [1.0, 0.4, 0.6, 0.4, 0.7, 0.4, 0.5, 0.4, 0.7, 0.4, 0.6, 0.4]

play bodhran:
  let stepRate = 6.0
  let stepPh   = phasor(stepRate / 12)
  let idx      = int(stepPh * 12)
  let trig     = impulse(stepRate)

  let vSlow = bodSlow[idx]
  let vJig  = bodJig[idx]
  let vReel = bodReel[idx]
  let pwA = max(0, 1 - bodPattern * 2)
  let pwB = (if bodPattern < 0.5 then bodPattern * 2 else 1 - (bodPattern - 0.5) * 2)
  let pwC = max(0, (bodPattern - 0.5) * 2)
  let vel = vSlow * pwA + vJig * pwB + vReel * pwC

  let velTrig = trig * vel

  let pSweep = 50 + discharge(velTrig, 35) * 50
  let boomEnv = discharge(velTrig, 18)
  let boom = sin(TAU * phasor(pSweep)) * boomEnv * 0.7

  let tapEnv = discharge(velTrig, 80) * 0.5
  let tap = (noise() |> hpf(2000, 0.5)) * tapEnv

  let raw = boom + tap
  let driven = drive(raw, 1 + bodDrive * 4)
  let s = driven * bodhranVol * 0.4
  [s, s]

# ===== HAND PAN — 4-level velocity ladder via K8 =====
# Same technique as bodhrán: ONE expressive timbre + per-step velocity
# arrays + paradigm crossfade between levels. The hand pan is the
# right shape for this because (like the bodhrán) it's a single-
# timbre instrument where velocity is the primary expressive
# parameter — soft hits are quiet rings, loud hits are full booms.
#
# A note pattern array picks WHICH tongue per step (D Kurd notes).
# Velocity arrays per level pick HOW HARD each step is struck.
# Level 1 = sparse meditative; Level 4 = busy cascade.
def panTone(trig, fund):
  # PLUCK-enveloped additive (replaces DHO so the sound has finite
  # decay like the bodhrán's discharge — no ring memory means clean
  # mute when velocity drops to zero). Same compound clang mode
  # partial ratio (1 : 2 : 3) so the timbre stays hand-pan-like;
  # only the envelope shape changed.
  let env1 = pluck(trig, 4.0)
  let env2 = pluck(trig, 1.5)
  let env3 = pluck(trig, 0.5)
  let d1   = 1 + 0.0010 * sin(t * 0.71)
  let d2   = 1 + 0.0008 * sin(t * 1.13 + 1.7)
  let d3   = 1 + 0.0012 * sin(t * 1.39 + 2.4)
  let p1   = sin(TAU * phasor(fund * d1))         * env1
  let p2   = sin(TAU * phasor(fund * 1.998 * d2)) * env2 * 0.55
  let p3   = sin(TAU * phasor(fund * 3.0 * d3))   * env3 * 0.40
  p1 + p2 + p3

# 16-step note pattern in D Kurd (D, A, Bb, C, D, E, F, G — Hang scale).
# Same melodic shape every cycle; velocity arrays decide which steps
# actually sound and how strongly.
let panNotes = [146.83, 220.00, 293.66, 220.00, 261.63, 220.00, 293.66, 220.00,
                146.83, 220.00, 233.08, 220.00, 261.63, 220.00, 293.66, 220.00]
                # D3,    A3,    D4,    A3,    C4,    A3,    D4,    A3,
                # D3,    A3,    Bb3,   A3,    C4,    A3,    D4,    A3

# 3 levels — each rhythmically distinct.
# L1 = 4 hits per cycle on the strong beats — clearly rhythmic but sparse
# L2 = the "do do do doo doo" beautiful cascade you loved
# L3 = same as L2 + octave sparkle (added in the play block)
let panVelL1 = [1.0, 0,   0,   0,   0.7, 0,   0,   0,
                1.0, 0,   0,   0,   0.7, 0,   0,   0  ]
let panVelL2 = [1.0, 0.3, 0.6, 0.3, 0.4, 0.3, 0.5, 0.3,
                0.7, 0.3, 0.4, 0.3, 0.5, 0.3, 0.6, 0.3]
let panVelL3 = [1.0, 0.3, 0.6, 0.3, 0.4, 0.3, 0.5, 0.3,
                0.7, 0.3, 0.4, 0.3, 0.5, 0.3, 0.6, 0.3]

# Sparkle layer velocities — ONLY active in L3 zone. Hits the
# octave-UP version of the current note on the strong-beat steps.
let panSparkleVel = [0.6, 0,   0.5, 0,   0,   0,   0.4, 0,
                     0.5, 0,   0,   0,   0.4, 0,   0.5, 0  ]

play handpan:
  # COPY OF THE BODHRÁN PATTERN, exact structure:
  # - 3 velocity arrays
  # - triangular 3-zone crossfade (slope 2)
  # - ONE shared velocity = weighted sum
  # - velTrig = trig * vel
  # - ONE voice fed velTrig
  # The voice (panTone) now uses pluck envelopes (not DHO), so when
  # vel drops to 0 the envelope dies in ~4 seconds and the sound
  # actually stops — no ring memory, no bleed across zones.
  let stepRate = 4.0
  let stepPh   = phasor(stepRate / 16)
  let idx      = int(stepPh * 16)
  let trig     = impulse(stepRate)
  let activeNote = panNotes[idx]

  let pwA = max(0, 1 - panComplex * 2)
  let pwB = (if panComplex < 0.5 then panComplex * 2
             else 1 - (panComplex - 0.5) * 2)
  let pwC = max(0, (panComplex - 0.5) * 2)
  let vel = panVelL1[idx] * pwA + panVelL2[idx] * pwB + panVelL3[idx] * pwC

  let velTrig = trig * vel

  # Sample-and-hold the fund on each hit (otherwise the sine slides
  # through panNotes during the envelope decay).
  $heldFund = 146.83
  $heldFund = if velTrig > 0.001 then activeNote else $heldFund
  let voice = panTone(velTrig, $heldFund)

  # SPARKLE LAYER — only active in L3 zone (gated by pwC weight).
  # Octave-up version of the current note plays the sparkle pattern
  # ON TOP of the main voice. This is the "extra" that makes L3
  # audibly different from L2 (which has identical velocity).
  let sparkleVelRaw = panSparkleVel[idx] * pwC
  let sparkleTrig = trig * sparkleVelRaw
  $sparkleHeld = 293.66
  $sparkleHeld = if sparkleTrig > 0.001 then activeNote * 2 else $sparkleHeld
  let sparkleVoice = panTone(sparkleTrig, $sparkleHeld)

  let s = (voice + sparkleVoice * 0.6) * panVol * 0.4
  [s, s]

# ===== HAND PAN 2 — 4-level rhythm + melody ladder via K3 =====
# Each level has its OWN velocity array AND its OWN note sequence.
# Going up the ladder progresses both rhythmic density and melodic
# complexity. Uses 4 separate panTone instances (one per level) with
# trigger-gating (so non-active voices NEVER receive force) AND
# per-voice sample-and-hold (so each level's notes don't slide
# during the envelope decay — the lesson from the previous bug).
#
# 8-step cycle at 4 Hz (= 2-second cycle, twice as fast as pan 1
# for polyrhythmic interplay).
let pan2NotesL1 = [146.83, 146.83, 146.83, 146.83, 220.00, 220.00, 220.00, 220.00]
let pan2NotesL2 = [146.83, 174.61, 220.00, 174.61, 146.83, 174.61, 220.00, 174.61]
let pan2NotesL3 = [146.83, 174.61, 220.00, 261.63, 293.66, 261.63, 220.00, 174.61]
let pan2NotesL4 = [146.83, 174.61, 220.00, 261.63, 293.66, 440.00, 261.63, 174.61]

let pan2VelL1 = [1.0, 0,   0,   0,   0.8, 0,   0,   0  ]
let pan2VelL2 = [1.0, 0,   0.7, 0,   0.8, 0,   0.7, 0  ]
let pan2VelL3 = [1.0, 0.5, 0.7, 0.5, 0.8, 0.5, 0.7, 0.5]
let pan2VelL4 = [1.0, 0.6, 0.8, 0.7, 0.9, 0.8, 0.7, 0.6]

play handpan2:
  let stepRate = 4.0
  let stepPh   = phasor(stepRate / 8)
  let idx      = int(stepPh * 8)
  let trig     = impulse(stepRate)

  # 4-zone crossfade weights (slope 3 = triangle width 2/3)
  let p2w1 = max(0, 1 - pan2Ladder * 3)
  let p2w2 = max(0, 1 - abs(pan2Ladder - 0.333) * 3)
  let p2w3 = max(0, 1 - abs(pan2Ladder - 0.667) * 3)
  let p2w4 = max(0, 1 - abs(pan2Ladder - 1.000) * 3)

  # Per-voice TRIGGER GATING (multiplied by both vel AND weight)
  # AND per-voice SAMPLE-AND-HOLD on the fund.
  let t1 = trig * pan2VelL1[idx] * p2w1
  $h1 = 146.83
  $h1 = if t1 > 0.001 then pan2NotesL1[idx] else $h1
  let v1 = panTone(t1, $h1)

  let t2 = trig * pan2VelL2[idx] * p2w2
  $h2 = 146.83
  $h2 = if t2 > 0.001 then pan2NotesL2[idx] else $h2
  let v2 = panTone(t2, $h2)

  let t3 = trig * pan2VelL3[idx] * p2w3
  $h3 = 146.83
  $h3 = if t3 > 0.001 then pan2NotesL3[idx] else $h3
  let v3 = panTone(t3, $h3)

  let t4 = trig * pan2VelL4[idx] * p2w4
  $h4 = 146.83
  $h4 = if t4 > 0.001 then pan2NotesL4[idx] else $h4
  let v4 = panTone(t4, $h4)

  let s = (v1 + v2 + v3 + v4) * pan2Vol * 0.4
  [s, s]

# ===== IRISH LOW WHISTLE — hardcoded D MIXOLYDIAN, punchy attack =====
# D Mixolydian = D E F# G A B C — D Major with flat 7. The "Celtic"
# scale that distinguishes Irish trad from generic major-key folk.
# Every white-or-black key snaps to a Mixolydian tone.
#
# Three tone paradigms (mellow / normal / strident) crossfaded by K5
# give the whistle a real character range — not just a brightness EQ.
# ===== AITHER VOICE — Tesla-organ FM swarm with cumulative layers =====
# Tonally distinct from the hand pans (which are additive bell-clang).
# This uses the gothic fm_swarm recipe — per-partial FM with mod_ratio
# 3.06 — for sidebanded, organ-like, dark spectrum. Plus cumulative
# aither-native processing layers (freq_shift, analytic-square) that
# only complex algebra can do.
#
# Step grid: 4 Hz, 16-step cycle (locks with pan 1).
# Melody is a real 16-step D dorian phrase (not a chord-tone cycle):
# rhythmic variation including rests, dynamic accents, melodic shape.

# 16-step D dorian phrase with rhythmic variation
let teNotes = [146.83, 146.83, 174.61, 174.61, 220.00, 261.63, 261.63, 220.00,
               293.66, 293.66, 261.63, 220.00, 220.00, 174.61, 174.61, 146.83]
               # D3,    D3,    F3,    F3,    A3,    C4,    C4,    A3,
               # D4,    D4,    C4,    A3,    A3,    F3,    F3,    D3
               # ascending phrase → turning → descending cadence
let teVels  = [1.0,    0,      0.6,    0.7,    0.9,    0.6,    0,      0.7,
               1.0,    0,      0.7,    0,      0.6,    0.7,    0,      0.5]
               # rests at 1, 6, 9, 11, 14 — gives the phrase breath

# Tesla FM def (the fm_swarm recipe per note)
def teslaFM(fund, env):
  let voice = sum(10, n =>
    let drift = 1 + 0.006 * sin(t * n / 11 + n * 0.3)
    let cf   = n * fund * drift
    let modf = cf * 3.06
    let mv   = sin(TAU * phasor(modf)) * 1.17
    if cf + modf * 3 >= 22000 then 0
    else (1.0 / pow(n, 0.55)) * sin(TAU * phasor(cf) + mv))
  voice * env

play aitherVoice:
  # Cumulative weights — w1 always 1, others fade in
  let w1 = 1.0
  let w2 = clamp(aitherLadder * 3,           0, 1)
  let w3 = clamp((aitherLadder - 0.33) * 3,  0, 1)
  let w4 = clamp((aitherLadder - 0.67) * 3,  0, 1)

  let stepRate = 4.0
  let stepPh   = phasor(stepRate / 16)
  let idx      = int(stepPh * 16)
  let trig     = impulse(stepRate)

  # L1 — TESLA DRONE BASE: low D2 sustained gothic-organ drone.
  # The fm_swarm recipe at sub-audio "always-on" — continuous
  # sidebanded organ pad. Slow breath swell for life.
  let breath = (sin(TAU * t * 0.07) + 1) * 0.5
  let droneEnv = 0.3 + breath * 0.7
  let l1raw = teslaFM(73.42, droneEnv)
  let l1 = l1raw * 0.04

  # L2 — TESLA MELODY: same Tesla-organ recipe playing the 16-step
  # D dorian phrase. With sample-and-hold so the rung note stays
  # at its struck pitch through the envelope decay.
  let l2Vel = teVels[idx]
  let l2TrigVel = trig * l2Vel
  $l2Held = 146.83
  $l2Held = if l2TrigVel > 0.001 then teNotes[idx] else $l2Held
  let l2Env = pluck(l2TrigVel, 0.6)
  let l2 = teslaFM($l2Held, l2Env) * 0.06

  # L3 — SPECTRAL HALO: freq_shift L1+L2 by +37 Hz, producing
  # coherent inharmonicity. Every harmonic shifts by the same Hz
  # offset — the Tesla swarm gains a metallic organ-bell quality.
  # ONLY aither's complex-algebra primitives can do this in one op.
  let baseSig = l1 + l2
  let l3 = freq_shift(baseSig, 37) * 0.9

  # L4 — PHASE FRACTAL: take the analytic signal of the layered
  # output, square it via cmul. Squaring an analytic signal doubles
  # its phase angle = mathematically locked octave-up that tracks
  # the source's phase exactly. Pure aither move.
  let pair = analytic(baseSig)
  let sq = cmul(pair[0], pair[1], pair[0], pair[1])
  let l4 = sq[0] * 0.4

  # Cumulative additive layering
  let out = l1 * w1 + l2 * w2 + l3 * w3 + l4 * w4
  let s = out * aitherVol
  [s, s]

# ===== MASTER =====
let dry  = bodhran + handpan + handpan2 + aitherVoice
let mono = (dry[0] + dry[1]) * 0.5
# K7 controls reverb size + wet together — single knob morphs from
# intimate room (size 1.5, wet 0.0) to stone hall (size 6.5, wet 0.6)
let wet  = mono |> reverb(1.5 + revAmt * 5.0, 0.5)
([dry[0], dry[1]] + [wet, wet] * revAmt * 0.6) * 0.6
