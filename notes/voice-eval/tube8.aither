def tube8(src, noiz, place, a1, a2, a3, a4, a5, a6, a7, a8, tlen):
  # tlen: the tract scale (1 = 17 cm). One region is 1/8 of it.
  let rt = max(0.00002, 2.125 / 35000 * tlen - dt)
  $f1 = 0.0
  $b1 = 0.0
  $f2 = 0.0
  $b2 = 0.0
  $f3 = 0.0
  $b3 = 0.0
  $f4 = 0.0
  $b4 = 0.0
  $f5 = 0.0
  $b5 = 0.0
  $f6 = 0.0
  $b6 = 0.0
  $f7 = 0.0
  $b7 = 0.0
  $f8 = 0.0
  $b8 = 0.0
  let fo1 = delay($f1, rt, 0.001) * 0.9985
  let bo1 = delay($b1, rt, 0.001) * 0.9985
  let fo2 = delay($f2, rt, 0.001) * 0.9985
  let bo2 = delay($b2, rt, 0.001) * 0.9985
  let fo3 = delay($f3, rt, 0.001) * 0.9985
  let bo3 = delay($b3, rt, 0.001) * 0.9985
  let fo4 = delay($f4, rt, 0.001) * 0.9985
  let bo4 = delay($b4, rt, 0.001) * 0.9985
  let fo5 = delay($f5, rt, 0.001) * 0.9985
  let bo5 = delay($b5, rt, 0.001) * 0.9985
  let fo6 = delay($f6, rt, 0.001) * 0.9985
  let bo6 = delay($b6, rt, 0.001) * 0.9985
  let fo7 = delay($f7, rt, 0.001) * 0.9985
  let bo7 = delay($b7, rt, 0.001) * 0.9985
  let fo8 = delay($f8, rt, 0.001) * 0.9985
  let bo8 = delay($b8, rt, 0.001) * 0.9985
  let k1 = (a1 - a2) / (a1 + a2)
  let k2 = (a2 - a3) / (a2 + a3)
  let k3 = (a3 - a4) / (a3 + a4)
  let k4 = (a4 - a5) / (a4 + a5)
  let k5 = (a5 - a6) / (a5 + a6)
  let k6 = (a6 - a7) / (a6 + a7)
  let k7 = (a7 - a8) / (a7 + a8)
  # frication enters at the narrowest place (1..8), shaped by the tube in front of it
  let n1 = noiz * exp(-(place - 1.5) * (place - 1.5) * 2)
  let n2 = noiz * exp(-(place - 2.5) * (place - 2.5) * 2)
  let n3 = noiz * exp(-(place - 3.5) * (place - 3.5) * 2)
  let n4 = noiz * exp(-(place - 4.5) * (place - 4.5) * 2)
  let n5 = noiz * exp(-(place - 5.5) * (place - 5.5) * 2)
  let n6 = noiz * exp(-(place - 6.5) * (place - 6.5) * 2)
  let n7 = noiz * exp(-(place - 7.5) * (place - 7.5) * 2)
  $f1 = src + 0.75 * bo1
  $f2 = (1 + k1) * fo1 - k1 * bo2 + n1
  $b1 = k1 * fo1 + (1 - k1) * bo2
  $f3 = (1 + k2) * fo2 - k2 * bo3 + n2
  $b2 = k2 * fo2 + (1 - k2) * bo3
  $f4 = (1 + k3) * fo3 - k3 * bo4 + n3
  $b3 = k3 * fo3 + (1 - k3) * bo4
  $f5 = (1 + k4) * fo4 - k4 * bo5 + n4
  $b4 = k4 * fo4 + (1 - k4) * bo5
  $f6 = (1 + k5) * fo5 - k5 * bo6 + n5
  $b5 = k5 * fo5 + (1 - k5) * bo6
  $f7 = (1 + k6) * fo6 - k6 * bo7 + n6
  $b6 = k6 * fo6 + (1 - k6) * bo7
  $f8 = (1 + k7) * fo7 - k7 * bo8 + n7
  $b7 = k7 * fo7 + (1 - k7) * bo8
  let lipR = lp1(fo8, 5000)
  $b8 = -0.85 * lipR
  let out = fo8 - 0.85 * lipR
  out - prev(out)
