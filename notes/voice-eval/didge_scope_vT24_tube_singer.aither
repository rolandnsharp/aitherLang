# Klatt's resonator: unity gain at DC, a peak at f of width bw.
def kres(x, f, bw):
  $ky1 = 0.0
  $ky2 = 0.0
  let kc = -exp(-TAU * bw * dt)
  let kb = 2 * exp(-PI * bw * dt) * cos(TAU * f * dt)
  let ky = (1 - kb - kc) * x + kb * $ky1 + kc * $ky2
  $ky2 = $ky1
  $ky1 = ky
  ky

let songBar = bars mod 32
let li      = int(songBar / 4)
let inLine  = if (songBar mod 4) < 3 then 1 else 0
let tl      = ((songBar mod 4) + barPh) * (4 * 60 / 108)
let vHz     = slew(73.42 * pow(2, lyrN[li * 96 + min(int(((songBar mod 4) + barPh) * 32), 95)] / 12), 0.04)
let vVib    = 1 + 0.009 * sin(TAU * phasor(5.3)) * ease((tl mod 0.55) / 0.3)
let vDuck   = slew(inLine, 0.25)
# The singer's knobs: who is singing.
let vTract  = 1.0                                   # (tube24 is 24 one-sample sections: length knob to come)
let vRegister = 1.0                                 # pitch multiplier (2 = up an octave)
let vBreath = 0.06                                  # breath noise in the voice
let vPress  = 0.6                                   # open quotient: 0.4 pressed/buzzy .. 0.7 soft
let vVibD   = 1.0                                   # vibrato depth
let vRobot  = 0.0                                   # 0 vocal folds .. 1 a saw (the vocoder robot), same tube
let slot    = min(int(((songBar mod 4) + barPh) * 32), 95)
let slotPh  = (barPh * 32) mod 1
let idx     = li * 96 + slot
let ph      = if inLine > 0 then lyr[idx] else 0
let vv      = if inLine > 0 then lyrV[idx] else 11
let runPos  = if inLine > 0 then (lyrQ[idx] + slotPh) / lyrL[idx] else 0.5
let toEnd   = if vv == ph then runPos else 0
let stp     = pST[ph]
let lastS   = if lyrQ[idx] == lyrL[idx] - 1 then 1 else 0
let rel     = if stp > 0 and lastS > 0 and slotPh >= 0.6 then 1 else 0
let clos    = if stp > 0 and rel < 1 then 1 else 0
let isUnv   = if stp == 1 or stp == 3 then 1 else 0
let relT    = if stp > 0 and lastS > 0 and slotPh >= 0.6 and prev(slotPh) < 0.6 then 1 else 0
let burstE  = discharge(relT, 120)
let aspE    = discharge(relT * isUnv, 16)
let avT     = (if stp > 0 then (if stp == 2 or stp == 4 then (if clos > 0 then 0.15 else 0.7) else 0) else pAV[ph]) * (1 - min(1, aspE * 1.6))
let afT     = pAF[ph] + burstE * (if isUnv > 0 then 0.9 else 0.75) + (if stp >= 3 and rel > 0 then 0.55 else 0)
let ahT     = pAH[ph] + aspE * 0.7
let vAV     = slew(avT, 0.012)
let vAF     = slew(afT, 0.005)
let vAH     = slew(ahT, 0.004)
# the vowel shape the tongue is heading for, gliding
let a1v     = slew(va1[vv] + (ve1[vv] - va1[vv]) * toEnd, 0.045)
let a2v     = slew(va2[vv] + (ve2[vv] - va2[vv]) * toEnd, 0.045)
let a3v     = slew(va3[vv] + (ve3[vv] - va3[vv]) * toEnd, 0.045)
let a4v     = slew(va4[vv] + (ve4[vv] - va4[vv]) * toEnd, 0.045)
let a5v     = slew(va5[vv] + (ve5[vv] - va5[vv]) * toEnd, 0.045)
let a6v     = slew(va6[vv] + (ve6[vv] - va6[vv]) * toEnd, 0.045)
let a7v     = slew(va7[vv] + (ve7[vv] - va7[vv]) * toEnd, 0.045)
let a8v     = slew(va8[vv] + (ve8[vv] - va8[vv]) * toEnd, 0.045)
# the consonant gesture on top of it
let gDT     = if stp >= 3 and rel > 0 then 0.93 else gDg[ph] * (if rel > 0 then 0 else 1)
let gD      = slew(gDT, 0.012)
let gP      = slew(if gDg[ph] > 0 then gPl[ph] else 5, 0.01)
let gV      = slew(gVl[ph], 0.02)
let gD2     = slew(gDg2[ph], 0.015)
let gP2     = slew(gPl2[ph], 0.01)
# the vocal folds (or the robot's saw)
let fHz     = vHz * vRegister * (1 + (vVib - 1) * vVibD)
let gph     = phasor(fHz)
let gt      = gph / vPress
let flow    = if gph < vPress then gt * gt * (1 - gt) * 6.75 else 0
let folds   = flow * (1 - vRobot) + (gph * 2 - 1) * 0.5 * vRobot
let vOn     = slew(inLine, 0.03)
let vG      = slew(vGain[vv], 0.04)

play didge:
  let d3 = didge3(press * 1.6, vVoice, (90 + vToot * 110) * 71.6 / 110, 71.6, 300 + vWah * 480, 950 + vTap * 1500 + vCroak * 600, 1.5, 0.4, 0.8)
  let d1 = didge_bore(press * (1 + vVoice), 60, 0.1, 73.4)
  let d = d3 * cos(blend * PI / 2) + d1 * 1.26 * sin(blend * PI / 2)
  let tract = formant(d, 320 + vWah * 420 - vTap * 60, 0.93) + formant(d, 850 + vWah * 350 + vTap * 1100, 0.94) * 0.7 + formant(d, 2300 + vWah * 300 + vTap * 500, 0.95) * 0.35
  (((tract * 0.9 + d * 0.35) |> drive(1.4)) |> hpf(200, 0.29) |> hpf(200, 0.29) |> lpf(7000, 0.2)) * (1 - 0.68 * vDuck)

# ---------------------------------------------------------- stick rhythms
# The sticks pick their own style every 4 bars (independent of the
# didge's routine), swing by a different amount each block, roll into the
# 4th bar, flam the block's downbeat, and ghost more as a 16-bar arc rises.
let ph32   = (barPh * 32) mod 1
let trig32 = if ph32 < prev(ph32) then 1 else 0
let ph12   = (barPh * 12) mod 1
let trig12 = if ph12 < prev(ph12) then 1 else 0
let t12    = int(barPh * 12)
let hb1    = (sin(blk * 12.9898) * 43758.5453) mod 1
let hb2    = (sin(blk * 78.233 + 1.3) * 12543.871) mod 1
let hb3    = (sin(blk * 39.425 + 2.7) * 23421.631) mod 1
let sMode  = int(((sin((blk + 7) * 31.7) * 15731.3) mod 1) * 6)
let fillBar = if (bars mod 4) == 3 then 1 else 0
let arc    = (sin(TAU * bars / 16) + 1) * 0.5
let sw     = 0.08 + 0.14 * hb3                                  # swing: the off-16th lands late
let trigSw = if (stepIx mod 2) == 1 then (if stepPh >= sw and prev(stepPh) < sw then 1 else 0) else trig16
# Each 16th gets its own strength and its own spot on the stick.
let hN    = (bars * 16 + stepIx) * 1.0
let hVel  = (sin(hN * 12.9898) * 43758.5453) mod 1
let hPos  = (sin(hN * 78.233) * 12543.871) mod 1
let hPos2 = (sin(hN * 39.425) * 23421.631) mod 1
let ghost = if hVel > 0.75 - 0.4 * arc then 0.13 + 0.08 * hPos else 0
let kE    = 5 + int(hb1 * 5)
let iE    = (stepIx + int(hb2 * 16)) mod 16
let euc   = if ((iE * kE) mod 16) < kE then 1 else 0
let pClave  = [1, 0, 0, 0.8, 0, 0, 0.9, 0, 0, 0, 0.8, 0, 1, 0, 0, 0]
let pGallop = [1, 0, 0.5, 0.6, 0.9, 0, 0.5, 0.6, 1, 0, 0.5, 0.6, 0.9, 0, 0.6, 0.7]
let pHeart  = [1, 0, 0, 0.55, 0, 0, 0, 0, 0.8, 0, 0, 0.5, 0, 0, 0, 0]
let acc   = if sub == 0 then 0.15 else 0
let v16raw = if sMode == 0 then (if euc > 0 then 0.7 + acc else ghost) else if sMode == 1 then 0 else if sMode == 2 then (if vPat == 0 then 0.55 + acc else ghost) else if sMode == 3 then pGallop[stepIx] * 0.7 else if sMode == 4 then max(pClave[stepIx] * 0.9, ghost) else max(pHeart[stepIx], ghost * 0.5)
let rollOn = fillBar * (if barPh >= 0.75 then 1 else 0)
let v16   = v16raw * (0.8 + 0.35 * hVel) * (1 - rollOn)
let v12   = if sMode == 1 then (if (t12 mod 2) == 0 then 0.6 else 0.22) * (0.85 + 0.3 * hPos) else 0
let vRoll = rollOn * (0.15 + 0.65 * (barPh - 0.75) * 4) * (0.85 + 0.3 * hPos2)
let flamT = if (bars mod 4) == 0 and stepIx == 0 and stepPh >= 0.16 and prev(stepPh) < 0.16 then 1 else 0
play sticks:
  let f   = contact(trigSw * v16, 0.0001 * pow(max(v16, 0.05), -0.2)) * v16 + contact(trig12 * v12, 0.0001 * pow(max(v12, 0.05), -0.2)) * v12 + contact(trig32 * vRoll, 0.0001 * pow(max(vRoll, 0.05), -0.2)) * vRoll + contact(flamT, 0.00011) * 0.5
  let sA  = bar(f, 1650, 0.14, 0.25 + 0.6 * hPos, 0.1 + 0.4 * hPos2)
  let sB  = bar(f, 1750, 0.14 * 0.8, 0.9 - 0.6 * hPos, 0.5 - 0.4 * hPos2)
  (sA + sB * 0.85) * 0.85 |> lpf(7000, 0.2)

play voice:
  let turb = lp1(noise(), 8065.7)                           # turbulence: rolling off above ~8 kHz
  let src  = folds * vAV + turb * (vAH * 0.02 + vBreath * vAV * flow * 0.1)
  let oral = tube24(src * vG, turb * vAF * 0.006, gP, gD, gP2, gD2, a1v, a2v, a3v, a4v, a5v, a6v, a7v, a8v)
  let nose = kres(kres(src * gV, 280 / vTract, 90), 1100 / vTract, 250)
  ((oral + (nose - prev(nose)) * 0.15) * vOn * 2.0) |> hpf(150, 0.29) |> lpf(7000, 0.2)

# ------------------------------------------------------------------ scope
# The beam (AITHER_SCOPE=1 streams it as X, Y, Z beside the mix): a phase
# portrait of the didge, the signal against itself a quarter of a drone
# period later, turning slowly. The beam is time-shared: 3/4 of every
# 1/180 s draws the portrait, 1/4 a ring that every stick hit flashes
# and opens out, blanked across the jumps. Every 64 s it unrolls into a
# time trace (x a sweep at half the drone) and rolls back up.
let dm     = lp1(lp1(mono(didge), 104.16), 104.16)             # the drone's first harmonics, no breath
let dEnv   = lp1(abs(dm), 0.23874)
let dn     = clamp(dm / (dEnv * 3.4 + 0.006), -1, 1)
let dq     = delay(dn, 0.25 / 73.4, 0.05)
let rot    = TAU * t / 41
let pxr    = dn * cos(rot) - dq * sin(rot)
let pyr    = dn * sin(rot) + dq * cos(rot)
let unroll = ease((sin(TAU * t / 64) + 1) * 0.5 * 1.6 - 0.3)
let sweepX = phasor(73.4 / 2) * 2 - 1
let hitEnv = discharge(trigSw * v16 + trig12 * v12 + trig32 * vRoll, 7)
let ringR  = 0.2 + (1 - hitEnv) * 0.8
let mux    = phasor(180)
let onRing = if mux > 0.75 then 1 else 0
let blank  = if abs(mux - 0.75) < 0.006 or mux < 0.006 or mux > 0.994 then 0 else 1
let ringA  = TAU * (mux - 0.75) * 4
# Scene 1: a (p, q) torus knot turning in 3D. Drawn twice per drone
# cycle, so the tube's ripple (the didge's waveform) stands still on it.
$v1start = t
let v1     = ease((t - $v1start) / 3)
let pK     = [2, 3, 2, 3, 5, 3]
let qK     = [3, 5, 5, 4, 2, 7]
let kp     = pK[sMode]
let kq     = qK[sMode]
let th     = TAU * phasor(73.4 / 2)
let tube   = 0.2 + 0.09 * dn
let ringK  = 0.55 + tube * cos(kq * th)
let x3     = ringK * cos(kp * th)
let y3     = ringK * sin(kp * th)
let z3     = tube * sin(kq * th)
let ra     = TAU * t / 13
let rb     = TAU * t / 17
let xr     = x3 * cos(ra) + z3 * sin(ra)
let zr     = z3 * cos(ra) - x3 * sin(ra)
let yr     = y3 * cos(rb) - zr * sin(rb)
let zd     = y3 * sin(rb) + zr * cos(rb)
let persp  = 2.5 / (2.6 - zd) * (1 + 0.1 * hitEnv)
let kx     = xr * persp
let ky     = yr * persp
let kz     = (0.35 + 0.65 * (zd + 0.8) / 1.6) * (0.75 + 0.6 * hitEnv)

# Scene 2: a Julia set by inverse iteration (z -> +-sqrt(z - c), a
# random sign each step, which pulls every point onto the set), drawn as
# blanked dots 12000 times a second; beside it the Mandelbrot set's main
# cardioid and period-2 disc, with c marked. c tours just inside the
# cardioid's edge, and the didge breathes it in and out.
$v2start = t
let v2     = ease((t - $v2start) / 3)
let thc    = TAU * t / 47
let pull   = 0.955 + 0.04 * lp1(dn, 6.3689)
let cr     = (cos(thc) / 2 - cos(2 * thc) / 4) * pull
let ci     = (sin(thc) / 2 - sin(2 * thc) / 4) * pull
let jph    = phasor(12000)
let jtrig  = if jph < prev(jph) then 1 else 0
let jsub   = int(jph * 4)
$jr = 0.0
$ji = 0.0
let wr     = $jr - cr
let wi     = $ji - ci
let wm     = sqrt(wr * wr + wi * wi)
let sqr    = sqrt(max(0, (wm + wr) / 2))
let sqi    = (if wi >= 0 then 1 else -1) * sqrt(max(0, (wm - wr) / 2))
let jsgn   = if noise() > 0 then 1 else -1
$jr = if jtrig > 0 then sqr * jsgn else $jr
$ji = if jtrig > 0 then sqi * jsgn else $ji
let mux2   = phasor(50)
let mu     = mux2 / 0.3
let cardA  = TAU * mu / 0.7
let discA  = TAU * (mu - 0.7) / 0.25
let mcx    = if mu < 0.7 then cos(cardA) / 2 - cos(2 * cardA) / 4 else if mu < 0.95 then -1 + 0.25 * cos(discA) else cr
let mcy    = if mu < 0.7 then sin(cardA) / 2 - sin(2 * cardA) / 4 else if mu < 0.95 then 0.25 * sin(discA) else ci
let edge   = abs(mu - 0.7) < 0.01 or abs(mu - 0.95) < 0.01 or mux2 < 0.004 or abs(mux2 - 0.3) < 0.006 or mux2 > 0.996
let fx     = if mux2 < 0.3 then -0.62 + (mcx + 0.75) * 0.2 else 0.42 + $jr * 0.31
let fy     = if mux2 < 0.3 then mcy * 0.36 else $ji * 0.55
let fz     = if edge then 0 else if mux2 < 0.3 then (if mu >= 0.95 then 1.6 else 0.35) else (if jsub == 1 or jsub == 2 then 1 else 0) * (0.8 + 0.5 * hitEnv)

# Scene 3: the didge's waveform wrapped round a ring (two drone cycles
# per turn, so it stands still), swelling on stick hits: ink for the
# paint layer's feedback.
$v3start = t
let v3     = ease((t - $v3start) / 3)
let wth    = TAU * phasor(73.4 / 2)
let wrad   = 0.42 + 0.22 * dn + 0.1 * hitEnv
let wx     = wrad * cos(wth) * 0.5625
let wy     = wrad * sin(wth)

play scope:
  let sx = pxr * 0.9 * (1 - unroll) + sweepX * unroll
  let sy = pyr * 0.85 * (1 - unroll) + dn * 0.7 * unroll
  let ox = if onRing > 0 then ringR * cos(ringA) else sx
  let oy = if onRing > 0 then ringR * sin(ringA) else sy
  let k1x = ox * (1 - v1) + kx * v1
  let k1y = oy * (1 - v1) + ky * v1
  let f2x = k1x * (1 - v2) + fx * v2
  let f2y = k1y * (1 - v2) + fy * v2
  [f2x * (1 - v3) + wx * v3, f2y * (1 - v3) + wy * v3]
play beam:
  let ob = blank * (if onRing > 0 then hitEnv * 1.5 else 0.8)
  let f2z = (ob * (1 - v1) + kz * v1) * (1 - v2) + fz * v2
  f2z * (1 - v3) + (0.9 + 0.4 * hitEnv) * v3

let roomD = reverb(mono(didge), 1.3, 0.1)
let roomS = reverb(mono(sticks), 0.6, 0.06)
mono(voice)
