def trombone(glot, turb, relT, place, deg, place2, deg2, velum, p1, p2, p3, p4, p5, p6, p7, p8):
  # the shape: control points -> 44 diameters (Pink Trombone units, ~0.75 sqrt(cm^2))
  let a0 = max(0.0004, p1 * (1 - deg * exp(-(1.0000 - place) * (1.0000 - place) * 3)) * (1 - deg2 * exp(-(1.0000 - place2) * (1.0000 - place2) * 3)) * 0.5625)
  let a1 = max(0.0004, (p1 * 0.6957 + p2 * 0.3043) * (1 - deg * exp(-(1.3043 - place) * (1.3043 - place) * 3)) * (1 - deg2 * exp(-(1.3043 - place2) * (1.3043 - place2) * 3)) * 0.5625)
  let a2 = max(0.0004, (p1 * 0.3913 + p2 * 0.6087) * (1 - deg * exp(-(1.6087 - place) * (1.6087 - place) * 3)) * (1 - deg2 * exp(-(1.6087 - place2) * (1.6087 - place2) * 3)) * 0.5625)
  let a3 = max(0.0004, (p1 * 0.0870 + p2 * 0.9130) * (1 - deg * exp(-(1.9130 - place) * (1.9130 - place) * 3)) * (1 - deg2 * exp(-(1.9130 - place2) * (1.9130 - place2) * 3)) * 0.5625)
  let a4 = max(0.0004, (p2 * 0.7826 + p3 * 0.2174) * (1 - deg * exp(-(2.2174 - place) * (2.2174 - place) * 3)) * (1 - deg2 * exp(-(2.2174 - place2) * (2.2174 - place2) * 3)) * 0.5625)
  let a5 = max(0.0004, (p2 * 0.4783 + p3 * 0.5217) * (1 - deg * exp(-(2.5217 - place) * (2.5217 - place) * 3)) * (1 - deg2 * exp(-(2.5217 - place2) * (2.5217 - place2) * 3)) * 0.5625)
  let a6 = max(0.0004, (p2 * 0.1739 + p3 * 0.8261) * (1 - deg * exp(-(2.8261 - place) * (2.8261 - place) * 3)) * (1 - deg2 * exp(-(2.8261 - place2) * (2.8261 - place2) * 3)) * 0.5625)
  let a7 = max(0.0004, (p3 * 0.8696 + p4 * 0.1304) * (1 - deg * exp(-(3.1304 - place) * (3.1304 - place) * 3)) * (1 - deg2 * exp(-(3.1304 - place2) * (3.1304 - place2) * 3)) * 0.5625)
  let a8 = max(0.0004, (p3 * 0.5652 + p4 * 0.4348) * (1 - deg * exp(-(3.4348 - place) * (3.4348 - place) * 3)) * (1 - deg2 * exp(-(3.4348 - place2) * (3.4348 - place2) * 3)) * 0.5625)
  let a9 = max(0.0004, (p3 * 0.2609 + p4 * 0.7391) * (1 - deg * exp(-(3.7391 - place) * (3.7391 - place) * 3)) * (1 - deg2 * exp(-(3.7391 - place2) * (3.7391 - place2) * 3)) * 0.5625)
  let a10 = max(0.0004, (p4 * 0.9565 + p5 * 0.0435) * (1 - deg * exp(-(4.0435 - place) * (4.0435 - place) * 3)) * (1 - deg2 * exp(-(4.0435 - place2) * (4.0435 - place2) * 3)) * 0.5625)
  let a11 = max(0.0004, (p4 * 0.6522 + p5 * 0.3478) * (1 - deg * exp(-(4.3478 - place) * (4.3478 - place) * 3)) * (1 - deg2 * exp(-(4.3478 - place2) * (4.3478 - place2) * 3)) * 0.5625)
  let a12 = max(0.0004, (p4 * 0.3478 + p5 * 0.6522) * (1 - deg * exp(-(4.6522 - place) * (4.6522 - place) * 3)) * (1 - deg2 * exp(-(4.6522 - place2) * (4.6522 - place2) * 3)) * 0.5625)
  let a13 = max(0.0004, (p4 * 0.0435 + p5 * 0.9565) * (1 - deg * exp(-(4.9565 - place) * (4.9565 - place) * 3)) * (1 - deg2 * exp(-(4.9565 - place2) * (4.9565 - place2) * 3)) * 0.5625)
  let a14 = max(0.0004, (p5 * 0.7391 + p6 * 0.2609) * (1 - deg * exp(-(5.2609 - place) * (5.2609 - place) * 3)) * (1 - deg2 * exp(-(5.2609 - place2) * (5.2609 - place2) * 3)) * 0.5625)
  let a15 = max(0.0004, (p5 * 0.4348 + p6 * 0.5652) * (1 - deg * exp(-(5.5652 - place) * (5.5652 - place) * 3)) * (1 - deg2 * exp(-(5.5652 - place2) * (5.5652 - place2) * 3)) * 0.5625)
  let a16 = max(0.0004, (p5 * 0.1304 + p6 * 0.8696) * (1 - deg * exp(-(5.8696 - place) * (5.8696 - place) * 3)) * (1 - deg2 * exp(-(5.8696 - place2) * (5.8696 - place2) * 3)) * 0.5625)
  let a17 = max(0.0004, (p6 * 0.8261 + p7 * 0.1739) * (1 - deg * exp(-(6.1739 - place) * (6.1739 - place) * 3)) * (1 - deg2 * exp(-(6.1739 - place2) * (6.1739 - place2) * 3)) * 0.5625)
  let a18 = max(0.0004, (p6 * 0.5217 + p7 * 0.4783) * (1 - deg * exp(-(6.4783 - place) * (6.4783 - place) * 3)) * (1 - deg2 * exp(-(6.4783 - place2) * (6.4783 - place2) * 3)) * 0.5625)
  let a19 = max(0.0004, (p6 * 0.2174 + p7 * 0.7826) * (1 - deg * exp(-(6.7826 - place) * (6.7826 - place) * 3)) * (1 - deg2 * exp(-(6.7826 - place2) * (6.7826 - place2) * 3)) * 0.5625)
  let a20 = max(0.0004, (p7 * 0.9130 + p8 * 0.0870) * (1 - deg * exp(-(7.0870 - place) * (7.0870 - place) * 3)) * (1 - deg2 * exp(-(7.0870 - place2) * (7.0870 - place2) * 3)) * 0.5625)
  let a21 = max(0.0004, (p7 * 0.6087 + p8 * 0.3913) * (1 - deg * exp(-(7.3913 - place) * (7.3913 - place) * 3)) * (1 - deg2 * exp(-(7.3913 - place2) * (7.3913 - place2) * 3)) * 0.5625)
  let a22 = max(0.0004, (p7 * 0.3043 + p8 * 0.6957) * (1 - deg * exp(-(7.6957 - place) * (7.6957 - place) * 3)) * (1 - deg2 * exp(-(7.6957 - place2) * (7.6957 - place2) * 3)) * 0.5625)
  let a23 = max(0.0004, p8 * (1 - deg * exp(-(8.0000 - place) * (8.0000 - place) * 3)) * (1 - deg2 * exp(-(8.0000 - place2) * (8.0000 - place2) * 3)) * 0.5625)
  let r1 = (a0 - a1) / (a0 + a1)
  let r2 = (a1 - a2) / (a1 + a2)
  let r3 = (a2 - a3) / (a2 + a3)
  let r4 = (a3 - a4) / (a3 + a4)
  let r5 = (a4 - a5) / (a4 + a5)
  let r6 = (a5 - a6) / (a5 + a6)
  let r7 = (a6 - a7) / (a6 + a7)
  let r8 = (a7 - a8) / (a7 + a8)
  let r9 = (a8 - a9) / (a8 + a9)
  let r10 = (a9 - a10) / (a9 + a10)
  let r11 = (a10 - a11) / (a10 + a11)
  let r12 = (a11 - a12) / (a11 + a12)
  let r13 = (a12 - a13) / (a12 + a13)
  let r14 = (a13 - a14) / (a13 + a14)
  let r15 = (a14 - a15) / (a14 + a15)
  let r16 = (a15 - a16) / (a15 + a16)
  let r17 = (a16 - a17) / (a16 + a17)
  let r18 = (a17 - a18) / (a17 + a18)
  let r19 = (a18 - a19) / (a18 + a19)
  let r20 = (a19 - a20) / (a19 + a20)
  let r21 = (a20 - a21) / (a20 + a21)
  let r22 = (a21 - a22) / (a21 + a22)
  let r23 = (a22 - a23) / (a22 + a23)
  let nA0 = velum * velum
  let nr1 = (nA0 - 0.3600) / (nA0 + 0.3600)
  let nr2 = (0.3600 - 0.6400) / (0.3600 + 0.6400)
  let nr3 = (0.6400 - 1.0000) / (0.6400 + 1.0000)
  let nr4 = (1.0000 - 1.4400) / (1.0000 + 1.4400)
  let nr5 = (1.4400 - 1.9600) / (1.4400 + 1.9600)
  let nr6 = (1.9600 - 2.5600) / (1.9600 + 2.5600)
  let nr7 = (2.5600 - 3.2400) / (2.5600 + 3.2400)
  let nr8 = (3.2400 - 3.6100) / (3.2400 + 3.6100)
  let nr9 = (3.6100 - 3.2852) / (3.6100 + 3.2852)
  let nr10 = (3.2852 - 2.6406) / (3.2852 + 2.6406)
  let nr11 = (2.6406 - 2.0664) / (2.6406 + 2.0664)
  let nr12 = (2.0664 - 1.5625) / (2.0664 + 1.5625)
  let nr13 = (1.5625 - 1.1289) / (1.5625 + 1.1289)
  let nr14 = (1.1289 - 0.7656) / (1.1289 + 0.7656)
  let nr15 = (0.7656 - 0.4727) / (0.7656 + 0.4727)
  let jsum = a9 + a10 + nA0
  let rjL = (2 * a9 - jsum) / jsum
  let rjR = (2 * a10 - jsum) / jsum
  let rjN = (2 * nA0 - jsum) / jsum
  # turbulence where the tract is narrow but open (thinness x openness), at the constriction
  let cidx = min(23, (place - 1) / 7 * 23)          # section index of the gesture
  let h0 = max(0, 1 - abs(0 - cidx))
  let h1 = max(0, 1 - abs(1 - cidx))
  let h2 = max(0, 1 - abs(2 - cidx))
  let h3 = max(0, 1 - abs(3 - cidx))
  let h4 = max(0, 1 - abs(4 - cidx))
  let h5 = max(0, 1 - abs(5 - cidx))
  let h6 = max(0, 1 - abs(6 - cidx))
  let h7 = max(0, 1 - abs(7 - cidx))
  let h8 = max(0, 1 - abs(8 - cidx))
  let h9 = max(0, 1 - abs(9 - cidx))
  let h10 = max(0, 1 - abs(10 - cidx))
  let h11 = max(0, 1 - abs(11 - cidx))
  let h12 = max(0, 1 - abs(12 - cidx))
  let h13 = max(0, 1 - abs(13 - cidx))
  let h14 = max(0, 1 - abs(14 - cidx))
  let h15 = max(0, 1 - abs(15 - cidx))
  let h16 = max(0, 1 - abs(16 - cidx))
  let h17 = max(0, 1 - abs(17 - cidx))
  let h18 = max(0, 1 - abs(18 - cidx))
  let h19 = max(0, 1 - abs(19 - cidx))
  let h20 = max(0, 1 - abs(20 - cidx))
  let h21 = max(0, 1 - abs(21 - cidx))
  let h22 = max(0, 1 - abs(22 - cidx))
  let h23 = max(0, 1 - abs(23 - cidx))
  let dcon = sqrt((a0 * h0 + a1 * h1 + a2 * h2 + a3 * h3 + a4 * h4 + a5 * h5 + a6 * h6 + a7 * h7 + a8 * h8 + a9 * h9 + a10 * h10 + a11 * h11 + a12 * h12 + a13 * h13 + a14 * h14 + a15 * h15 + a16 * h16 + a17 * h17 + a18 * h18 + a19 * h19 + a20 * h20 + a21 * h21 + a22 * h22 + a23 * h23) / max(0.001, h0 + h1 + h2 + h3 + h4 + h5 + h6 + h7 + h8 + h9 + h10 + h11 + h12 + h13 + h14 + h15 + h16 + h17 + h18 + h19 + h20 + h21 + h22 + h23))       # the diameter at the gesture
  let thin = clamp(8 * (0.7 - dcon), 0, 1)
  let opn  = clamp(30 * (dcon - 0.3), 0, 1)
  let fz   = turb * thin * opn * 0.66 * clamp((deg - 0.5) * 4, 0, 1)
  let tr   = discharge(relT, 138.6) * 0.3                 # a release: 0.3 * 2^(-200 t)
  $R0 = 0.0
  $L0 = 0.0
  $R1 = 0.0
  $L1 = 0.0
  $R2 = 0.0
  $L2 = 0.0
  $R3 = 0.0
  $L3 = 0.0
  $R4 = 0.0
  $L4 = 0.0
  $R5 = 0.0
  $L5 = 0.0
  $R6 = 0.0
  $L6 = 0.0
  $R7 = 0.0
  $L7 = 0.0
  $R8 = 0.0
  $L8 = 0.0
  $R9 = 0.0
  $L9 = 0.0
  $R10 = 0.0
  $L10 = 0.0
  $R11 = 0.0
  $L11 = 0.0
  $R12 = 0.0
  $L12 = 0.0
  $R13 = 0.0
  $L13 = 0.0
  $R14 = 0.0
  $L14 = 0.0
  $R15 = 0.0
  $L15 = 0.0
  $R16 = 0.0
  $L16 = 0.0
  $R17 = 0.0
  $L17 = 0.0
  $R18 = 0.0
  $L18 = 0.0
  $R19 = 0.0
  $L19 = 0.0
  $R20 = 0.0
  $L20 = 0.0
  $R21 = 0.0
  $L21 = 0.0
  $R22 = 0.0
  $L22 = 0.0
  $R23 = 0.0
  $L23 = 0.0
  $nR0 = 0.0
  $nL0 = 0.0
  $nR1 = 0.0
  $nL1 = 0.0
  $nR2 = 0.0
  $nL2 = 0.0
  $nR3 = 0.0
  $nL3 = 0.0
  $nR4 = 0.0
  $nL4 = 0.0
  $nR5 = 0.0
  $nL5 = 0.0
  $nR6 = 0.0
  $nL6 = 0.0
  $nR7 = 0.0
  $nL7 = 0.0
  $nR8 = 0.0
  $nL8 = 0.0
  $nR9 = 0.0
  $nL9 = 0.0
  $nR10 = 0.0
  $nL10 = 0.0
  $nR11 = 0.0
  $nL11 = 0.0
  $nR12 = 0.0
  $nL12 = 0.0
  $nR13 = 0.0
  $nL13 = 0.0
  $nR14 = 0.0
  $nL14 = 0.0
  $nR15 = 0.0
  $nL15 = 0.0
  let iR0a = $R0 + (fz + tr) * h0 * 0.5
  let iL0a = $L0 + (fz + tr) * h0 * 0.5
  let iR1a = $R1 + (fz + tr) * h1 * 0.5
  let iL1a = $L1 + (fz + tr) * h1 * 0.5
  let iR2a = $R2 + (fz + tr) * h2 * 0.5
  let iL2a = $L2 + (fz + tr) * h2 * 0.5
  let iR3a = $R3 + (fz + tr) * h3 * 0.5
  let iL3a = $L3 + (fz + tr) * h3 * 0.5
  let iR4a = $R4 + (fz + tr) * h4 * 0.5
  let iL4a = $L4 + (fz + tr) * h4 * 0.5
  let iR5a = $R5 + (fz + tr) * h5 * 0.5
  let iL5a = $L5 + (fz + tr) * h5 * 0.5
  let iR6a = $R6 + (fz + tr) * h6 * 0.5
  let iL6a = $L6 + (fz + tr) * h6 * 0.5
  let iR7a = $R7 + (fz + tr) * h7 * 0.5
  let iL7a = $L7 + (fz + tr) * h7 * 0.5
  let iR8a = $R8 + (fz + tr) * h8 * 0.5
  let iL8a = $L8 + (fz + tr) * h8 * 0.5
  let iR9a = $R9 + (fz + tr) * h9 * 0.5
  let iL9a = $L9 + (fz + tr) * h9 * 0.5
  let iR10a = $R10 + (fz + tr) * h10 * 0.5
  let iL10a = $L10 + (fz + tr) * h10 * 0.5
  let iR11a = $R11 + (fz + tr) * h11 * 0.5
  let iL11a = $L11 + (fz + tr) * h11 * 0.5
  let iR12a = $R12 + (fz + tr) * h12 * 0.5
  let iL12a = $L12 + (fz + tr) * h12 * 0.5
  let iR13a = $R13 + (fz + tr) * h13 * 0.5
  let iL13a = $L13 + (fz + tr) * h13 * 0.5
  let iR14a = $R14 + (fz + tr) * h14 * 0.5
  let iL14a = $L14 + (fz + tr) * h14 * 0.5
  let iR15a = $R15 + (fz + tr) * h15 * 0.5
  let iL15a = $L15 + (fz + tr) * h15 * 0.5
  let iR16a = $R16 + (fz + tr) * h16 * 0.5
  let iL16a = $L16 + (fz + tr) * h16 * 0.5
  let iR17a = $R17 + (fz + tr) * h17 * 0.5
  let iL17a = $L17 + (fz + tr) * h17 * 0.5
  let iR18a = $R18 + (fz + tr) * h18 * 0.5
  let iL18a = $L18 + (fz + tr) * h18 * 0.5
  let iR19a = $R19 + (fz + tr) * h19 * 0.5
  let iL19a = $L19 + (fz + tr) * h19 * 0.5
  let iR20a = $R20 + (fz + tr) * h20 * 0.5
  let iL20a = $L20 + (fz + tr) * h20 * 0.5
  let iR21a = $R21 + (fz + tr) * h21 * 0.5
  let iL21a = $L21 + (fz + tr) * h21 * 0.5
  let iR22a = $R22 + (fz + tr) * h22 * 0.5
  let iL22a = $L22 + (fz + tr) * h22 * 0.5
  let iR23a = $R23 + (fz + tr) * h23 * 0.5
  let iL23a = $L23 + (fz + tr) * h23 * 0.5
  let jR0a = iL0a * 0.75 + glot
  let jL24a = iR23a * -0.85
  let w1a = r1 * (iR0a + iL1a)
  let jR1a = iR0a - w1a
  let jL1a = iL1a + w1a
  let w2a = r2 * (iR1a + iL2a)
  let jR2a = iR1a - w2a
  let jL2a = iL2a + w2a
  let w3a = r3 * (iR2a + iL3a)
  let jR3a = iR2a - w3a
  let jL3a = iL3a + w3a
  let w4a = r4 * (iR3a + iL4a)
  let jR4a = iR3a - w4a
  let jL4a = iL4a + w4a
  let w5a = r5 * (iR4a + iL5a)
  let jR5a = iR4a - w5a
  let jL5a = iL5a + w5a
  let w6a = r6 * (iR5a + iL6a)
  let jR6a = iR5a - w6a
  let jL6a = iL6a + w6a
  let w7a = r7 * (iR6a + iL7a)
  let jR7a = iR6a - w7a
  let jL7a = iL7a + w7a
  let w8a = r8 * (iR7a + iL8a)
  let jR8a = iR7a - w8a
  let jL8a = iL8a + w8a
  let w10a = r10 * (iR9a + iL10a)
  let jR10a = iR9a - w10a
  let jL10a = iL10a + w10a
  let w11a = r11 * (iR10a + iL11a)
  let jR11a = iR10a - w11a
  let jL11a = iL11a + w11a
  let w12a = r12 * (iR11a + iL12a)
  let jR12a = iR11a - w12a
  let jL12a = iL12a + w12a
  let w13a = r13 * (iR12a + iL13a)
  let jR13a = iR12a - w13a
  let jL13a = iL13a + w13a
  let w14a = r14 * (iR13a + iL14a)
  let jR14a = iR13a - w14a
  let jL14a = iL14a + w14a
  let w15a = r15 * (iR14a + iL15a)
  let jR15a = iR14a - w15a
  let jL15a = iL15a + w15a
  let w16a = r16 * (iR15a + iL16a)
  let jR16a = iR15a - w16a
  let jL16a = iL16a + w16a
  let w17a = r17 * (iR16a + iL17a)
  let jR17a = iR16a - w17a
  let jL17a = iL17a + w17a
  let w18a = r18 * (iR17a + iL18a)
  let jR18a = iR17a - w18a
  let jL18a = iL18a + w18a
  let w19a = r19 * (iR18a + iL19a)
  let jR19a = iR18a - w19a
  let jL19a = iL19a + w19a
  let w20a = r20 * (iR19a + iL20a)
  let jR20a = iR19a - w20a
  let jL20a = iL20a + w20a
  let w21a = r21 * (iR20a + iL21a)
  let jR21a = iR20a - w21a
  let jL21a = iL21a + w21a
  let w22a = r22 * (iR21a + iL22a)
  let jR22a = iR21a - w22a
  let jL22a = iL22a + w22a
  let w23a = r23 * (iR22a + iL23a)
  let jR23a = iR22a - w23a
  let jL23a = iL23a + w23a
  let jL9a = rjL * iR8a + (1 + rjL) * ($nL0 + iL9a)
  let jR9a = rjR * iL9a + (1 + rjR) * (iR8a + $nL0)
  let njR0a = rjN * $nL0 + (1 + rjN) * (iL9a + iR8a)
  let oR0a = clamp(jR0a * 0.999, -20, 20)
  let oL0a = clamp(jL1a * 0.999, -20, 20)
  let oR1a = clamp(jR1a * 0.999, -20, 20)
  let oL1a = clamp(jL2a * 0.999, -20, 20)
  let oR2a = clamp(jR2a * 0.999, -20, 20)
  let oL2a = clamp(jL3a * 0.999, -20, 20)
  let oR3a = clamp(jR3a * 0.999, -20, 20)
  let oL3a = clamp(jL4a * 0.999, -20, 20)
  let oR4a = clamp(jR4a * 0.999, -20, 20)
  let oL4a = clamp(jL5a * 0.999, -20, 20)
  let oR5a = clamp(jR5a * 0.999, -20, 20)
  let oL5a = clamp(jL6a * 0.999, -20, 20)
  let oR6a = clamp(jR6a * 0.999, -20, 20)
