def tube24(src, noiz, place, deg, p1, p2, p3, p4, p5, p6, p7, p8):
  # place: where the constriction is (1 glottis .. 8 lips, in control-point units); deg: 0 open .. 1 closed
  let s0 = max(0.02, p1 * (1 - deg * exp(-(1.0000 - place) * (1.0000 - place) * 3)))
  let s1 = max(0.02, (p1 * 0.6957 + p2 * 0.3043) * (1 - deg * exp(-(1.3043 - place) * (1.3043 - place) * 3)))
  let s2 = max(0.02, (p1 * 0.3913 + p2 * 0.6087) * (1 - deg * exp(-(1.6087 - place) * (1.6087 - place) * 3)))
  let s3 = max(0.02, (p1 * 0.0870 + p2 * 0.9130) * (1 - deg * exp(-(1.9130 - place) * (1.9130 - place) * 3)))
  let s4 = max(0.02, (p2 * 0.7826 + p3 * 0.2174) * (1 - deg * exp(-(2.2174 - place) * (2.2174 - place) * 3)))
  let s5 = max(0.02, (p2 * 0.4783 + p3 * 0.5217) * (1 - deg * exp(-(2.5217 - place) * (2.5217 - place) * 3)))
  let s6 = max(0.02, (p2 * 0.1739 + p3 * 0.8261) * (1 - deg * exp(-(2.8261 - place) * (2.8261 - place) * 3)))
  let s7 = max(0.02, (p3 * 0.8696 + p4 * 0.1304) * (1 - deg * exp(-(3.1304 - place) * (3.1304 - place) * 3)))
  let s8 = max(0.02, (p3 * 0.5652 + p4 * 0.4348) * (1 - deg * exp(-(3.4348 - place) * (3.4348 - place) * 3)))
  let s9 = max(0.02, (p3 * 0.2609 + p4 * 0.7391) * (1 - deg * exp(-(3.7391 - place) * (3.7391 - place) * 3)))
  let s10 = max(0.02, (p4 * 0.9565 + p5 * 0.0435) * (1 - deg * exp(-(4.0435 - place) * (4.0435 - place) * 3)))
  let s11 = max(0.02, (p4 * 0.6522 + p5 * 0.3478) * (1 - deg * exp(-(4.3478 - place) * (4.3478 - place) * 3)))
  let s12 = max(0.02, (p4 * 0.3478 + p5 * 0.6522) * (1 - deg * exp(-(4.6522 - place) * (4.6522 - place) * 3)))
  let s13 = max(0.02, (p4 * 0.0435 + p5 * 0.9565) * (1 - deg * exp(-(4.9565 - place) * (4.9565 - place) * 3)))
  let s14 = max(0.02, (p5 * 0.7391 + p6 * 0.2609) * (1 - deg * exp(-(5.2609 - place) * (5.2609 - place) * 3)))
  let s15 = max(0.02, (p5 * 0.4348 + p6 * 0.5652) * (1 - deg * exp(-(5.5652 - place) * (5.5652 - place) * 3)))
  let s16 = max(0.02, (p5 * 0.1304 + p6 * 0.8696) * (1 - deg * exp(-(5.8696 - place) * (5.8696 - place) * 3)))
  let s17 = max(0.02, (p6 * 0.8261 + p7 * 0.1739) * (1 - deg * exp(-(6.1739 - place) * (6.1739 - place) * 3)))
  let s18 = max(0.02, (p6 * 0.5217 + p7 * 0.4783) * (1 - deg * exp(-(6.4783 - place) * (6.4783 - place) * 3)))
  let s19 = max(0.02, (p6 * 0.2174 + p7 * 0.7826) * (1 - deg * exp(-(6.7826 - place) * (6.7826 - place) * 3)))
  let s20 = max(0.02, (p7 * 0.9130 + p8 * 0.0870) * (1 - deg * exp(-(7.0870 - place) * (7.0870 - place) * 3)))
  let s21 = max(0.02, (p7 * 0.6087 + p8 * 0.3913) * (1 - deg * exp(-(7.3913 - place) * (7.3913 - place) * 3)))
  let s22 = max(0.02, (p7 * 0.3043 + p8 * 0.6957) * (1 - deg * exp(-(7.6957 - place) * (7.6957 - place) * 3)))
  let s23 = max(0.02, p8 * (1 - deg * exp(-(8.0000 - place) * (8.0000 - place) * 3)))
  $f0 = 0.0
  $b0 = 0.0
  $f1 = 0.0
  $b1 = 0.0
  $f2 = 0.0
  $b2 = 0.0
  $f3 = 0.0
  $b3 = 0.0
  $f4 = 0.0
  $b4 = 0.0
  $f5 = 0.0
  $b5 = 0.0
  $f6 = 0.0
  $b6 = 0.0
  $f7 = 0.0
  $b7 = 0.0
  $f8 = 0.0
  $b8 = 0.0
  $f9 = 0.0
  $b9 = 0.0
  $f10 = 0.0
  $b10 = 0.0
  $f11 = 0.0
  $b11 = 0.0
  $f12 = 0.0
  $b12 = 0.0
  $f13 = 0.0
  $b13 = 0.0
  $f14 = 0.0
  $b14 = 0.0
  $f15 = 0.0
  $b15 = 0.0
  $f16 = 0.0
  $b16 = 0.0
  $f17 = 0.0
  $b17 = 0.0
  $f18 = 0.0
  $b18 = 0.0
  $f19 = 0.0
  $b19 = 0.0
  $f20 = 0.0
  $b20 = 0.0
  $f21 = 0.0
  $b21 = 0.0
  $f22 = 0.0
  $b22 = 0.0
  $f23 = 0.0
  $b23 = 0.0
  let k0 = (s0 - s1) / (s0 + s1)
  let k1 = (s1 - s2) / (s1 + s2)
  let k2 = (s2 - s3) / (s2 + s3)
  let k3 = (s3 - s4) / (s3 + s4)
  let k4 = (s4 - s5) / (s4 + s5)
  let k5 = (s5 - s6) / (s5 + s6)
  let k6 = (s6 - s7) / (s6 + s7)
  let k7 = (s7 - s8) / (s7 + s8)
  let k8 = (s8 - s9) / (s8 + s9)
  let k9 = (s9 - s10) / (s9 + s10)
  let k10 = (s10 - s11) / (s10 + s11)
  let k11 = (s11 - s12) / (s11 + s12)
  let k12 = (s12 - s13) / (s12 + s13)
  let k13 = (s13 - s14) / (s13 + s14)
  let k14 = (s14 - s15) / (s14 + s15)
  let k15 = (s15 - s16) / (s15 + s16)
  let k16 = (s16 - s17) / (s16 + s17)
  let k17 = (s17 - s18) / (s17 + s18)
  let k18 = (s18 - s19) / (s18 + s19)
  let k19 = (s19 - s20) / (s19 + s20)
  let k20 = (s20 - s21) / (s20 + s21)
  let k21 = (s21 - s22) / (s21 + s22)
  let k22 = (s22 - s23) / (s22 + s23)
  let n0 = noiz * exp(-(1.0000 - place) * (1.0000 - place) * 6)
  let n1 = noiz * exp(-(1.3043 - place) * (1.3043 - place) * 6)
  let n2 = noiz * exp(-(1.6087 - place) * (1.6087 - place) * 6)
  let n3 = noiz * exp(-(1.9130 - place) * (1.9130 - place) * 6)
  let n4 = noiz * exp(-(2.2174 - place) * (2.2174 - place) * 6)
  let n5 = noiz * exp(-(2.5217 - place) * (2.5217 - place) * 6)
  let n6 = noiz * exp(-(2.8261 - place) * (2.8261 - place) * 6)
  let n7 = noiz * exp(-(3.1304 - place) * (3.1304 - place) * 6)
  let n8 = noiz * exp(-(3.4348 - place) * (3.4348 - place) * 6)
  let n9 = noiz * exp(-(3.7391 - place) * (3.7391 - place) * 6)
  let n10 = noiz * exp(-(4.0435 - place) * (4.0435 - place) * 6)
  let n11 = noiz * exp(-(4.3478 - place) * (4.3478 - place) * 6)
  let n12 = noiz * exp(-(4.6522 - place) * (4.6522 - place) * 6)
  let n13 = noiz * exp(-(4.9565 - place) * (4.9565 - place) * 6)
  let n14 = noiz * exp(-(5.2609 - place) * (5.2609 - place) * 6)
  let n15 = noiz * exp(-(5.5652 - place) * (5.5652 - place) * 6)
  let n16 = noiz * exp(-(5.8696 - place) * (5.8696 - place) * 6)
  let n17 = noiz * exp(-(6.1739 - place) * (6.1739 - place) * 6)
  let n18 = noiz * exp(-(6.4783 - place) * (6.4783 - place) * 6)
  let n19 = noiz * exp(-(6.7826 - place) * (6.7826 - place) * 6)
  let n20 = noiz * exp(-(7.0870 - place) * (7.0870 - place) * 6)
  let n21 = noiz * exp(-(7.3913 - place) * (7.3913 - place) * 6)
  let n22 = noiz * exp(-(7.6957 - place) * (7.6957 - place) * 6)
  # the ends are area junctions too: a narrow glottal slit, and the open air past the lips
  let kG = (s0 - 0.15) / (s0 + 0.15)
  let g0 = src + kG * $b0
  let fw1 = (1 + k0) * $f0 - k0 * $b1 + n0
  let bw0 = k0 * $f0 + (1 - k0) * $b1
  let fw2 = (1 + k1) * $f1 - k1 * $b2 + n1
  let bw1 = k1 * $f1 + (1 - k1) * $b2
  let fw3 = (1 + k2) * $f2 - k2 * $b3 + n2
  let bw2 = k2 * $f2 + (1 - k2) * $b3
  let fw4 = (1 + k3) * $f3 - k3 * $b4 + n3
  let bw3 = k3 * $f3 + (1 - k3) * $b4
  let fw5 = (1 + k4) * $f4 - k4 * $b5 + n4
  let bw4 = k4 * $f4 + (1 - k4) * $b5
  let fw6 = (1 + k5) * $f5 - k5 * $b6 + n5
  let bw5 = k5 * $f5 + (1 - k5) * $b6
  let fw7 = (1 + k6) * $f6 - k6 * $b7 + n6
  let bw6 = k6 * $f6 + (1 - k6) * $b7
  let fw8 = (1 + k7) * $f7 - k7 * $b8 + n7
  let bw7 = k7 * $f7 + (1 - k7) * $b8
  let fw9 = (1 + k8) * $f8 - k8 * $b9 + n8
  let bw8 = k8 * $f8 + (1 - k8) * $b9
  let fw10 = (1 + k9) * $f9 - k9 * $b10 + n9
  let bw9 = k9 * $f9 + (1 - k9) * $b10
  let fw11 = (1 + k10) * $f10 - k10 * $b11 + n10
  let bw10 = k10 * $f10 + (1 - k10) * $b11
  let fw12 = (1 + k11) * $f11 - k11 * $b12 + n11
  let bw11 = k11 * $f11 + (1 - k11) * $b12
  let fw13 = (1 + k12) * $f12 - k12 * $b13 + n12
  let bw12 = k12 * $f12 + (1 - k12) * $b13
  let fw14 = (1 + k13) * $f13 - k13 * $b14 + n13
  let bw13 = k13 * $f13 + (1 - k13) * $b14
  let fw15 = (1 + k14) * $f14 - k14 * $b15 + n14
  let bw14 = k14 * $f14 + (1 - k14) * $b15
  let fw16 = (1 + k15) * $f15 - k15 * $b16 + n15
  let bw15 = k15 * $f15 + (1 - k15) * $b16
  let fw17 = (1 + k16) * $f16 - k16 * $b17 + n16
  let bw16 = k16 * $f16 + (1 - k16) * $b17
  let fw18 = (1 + k17) * $f17 - k17 * $b18 + n17
  let bw17 = k17 * $f17 + (1 - k17) * $b18
  let fw19 = (1 + k18) * $f18 - k18 * $b19 + n18
  let bw18 = k18 * $f18 + (1 - k18) * $b19
  let fw20 = (1 + k19) * $f19 - k19 * $b20 + n19
  let bw19 = k19 * $f19 + (1 - k19) * $b20
  let fw21 = (1 + k20) * $f20 - k20 * $b21 + n20
  let bw20 = k20 * $f20 + (1 - k20) * $b21
  let fw22 = (1 + k21) * $f21 - k21 * $b22 + n21
  let bw21 = k21 * $f21 + (1 - k21) * $b22
  let fw23 = (1 + k22) * $f22 - k22 * $b23 + n22
  let bw22 = k22 * $f22 + (1 - k22) * $b23
  let kL = (s23 - 25) / (s23 + 25)
  let lipR = lp1($f23, 19580)                 # a true 4 kHz: lp1 takes a = cutoff/sr, not Hz
  let bwL = kL * lipR
  let out = $f23 + bwL
  $f0 = clamp(g0 * 0.996, -50, 50)
  $f1 = clamp(fw1 * 0.996, -50, 50)
  $f2 = clamp(fw2 * 0.996, -50, 50)
  $f3 = clamp(fw3 * 0.996, -50, 50)
  $f4 = clamp(fw4 * 0.996, -50, 50)
  $f5 = clamp(fw5 * 0.996, -50, 50)
  $f6 = clamp(fw6 * 0.996, -50, 50)
  $f7 = clamp(fw7 * 0.996, -50, 50)
  $f8 = clamp(fw8 * 0.996, -50, 50)
  $f9 = clamp(fw9 * 0.996, -50, 50)
  $f10 = clamp(fw10 * 0.996, -50, 50)
  $f11 = clamp(fw11 * 0.996, -50, 50)
  $f12 = clamp(fw12 * 0.996, -50, 50)
  $f13 = clamp(fw13 * 0.996, -50, 50)
  $f14 = clamp(fw14 * 0.996, -50, 50)
  $f15 = clamp(fw15 * 0.996, -50, 50)
  $f16 = clamp(fw16 * 0.996, -50, 50)
  $f17 = clamp(fw17 * 0.996, -50, 50)
  $f18 = clamp(fw18 * 0.996, -50, 50)
  $f19 = clamp(fw19 * 0.996, -50, 50)
  $f20 = clamp(fw20 * 0.996, -50, 50)
  $f21 = clamp(fw21 * 0.996, -50, 50)
  $f22 = clamp(fw22 * 0.996, -50, 50)
  $f23 = clamp(fw23 * 0.996, -50, 50)
  $b0 = clamp(bw0 * 0.996, -50, 50)
  $b1 = clamp(bw1 * 0.996, -50, 50)
  $b2 = clamp(bw2 * 0.996, -50, 50)
  $b3 = clamp(bw3 * 0.996, -50, 50)
  $b4 = clamp(bw4 * 0.996, -50, 50)
  $b5 = clamp(bw5 * 0.996, -50, 50)
  $b6 = clamp(bw6 * 0.996, -50, 50)
  $b7 = clamp(bw7 * 0.996, -50, 50)
  $b8 = clamp(bw8 * 0.996, -50, 50)
  $b9 = clamp(bw9 * 0.996, -50, 50)
  $b10 = clamp(bw10 * 0.996, -50, 50)
  $b11 = clamp(bw11 * 0.996, -50, 50)
  $b12 = clamp(bw12 * 0.996, -50, 50)
  $b13 = clamp(bw13 * 0.996, -50, 50)
  $b14 = clamp(bw14 * 0.996, -50, 50)
  $b15 = clamp(bw15 * 0.996, -50, 50)
  $b16 = clamp(bw16 * 0.996, -50, 50)
  $b17 = clamp(bw17 * 0.996, -50, 50)
  $b18 = clamp(bw18 * 0.996, -50, 50)
  $b19 = clamp(bw19 * 0.996, -50, 50)
  $b20 = clamp(bw20 * 0.996, -50, 50)
  $b21 = clamp(bw21 * 0.996, -50, 50)
  $b22 = clamp(bw22 * 0.996, -50, 50)
  $b23 = clamp(bwL * 0.996, -50, 50)
  out - prev(out)

let va1 = [1.53, 2.50, 1.22, 1.10, 1.25, 2.46, 2.50, 2.50, 1.87, 2.50, 2.15]
let va2 = [3.62, 4.57, 1.81, 1.60, 1.14, 1.36, 2.04, 1.32, 1.70, 1.19, 2.46]
let va3 = [7.65, 5.95, 2.81, 2.77, 1.24, 1.02, 1.54, 0.74, 1.44, 1.52, 2.57]
let va4 = [2.89, 3.82, 2.77, 2.93, 1.88, 1.62, 1.70, 0.93, 1.72, 4.29, 2.45]
let va5 = [1.06, 2.15, 2.44, 2.28, 3.45, 3.99, 2.43, 1.46, 3.20, 1.32, 2.56]
let va6 = [0.87, 1.96, 2.47, 2.51, 6.09, 9.00, 3.06, 2.60, 4.67, 1.36, 2.47]
let va7 = [2.26, 3.63, 3.80, 4.71, 7.58, 8.92, 2.28, 1.32, 4.07, 3.84, 2.49]
let va8 = [9.00, 8.43, 7.39, 9.00, 6.72, 4.34, 1.45, 0.37, 3.60, 1.23, 2.92]

# test: each vowel held 1 s, folds at 60 Hz
let vi   = int(t) mod 11
let gph  = phasor(60)
let gt   = gph / 0.6
let flow = if gph < 0.6 then gt * gt * (1 - gt) * 6.75 else 0
play v:
  tube24(flow, 0, 5, 0, va1[vi], va2[vi], va3[vi], va4[vi], va5[vi], va6[vi], va7[vi], va8[vi]) * 0.5
v
