# The notes the chorale plays and the plate listens for: just intonation
# on A, pure ratios of 220 Hz. Shared, so the two can't disagree.
#
#   220    275    293.33  330    366.67  412.5   440   495    550
#   1      5/4    4/3     3/2    5/3     15/8    2     9/4    5/2
#   A      C#     D       E      F#      G#      A     B      C#
let notes = [220, 275, 293.333333, 330, 366.666667, 412.5, 440, 495, 550]

# The four chords, I IV vi V, as three notes each (indexes into notes),
# and the bass an octave or so below each root.
let chordLow  = [0, 2, 4, 3]       # A  D  F#  E
let chordMid  = [1, 4, 6, 5]       # C# F# A   G#
let chordHigh = [3, 6, 8, 7]       # E  A  C#  B
let chordBass = [110, 146.666667, 183.333333, 165]
