#!/bin/bash
# listen: hear one patch, and watch another listen to it.
#
#   tools/listen demos/chorale.aither demos/plate.aither 48x27 [device]
#
# The first patch plays to the speaker (tools/play, hw:rockchipes8388c by
# default, the uConsole's). Its stream is also the second patch's input(),
# and the second's picture goes to tv at the size given, full screen. The
# two engines share the stream, so the picture moves with what you hear.
#
# Each engine has its own socket: send to the music as usual
# (aither send ...), to the picture with
#   AITHER_SOCK=/tmp/aither-picture.sock aither send ...
# Closing tv (q) leaves the music playing; Ctrl-C stops both.
set -euo pipefail
[ $# -ge 3 ] || { sed -n '3,4p' "$0" | sed 's/^# *//' >&2; exit 2; }
music=$(readlink -f "$1"); picture=$(readlink -f "$2"); size=$3
dev=${4:-hw:rockchipes8388c}
cd "$(dirname "$(readlink -f "$0")")/.."
# A live engine plays on when its input ends, so stop the picture's when
# the music stops (or the window is already gone, which is fine too).
trap 'AITHER_SOCK=/tmp/aither-picture.sock ./aither kill >/dev/null 2>&1 || true' EXIT
# The picture's side writes nothing to the pipe into play: left on it, it
# would hold that pipe open and play would never see the music end.
./aither "$music" < /dev/null |
  tee -p >(exec > /dev/null
           AITHER_SOCK=/tmp/aither-picture.sock ./aither "$picture" |
             tools/tv --size "$size" --smooth) |
  tools/play "$dev" 20
