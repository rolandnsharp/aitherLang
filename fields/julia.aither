# julia: z -> z² + c at every pixel, c walking the edge of the Mandelbrot
# set, pushed outward by the music's loudness.
let z = pixel() * 1.5
def rec escape(z, c, n):
  if n == 0 or magnitude(z) > 2 then n else escape(cmul(z, z) + c, c, n - 1)
let c = rotate([0.7885 + level() * 0.2, 0], t * 0.2)
let n = escape(z, c, 96)
let k = 96 - n                             # steps it took to leave
draw if n == 0 then [0, 0] else rotate([1, 0], k * 0.35 + t) * min(1, k / 12)
