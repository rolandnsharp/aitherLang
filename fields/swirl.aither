# swirl: last frame, turned a little more near the middle and drawn in a
# touch, so colour flows inward like water down a drain; a ring of the
# music's phase is poured in each frame.
let p = pixel()
let r = magnitude(p)
let flow = last(rotate(p * 0.995, 0.03 / (0.15 + r)))
let ring = if abs(r - 0.45) < 0.02 then rotate([1, 0], t * 2 + phase(input()) + p[0] * 3) else [0, 0]
draw flow * 0.985 + ring * (0.5 + level() * 3)
