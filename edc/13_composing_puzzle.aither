# ┌──────────────────────────────────────────────────────┐
# │ PUZZLE 13 · Write a breakdown  (♪ listening)         │
# └──────────────────────────────────────────────────────┘
#
# This is lesson 13's piece. Give it a BREAKDOWN: a moment
# where the energy drops before the climax, so the climax
# hits harder.
#
#   1. Between 40 and 48 seconds, the pulse drops out and
#      the bells carry on alone with the drone.
#   2. When the pulse comes back at 48s, it returns at the
#      same moment the drone's filter starts to open.
#   3. Bonus: during the breakdown, make the drone dip in
#      volume a little too, so the gap feels deliberate.
#
# Tip: skip straight to the interesting part while you work
# by adding + 36 to pos (it starts 36 seconds in). Take it
# out again when you're done.
#
# Check:  edc/learn check 13     Hear:  edc/learn puzzle 13
#
#@ ear

def gate(pos, t0, t1): ease((pos - t0) / 4) * (1 - ease((pos - t1) / 4))

let pos  = sweep
let beat = 96 / 60
let bar  = phasor(beat / 16)

play drone:
  let open = ease((pos - 48) / 12) * (1 - ease((pos - 66) / 8))
  let tone = additive(110, saw_shape, 14) + additive(110.4, saw_shape, 14)
  let life = ease(pos / 8) * (1 - ease((pos - 72) / 14))
  (tone |> lpf(250 + open * 2200, 0.4)) * life * 0.05 |> haas(12)

play pulse:
  let notes = [220, 330, 440, 330, 247, 330, 392, 330]
  let idx   = int(phasor(beat / 4) * 8)
  let drop  = if bar > 0.94 then 0 else 1
  let env   = pluck(impulse(beat * 2), 0.18)
  let tone  = additive(notes[idx], warm_shape, 6) * env * drop
  tone * gate(pos, 16, 70) * 0.3 |> pan(sin(TAU * pos / 20) * 0.6)

play bells:
  let env  = pluck(impulse(beat / 4), 3)
  let ring = inharmonic(880, bar_partials, bell_decay, 5) * env
  (ring |> reverb(3, 0.45)) * gate(pos, 32, 76) * 0.18 |> pan(-0.4)

drone + pulse + bells

#
#
#
#
#
#
#
# ▶ HINTS
#
#
#
#
#
#
#
#
#
#   gate(pos, t0, t1) fades in around t0 and out around t1.
#   A layer with a gap in the middle is two gates added:
#   gate(pos, 16, 40) + gate(pos, 48, 70).
#
#
#
#
#
#
#
#   For the drone dip, multiply its "life" by
#   (1 - gate(pos, 40, 48) * 0.4).
