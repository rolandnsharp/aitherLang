#!/bin/sh
# learn — companion for the aither lessons in edc/.
#
#   edc/learn              list the lessons and which puzzles you've solved
#   edc/learn check 3      check your answer to puzzle 3 (or pass a file)
#   edc/learn play 3       send lesson 3 to the running engine
#   edc/learn puzzle 3     send puzzle 3 (to hear your attempt)
#   edc/learn stop         fade out everything that's playing
#   edc/learn selftest     every starter fails and every solution passes
#
# Puzzles state their goals in `#@` lines. The checker renders the
# patch offline with `aither audit` (no engine or speaker needed) and
# compares the spectrum with the goals:
#
#   #@ top 600 [tol]               loudest peak within tol Hz (default 4)
#   #@ peak 330 [tol] [min dB]     a peak near 330 Hz, at least min dB
#                                  below the loudest (default -30)
#   #@ nopeak 220 [tol] [max dB]   nothing near 220 Hz louder than max dB
#                                  (default -35)
#   #@ centroid< 500               spectral centroid ("brightness") below
#   #@ centroid> 6000              ... or above
#   #@ rms> -30   /   #@ rms< -20  overall level in dB
#   #@ ear                         a listening puzzle: only checks that
#                                  it compiles and isn't silent
#   #@ keys                        a keyboard puzzle: offline renders hear
#                                  no MIDI, so this only checks it compiles
#
# Anything after " -- " on a goal line is shown as the goal's name.

set -u
here=$(cd "$(dirname "$0")" && pwd)
aither="$here/../aither"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT INT TERM

if [ -t 1 ]; then
  B=$(printf '\033[1m'); G=$(printf '\033[32m'); R=$(printf '\033[31m')
  Y=$(printf '\033[33m'); D=$(printf '\033[2m'); N=$(printf '\033[0m')
else
  B= G= R= Y= D= N=
fi

# lesson NUM -> path of the lesson file; puzzle NUM -> its puzzle file
# (Leading zeros are stripped first: printf reads "08" as octal.)
nn() { n=$(echo "$1" | sed 's/^0*//'); printf '%02d' "${n:-0}"; }
lesson() { ls "$here"/$(nn "$1")_*.aither 2>/dev/null | grep -v '_puzzle\.aither$' | head -1; }
puzzle() { ls "$here"/$(nn "$1")_*_puzzle.aither 2>/dev/null | head -1; }

# Resolve an argument (a number or a path) to a puzzle file.
resolve() {
  case $1 in
    *[!0-9]*) [ -f "$1" ] && echo "$1" ;;
    *) puzzle "$1" ;;
  esac
}

# check FILE [quiet] — exit 0 if every goal passes, 1 if not, 2 if it
# doesn't compile. With "quiet", print nothing.
check() {
  file=$1; quiet=${2:-}
  "$aither" audit "$file" 2 > "$tmp/audit" 2>&1
  if ! grep -q '^  RMS:' "$tmp/audit"; then
    [ -n "$quiet" ] && return 2
    echo "${R}✘ doesn't compile yet:${N}"
    sed 's/^/  /' "$tmp/audit"
    return 2
  fi
  grep '^#@' "$file" | sed 's/^#@ *//' > "$tmp/goals"
  awk -v quiet="$quiet" -v G="$G" -v R="$R" -v Y="$Y" -v D="$D" -v N="$N" '
    FNR == NR {
      if ($1 == "RMS:")         { rms = ($2 == "-inf") ? -999 : $2 + 0 }
      if ($1 == "Fundamental:") { fund = $2 + 0 }
      if ($1 == "Centroid:")    { cen = $2 + 0 }
      if ($0 ~ /^ +[0-9]+\. +[0-9.]+ Hz/) { np++; pf[np] = $2 + 0; pd[np] = $4 + 0 }
      next
    }
    /^[ \t]*$/ { next }
    {
      msg = ""; line = $0
      i = index(line, " -- ")
      if (i) { msg = substr(line, i + 4); line = substr(line, 1, i - 1) }
      n = split(line, w, " "); kind = w[1]; x = w[2] + 0
      ok = 0; got = ""
      if (kind == "top") {
        tol = (n >= 3) ? w[3] + 0 : 4
        ok = (np >= 1 && pf[1] >= x - tol && pf[1] <= x + tol)
        what = sprintf("loudest peak at %g Hz", x)
        got = (np >= 1) ? sprintf("it is at %.1f Hz", pf[1]) : "no peaks"
      } else if (kind == "peak") {
        tol = (n >= 3) ? w[3] + 0 : 4; lim = (n >= 4) ? w[4] + 0 : -30
        best = -999
        for (k = 1; k <= np; k++) if (pf[k] >= x - tol && pf[k] <= x + tol && pd[k] > best) best = pd[k]
        ok = (best >= lim)
        what = sprintf("a peak at %g Hz", x)
        got = (best > -999) ? sprintf("found one at %.1f dB", best) : "none there"
      } else if (kind == "nopeak") {
        tol = (n >= 3) ? w[3] + 0 : 4; lim = (n >= 4) ? w[4] + 0 : -35
        best = -999
        for (k = 1; k <= np; k++) if (pf[k] >= x - tol && pf[k] <= x + tol && pd[k] > best) best = pd[k]
        ok = (best <= lim)
        what = sprintf("nothing at %g Hz", x)
        got = (best > -999) ? sprintf("there is one at %.1f dB", best) : ""
      } else if (kind == "centroid<" || kind == "centroid>") {
        ok = (kind == "centroid<") ? (cen < x) : (cen > x)
        what = sprintf("brightness (centroid) %s %g Hz", substr(kind, 9), x)
        got = sprintf("it is %.0f Hz", cen)
      } else if (kind == "rms<" || kind == "rms>") {
        ok = (kind == "rms<") ? (rms < x) : (rms > x)
        what = sprintf("level %s %g dB", substr(kind, 4), x)
        got = sprintf("it is %.1f dB", rms)
      } else if (kind == "ear") {
        ok = (rms > -60)
        what = "makes a sound (this one is for your ears)"
        got = "it is silent"
        ear = 1
      } else if (kind == "keys") {
        ok = 1
        what = "compiles (play it on your keyboard to judge the rest)"
        ear = 1
      } else {
        ok = 0; what = "unknown goal: " kind
      }
      if (msg != "") what = msg
      total++; if (ok) passed++
      if (quiet == "") {
        if (ok) printf "  %s✔%s %s\n", G, N, what
        else    printf "  %s✘%s %s %s(%s)%s\n", R, N, what, D, got, N
      }
    }
    END {
      if (quiet == "") {
        if (passed == total && ear) printf "\n%s♪ It runs. Now listen: does it do what the puzzle asks?%s\n", Y, N
        else if (passed == total)   printf "\n%s★ Solved! (%d/%d goals)%s\n", G, passed, total, N
        else                        printf "\n%d of %d goals met. Keep going.\n", passed, total
      }
      exit (passed == total) ? 0 : 1
    }
  ' "$tmp/audit" "$tmp/goals"
}

title() { sed -n 's/^# *[│|] *LESSON *[0-9]* *· *\(.*[^ │|]\) *[│|]$/\1/p' "$1" | head -1; }

list() {
  echo "${B}aither lessons${N}  ${D}(edc/learn check N · edc/learn play N)${N}"
  echo
  for f in "$here"/[0-9][0-9]_*.aither; do
    case $f in *_puzzle.aither) continue ;; esac
    num=$(basename "$f" | cut -c1-2)
    t=$(title "$f"); [ -n "$t" ] || t=$(basename "$f" .aither)
    p=$(puzzle "$num")
    if [ -z "$p" ]; then mark="  "
    elif grep -q -E '^#@ *(ear|keys)' "$p"; then mark="${Y}♪${N} "
    elif check "$p" quiet; then mark="${G}★${N} "
    else mark="${D}·${N} "
    fi
    printf '%s %s  %s\n' "$mark" "$num" "$t"
  done
  echo
  echo "${D}★ puzzle solved   · puzzle open   ♪ judged by ear${N}"
}

cmd=${1:-list}
case $cmd in
  list) list ;;
  check)
    [ $# -ge 2 ] || { echo "usage: edc/learn check N|file"; exit 2; }
    f=$(resolve "$2"); [ -n "$f" ] || { echo "no puzzle $2"; exit 2; }
    echo "${B}checking $(basename "$f")${N}"; echo
    check "$f" ;;
  play)
    [ $# -ge 2 ] || { echo "usage: edc/learn play N"; exit 2; }
    f=$(lesson "$2"); [ -n "$f" ] || { echo "no lesson $2"; exit 2; }
    "$aither" send "$f" ;;
  puzzle)
    [ $# -ge 2 ] || { echo "usage: edc/learn puzzle N"; exit 2; }
    f=$(resolve "$2"); [ -n "$f" ] || { echo "no puzzle $2"; exit 2; }
    "$aither" send "$f" ;;
  stop) "$aither" clear 1 ;;
  selftest)
    bad=0
    for p in "$here"/[0-9][0-9]_*_puzzle.aither; do
      s="$here/solutions/$(basename "$p")"
      if grep -q -E '^#@ *(ear|keys)' "$p"; then
        check "$p" quiet; a=$?
        [ $a -eq 0 ] && r1="ok" || { r1="STARTER BROKEN"; bad=1; }
      else
        check "$p" quiet; a=$?
        [ $a -eq 1 ] && r1="ok" || { r1="STARTER PASSES OR BROKEN ($a)"; bad=1; }
      fi
      if [ -f "$s" ]; then
        check "$s" quiet && r2="ok" || { r2="SOLUTION FAILS"; bad=1; }
      else r2="no solution"; bad=1
      fi
      printf '%-36s starter %-30s solution %s\n' "$(basename "$p")" "$r1" "$r2"
    done
    exit $bad ;;
  *) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
