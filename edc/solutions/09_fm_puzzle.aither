# Solution to PUZZLE 9. The first (strongest) sidebands sit at
# carrier ± modHz, so modHz = 200 puts them at 300 and 700 Hz.
# modHz = 100 also reaches 300 and 700, but only as the weaker
# second sidebands (carrier ± 2 × modHz).
#
#@ top 500 3 -- the 500 Hz carrier is the loudest
#@ peak 300 3 -12 -- a strong sideband at 300 Hz
#@ peak 700 3 -12 -- a strong sideband at 700 Hz

play fm:
  let carrier = 500
  let modHz   = 200
  let index   = 1
  sin(TAU * phasor(carrier) + sin(TAU * phasor(modHz)) * index) * 0.2

fm
