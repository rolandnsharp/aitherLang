# Solution to PUZZLE 3. Square and triangle waves contain only
# odd harmonics (1, 3, 5...), so either removes 220 and 440 Hz.
# The triangle is used here: its harmonics fall off as 1/n², so
# it barely aliases. osc(sqr, 110) * 0.08 also solves it.
#
#@ top 110 3 -- the note is still 110 Hz
#@ peak 330 4 -40 -- the 3rd harmonic (330 Hz) is there
#@ nopeak 220 6 -40 -- no 2nd harmonic (220 Hz)
#@ nopeak 440 6 -40 -- no 4th harmonic (440 Hz)

play hollow:
  osc(tri, 110) * 0.2

hollow
