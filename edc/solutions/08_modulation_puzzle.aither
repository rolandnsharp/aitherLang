# Solution to PUZZLE 8. Tremolo at 40 Hz puts sidebands at
# 440 - 40 = 400 and 440 + 40 = 480 Hz. At that speed you no
# longer hear pulsing: the ear hears the three tones instead.
#
#@ top 440 3 -- 440 Hz is still the loudest
#@ peak 400 3 -20 -- a sideband at 400 Hz
#@ peak 480 3 -20 -- a sideband at 480 Hz

play ghost:
  let rate    = 40
  let depth   = 0.8
  let wobble  = 1 - depth * (0.5 + 0.5 * sin(TAU * phasor(rate)))
  osc(sin, 440) * wobble * 0.3

ghost
