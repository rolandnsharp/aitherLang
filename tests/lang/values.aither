# Values on the ladder (notes/ladder-2026-11-06.md,
# notes/places-and-values-2026-11-06.md): round brackets are one value.
# A number, (a, b) and ((w, x), (y, z)) are real, complex and Hamilton's
# numbers; the narrower sits inside the wider, the rest zero, and + - * /
# ^ are the algebra's. [a, b] is two places: tests/lang/places.aither.

# --- a complex number plays as its two numbers
# expect: 0.6, 0.8
(0.6, 0.8)

# --- * is turn: a complex product
# expect: -1, 0
let i = (0, 1)
i * i

# --- + is the algebra's: a number moves the real part only
# expect: 3, 2
(2, 2) + 1

# --- ... from either side
# expect: 2, 3
let (a, b) = 1 - (-1, -3)
[a, b]

# --- a number scales
# expect: 1, 2
(2, 4) * 0.5

# --- ... and from the left
# expect: 3, 4
1 * (3, 4)

# --- over a number
# expect: 1, 2
(2, 4) / 2

# --- / is unturn: undoing a turn
# expect: 0.6, 0.8
let w = (0.28, -0.96)
(0.6, 0.8) * w / w

# --- a number over a value: the reciprocal
# expect: 0, -1
1 / (0, 1)

# --- x / 0 is 0, as everywhere
# expect: 0, 0
(1, 2) / (0, 0)

# --- ^ turns again: a quarter turn squared is a half turn
# expect: -1, 0
(0, 1) ^ 2

# --- the fourth power comes round
# expect: 1, 0
(0, 1) ^ 4

# --- ... the zeroth is 1
# expect: 1, 0
(0.3, 0.2) ^ 0

# --- a fraction is that part of the turn: the square root of a quarter turn is an eighth
# expect: 0.70710678118654757, 0.70710678118654746
(0, 1) ^ 0.5

# --- the size takes the power too: (4, 0) ^ 0.5 is 2
# expect: 2, 0
(4, 0) ^ 0.5

# --- a root squared comes back
# expect: 0.6, 0.8
let r = (0.6, 0.8) ^ 0.5
r * r

# --- a negative power is the reciprocal
# expect: 0, -0.5
(0, 2) ^ -1

# --- the principal root: -1 to a half is i, not -i
# expect: 0, 1
(-1, 0) ^ 0.5

# --- the power may change as it plays: at t = 0 it is 1
# expect: 3, 4
(3, 4) ^ (1 + t)

# --- a root of a unit value keeps its size: it is the principal root, so not a smooth spin(220)
# expect until 480: 0, 0
let (a, b) = spin(440) ^ 0.5
[a * a + b * b - 1, 0]

# --- 0 to a power is 0, and at power 0 it is 1
# expect: 0, 1
let (a, _) = (0, 0) ^ 0.5
let (b, _) = (0, 0) ^ (t * 0)
[a, b]

# --- Hamilton's: half a rotation, a rotation by half the angle about the same axis
# expect: 0.98006657784124163, 0.19866933079506122
let q = about(k, 0.8) ^ 0.5
let ((w, _), (_, z)) = q * q * about(k, -0.4)
[w, z]

# --- slerp: a fraction of the way from one rotation to another
# expect: 0.70710678118654757, 0.70710678118654746
let r0 = ((1, 0), (0, 0))
let r1 = about(k, PI)
let ((w, _), (_, z)) = r0 * (conj(r0) * r1) ^ 0.5
[w, z]

# --- a plain negative number on Hamilton's rung turns about k
# expect: 0, 1
let ((w, _), (_, z)) = ((-1, 0), (0, 0)) ^ 0.5
[w, z]

# --- the power is a number
# error: `^` on a value takes a number for its power
(1, 2) ^ (0, 1)

# --- Hamilton's: i j = k and j i = -k
# expect: 1, -1
let i = ((0, 1), (0, 0))
let j = ((0, 0), (1, 0))
let ((_, _), (_, z)) = i * j
let ((_, _), (_, y)) = j * i
[z, y]

# --- the narrower sits inside the wider: complex i is Hamilton's i
# expect: 1, 0
let j = ((0, 0), (1, 0))
let ((_, _), (_, z)) = (0, 1) * j
[z, 0]

# --- order matters: (z, 0) on the right turns the second half the other way
# expect: -1, 0
let q = ((0, 0), (1, 0))
let ((_, _), (y, z)) = q * (0, 1) * (0, 1)
[y, z]

# --- Hamilton's formula as written: cos + dir sin is a rotation
# expect: 0.69670670934716539, 0.71735609089952279
let k = ((0, 0), (0, 1))
let i = ((0, 1), (0, 0))
let r = cos(0.4) + k * sin(0.4)
let ((_, x), (y, _)) = r * i * conj(r)
[x, y]

# --- a number sits inside a value's half
# expect: 7, 0
let ((w, x), (_, _)) = (7, (1, 2))
[w, x]

# --- a def takes a value whole, whatever it does with it
# expect: 3, 4
def same(v): v + 0
same((3, 4))

# --- a function on a value runs once a number and gives a value
# expect: 0.25, 0
let v = abs((-0.5, 0)) * (0.5, 0)
v

# --- state keeps a value; a number put in it sits inside
# expect: 5, 0
$z = (1, 2)
$z = 5
$z

# --- state at a def, turned each sample
# expect: 0, 1
# expect at 1: -1, 0
def go(step):
  $z = (1, 0)
  $z = $z * step
  $z
go((0, 1))

# --- an if with a number on one branch: it sits inside
# expect: 2, 0
if t > 1 then (1, 1) else 2

# --- sum: a number term sits inside
# expect: 7, 2
sum(3, n => if n == 2 then (1, 2) else n * 1.5)

# --- an array of values, stored and read whole
# expect: 3, 4
let a = array(2, (0, 0))
a[1] = (3, 4)
a[1]

# --- a value has no places: [] won't read it
# error: a value has no places to index
let z = (1, 2)
z[0] * 1

# --- ... nor a [a, b] pattern
# error: a value has no places to index
let [a, b] = (1, 2)
a

# --- comparing takes numbers
# error: `<` takes numbers
if (1, 2) < 3 then 1 else 0

# --- (a, b, c) isn't a value
# error: a third needs a pair of pairs
(1, 2, 3)

# --- three deep is the octonions
# error: a pair of pairs of pairs
(((1, 2), (3, 4)), ((1, 2), (3, 4)))


# --- nabla's product splits a field: a change along the line is all scalar, compression
# expect: -1, 0
let ((s, x), (y, z)) = i * ((0, 1), (0, 0))
[s, x + y + z]

# --- ... a change across it all vector, twist: i j = k
# expect: 0, 1
let ((s, _), (_, z)) = i * ((0, 0), (1, 0))
[s, z]
