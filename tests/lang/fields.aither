# Fields (SPEC "Fields"): an array assigned bare is the stereo rule at N
# places. Each line is at each place, and the field steps one place a
# sample, so it moves once every N samples.

# --- arithmetic at each place, the field moving once every N samples
# expect: 0
# expect at 3: 0
# expect at 4: 1
# expect at 8: 2
$x = array(4)
$x = $x + 1
$x[0.25]

# --- a later line at the place sees what was stored
# expect at 2: 10
$a = array(2)
$b = array(2)
$a = $a + 1
$b = $a * 10
$b[0]

# --- a number is everywhere
# expect at 4: 7
$x = array(4)
$x = 7
$x[0.5]

# --- concentration: how much a place stands out from its neighbours
# expect at 4: 2, -1
$x = array(4, i => if i == 1 then 1 else 0)
$y = array(4)
$x = $x
$y = concentration($x)
[$y[0.25], $y[0]]

# --- read from outside, between places
# expect: 0.5
$x = array(4, i => i)
$x = $x
$x[0.125]

# --- ... and round past the last
# expect: 1.5
$x = array(4, i => i)
$x = $x
$x[0.875]

# --- a push from outside lands as the field reaches that place
# expect: 0
# expect at 4: 1
$v = array(4)
$v = $v
$v[0.5] += if t < dt then 1 else 0
$v[0.5]

# --- pushes add
# expect at 4: 3
$v = array(4)
$v = $v
$v[0.5] += if t < dt then 1 else 0
$v[0.5] += if t < dt then 2 else 0
$v[0.5]

# --- a field of values: turned at each place
# expect at 2: 0, 1
# expect at 4: -1, 0
$z = array(2, (1, 0))
$z = $z * (0, 1)
$z[0]

# --- squeeze: a bump along the line, the slope of its convergence 2 there, and no twist
# expect at 4: 2, 0
$d = array(4, n => if n == 1 then ((0, 1), (0, 0)) else ((0, 0), (0, 0)))
$p = array(4, ((0, 0), (0, 0)))
$d = $d
$p = slope(convergence($d))
let ((_, along), (across, _)) = $p[0.25]
[along, across]

# --- twist: a bump across the line, the curl of its curl 2 there, and no squeeze
# expect at 4: 0, 2
$d = array(4, n => if n == 1 then ((0, 0), (1, 0)) else ((0, 0), (0, 0)))
$p = array(4, ((0, 0), (0, 0)))
$d = $d
$p = curl(curl($d))
let ((_, along), (across, _)) = $p[0.25]
[along, across]

# --- a field in a play is the file's
# expect at 4: 2
$x = array(4)
play a:
  $x = $x + 2
  0
$x[0] + a * 0

# --- an array never assigned bare stays data, indexed by whole places
# expect: 3
$f = array(4, n => n)
$f[3]

# --- a ring: the engine picks its places from its period, the patch never says
# expect: 110
$x = ring(period = 1)
$x = $x
len($x)

# --- a ring's period has to be known when the patch compiles
# error: a ring's period has to be known
$x = ring(period = 1 + t)
$x = $x
$x[0]

# --- `$x'` is its rate, a round: 1 a round is 1 after a round, whatever its places
# expect at 47999: 1
$x = ring(period = 1)
$x' = 1
floor($x[0] + 0.02)

# --- ... so on a ring of twice the period, a second is half a round
# expect at 47999: 0
$x = ring(period = 2)
$x' = 1
floor($x[0] + 0.02)

# --- a ring's line has no time: dt
# error: `dt` in a ring's line
$x = ring(period = 1)
$x' = dt
$x[0]

# --- ... nor t
# error: `t` in a ring's line
$x = ring(period = 1)
$x' = sin(t)
$x[0]

# --- `+=` on a ring is its rate, said as one
# error: `+=` on a ring
$x = ring(period = 1)
$x += 1
$x[0]

# --- ... and so is `*=`
# error: `*=` on a ring
$x = ring(period = 1)
$x *= 0.9
$x[0]

# --- a rate is said, not read
# error: is a law's left side
$x = ring(period = 1)
$x' = 1
$x'

# --- one prime
# error: one prime
$x = ring(period = 1)
$x'' = 1
$x[0]

# --- a rate is of a ring's field: not an array's
# error: a rate is of a ring's field
$x = array(4)
$x' = 1
$x[0]

# --- ... nor a state's
# error: a rate is of a ring's field
$x = 0
$x' = 1
$x

# --- one law a field
# error: one law a field
$x = ring(period = 1)
$x' = 1
$x' = 2
$x[0]

# --- a law belongs in the file's lines
# error: not in a def
$x = ring(period = 1)
def f(a):
  $x' = a
  a
f(1)

# --- on an array assigned bare, `+=` is a step's worth, as the size is in the patch
# expect at 4: 1
$x = array(4)
$x += 1
$x[0]

# --- a ring of values starts as it says
# expect: 3, 4
$z = ring(period = 1, start = (3, 4))
$z = $z
$z[0]

# --- a source is added to a ring's rate at a point
# expect at 47999: 1
$x = ring(period = 1)
$x' = 0
$x'[0.5] += if t < 0.5 then 2 else 0
ceil(max(0, $x[0.5]) * 0.0001)

# --- ... and a source is taken away the same way
# expect at 47999: 0
$x = ring(period = 1)
$x' = 0
$x'[0.5] += if t < 0.5 then 2 else 0
$x'[0.5] -= if t < 0.5 then 2 else 0
$x[0.5]

# --- a push on a ring is a change to its rate
# error: a push on a ring is a change to its rate
$x = ring(period = 1)
$x' = 0
$x[0.5] += 1
$x[0]

# --- ... whichever way it's said
# error: a push on a ring is a change to its rate
$x = ring(period = 1)
$x' = 0
$x[0.5] = 1
$x[0]

# --- a source adds: it doesn't replace the law there
# error: a push adds
$x = ring(period = 1)
$x' = 0
$x'[0.5] = 1
$x[0]

# --- ... nor scale it
# error: a push adds
$x = ring(period = 1)
$x' = 0
$x'[0.5] *= 2
$x[0]

# --- a push on an array's field adds too
# error: a push adds
$x = array(4)
$x = $x
$x[0.5] = 1
$x[0]

# --- a source is said, not read
# error: is a source
$x = ring(period = 1)
$x' = 0
$x'[0.5]

# --- a ring with no law has nowhere for a push to land
# error: has no law
$x = ring(period = 1)
$x'[0.5] += 1
$x[0]

# --- a source is a ring's
# error: a rate is of a ring's field
$x = array(4)
$x = $x
$x'[0.5] += 1
$x[0]

# --- a source belongs in the file's lines
# error: not in a def
$x = ring(period = 1)
$x' = 0
def f(a):
  $x'[0.5] += a
  a
f(1)

# --- a shaped source: a Gaussian of area 1, so a blow of area 1 stands 1 / (w sqrt(TAU)) high
# expect at 2000: 7
$x = ring(period = 1)
$x' = 0
$x'[gauss(0.5, 0.05)] += if t < 0.001 then 1000 else 0
floor($x[0.5])

# --- ... a blow far shorter than a sweep lands whole, all the way across it
# expect at 2000: 4
$x = ring(period = 1)
$x' = 0
$x'[gauss(0.5, 0.05)] += if t < dt then 48000 else 0
floor($x[0.55])

# --- ... and nothing lands far from it
# expect at 2000: 0
$x = ring(period = 1)
$x' = 0
$x'[gauss(0.5, 0.05)] += if t < 0.001 then 1000 else 0
$x[0.1]

# --- it wraps: a bump on the join shows on both sides
# expect at 2000: 7
$x = ring(period = 1)
$x' = 0
$x'[gauss(0, 0.05)] += if t < 0.001 then 1000 else 0
floor($x[0])

# --- `-=` takes away
# expect at 2000: 0
$x = ring(period = 1)
$x' = 0
$x'[gauss(0.5, 0.05)] += if t < 0.001 then 1000 else 0
$x'[gauss(0.5, 0.05)] -= if t < 0.001 then 1000 else 0
$x[0.5]

# --- width 0 is the point: it lands as `$x'[p]` does, off a place as on one
# expect at 2000: 1
$x = ring(period = 1)
$y = ring(period = 1)
$x' = 0
$y' = 0
$x'[gauss(0.503, 0)] += if t < 0.001 then 1000 else 0
$y'[0.503] += if t < 0.001 then 1000 else 0
if abs($x[0.5] - $y[0.5]) < 0.000001 and $x[0.5] > 10 then 1 else 0

# --- very wide it is flat all round, with the same blow
# expect at 2000: 1
$x = ring(period = 1)
$x' = 0
$x'[gauss(0.5, 2)] += if t < 0.00051 then 1920 else 0
if abs($x[0.1] - 1) < 0.0001 and abs($x[0.5] - 1) < 0.0001 then 1 else 0

# --- where the copies give way to the series, nothing shows
# expect at 2000: 1
$x = ring(period = 1)
$y = ring(period = 1)
$x' = 0
$y' = 0
$x'[gauss(0.5, 0.24999)] += if t < 0.001 then 1000 else 0
$y'[gauss(0.5, 0.25001)] += if t < 0.001 then 1000 else 0
if abs($x[0.5] - $y[0.5]) < 0.001 then 1 else 0

# --- erf is the integral of a Gaussian
# expect: 0.8427007922
erf(1)

# --- which side of the law it stands doesn't matter
# expect at 2000: 7
$x = ring(period = 1)
$x'[gauss(0.5, 0.05)] += if t < 0.001 then 1000 else 0
$x' = 0
floor($x[0.5])

# --- a blow lands where it was struck, though the centre jumps as it ends
# expect at 2000: 7
$x = ring(period = 1)
$x' = 0
let striking = t < 0.001
$x'[gauss(if striking then 0.5 else 0.1, 0.05)] += if striking then 1000 else 0
floor($x[0.5])

# --- ... and nothing lands where the centre went
# expect at 2000: 0
$x = ring(period = 1)
$x' = 0
let striking = t < 0.001
$x'[gauss(if striking then 0.5 else 0.1, 0.05)] += if striking then 1000 else 0
$x[0.1]

# --- a width held the same way
# expect at 2000: 7
$x = ring(period = 1)
$x' = 0
let striking = t < 0.001
$x'[gauss(0.5, if striking then 0.05 else 0.3)] += if striking then 1000 else 0
floor($x[0.5])

# --- it's a shape, so it isn't a value
# error: is a shape
$x = ring(period = 1)
$x' = 0
gauss(0.5, 0.1)

# --- ... nor a place to read
# error: is a shape
$x = ring(period = 1)
$x' = 0
$x[gauss(0.5, 0.1)]

# --- ... and a source adds
# error: a push adds
$x = ring(period = 1)
$x' = 0
$x'[gauss(0.5, 0.1)] = 1
$x[0]

# --- a patch's own gauss stays its own
# expect: 3
def gauss(a, b): a + b
gauss(1, 2)

# --- `slope` joins a pair: a push on one travels by way of the other, at a round a round
# expect at 12000: 1
$v = ring(period = 1)
$i = ring(period = 1)
$v' = -slope($i)
$i' = -slope($v)
$v'[gauss(0.25, 0.02)] += if t < 0.001 then 1000 else 0
if abs($v[0.5]) > abs($v[0.75]) then 1 else 0

# --- a slope needs its partner
# error: needs its partner
$v = ring(period = 1)
$i = ring(period = 1)
$v' = -slope($i)
$i' = 0
$v[0]

# --- ... not itself
# error: needs its partner
$v = ring(period = 1)
$v' = -slope($v)
$v[0]

# --- a law reads one partner
# error: `slope` joins two fields
$a = ring(period = 1)
$b = ring(period = 1)
$c = ring(period = 1)
$a' = slope($b) + slope($c)
$b' = slope($a)
$c' = slope($a)
$a[0]

# --- a pair shares one period
# error: share one period
$v = ring(period = 1)
$i = ring(period = 2)
$v' = -slope($i)
$i' = -slope($v)
$v[0]

# --- `slope` is a law's word
# error: is a law's word
$v = ring(period = 1)
$i = ring(period = 1)
$v' = -slope($i)
$i' = -slope($v)
slope($v)

# --- a patch's own slope, of a number, is its own
# expect: 2
def slope(a): a * 2
slope(1)

# --- a line: a pulse sent along it comes back there and back in a period
# expect at 12000: 1
$x = line(period = 1, ends = fixed)
$v = line(period = 1, ends = fixed)
$v' = -concentration($x)
$x' = $v
$v'[gauss(0.25, 0.03)] += if t < 0.001 then 1000 else 0
if abs($v[0.75]) > 1 and abs($v[0.75]) > abs($v[0.5]) * 2 then 1 else 0

# --- a fixed end holds it at 0
# expect at 3000: 0
$x = line(period = 1, ends = fixed)
$v = line(period = 1, ends = fixed)
$v' = -concentration($x)
$x' = $v
$v'[gauss(0.1, 0.03)] += if t < 0.001 then 1000 else 0
$x[0]

# --- fixed flips a pulse coming back, free doesn't
# expect at 24000: 1
$a = line(period = 1, ends = fixed)
$p = line(period = 1, ends = fixed)
$b = line(period = 1, ends = free)
$q = line(period = 1, ends = free)
$p' = -concentration($a) - $a
$a' = $p
$q' = -concentration($b) - $b
$b' = $q
$p'[gauss(0.5, 0.03)] += if t < 0.001 then 1000 else 0
$q'[gauss(0.5, 0.03)] += if t < 0.001 then 1000 else 0
if $p[0.5] < -1 and $q[0.5] > 1 then 1 else 0

# --- a line says its ends
# error: a line says its ends
$x = line(period = 1)
$x' = 0
$x[0]

# --- an end is fixed or free
# error: an end is `fixed` or `free`
$x = line(period = 1, ends = sticky)
$x' = 0
$x[0]

# --- a ring has none
# error: a ring has no ends
$x = ring(period = 1, ends = fixed)
$x' = 0
$x[0]

# --- at each end of a pair one is fixed and the other free
# error: one is fixed and the other free
$v = line(period = 1, ends = fixed)
$i = line(period = 1, ends = fixed)
$v' = -slope($i)
$i' = -slope($v)
$v[0]

# --- a pair is on one kind of field
# error: on one ring or line
$v = line(period = 1, ends = free)
$i = ring(period = 1)
$v' = -slope($i)
$i' = -slope($v)
$v[0]

# --- a point past a line's end lands on the end place, and reads of a line clamp
# expect at 2000: 1
$x = line(period = 1, ends = free)
$x' = 0
$x'[1.5] += if t < 0.001 then 1000 else 0
if $x[1] > 1 and $x[0] == 0 then 1 else 0
