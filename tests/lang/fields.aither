# Fields (SPEC "Fields"): an array assigned bare is the stereo rule at N
# places. Each line is at each place, and the field steps one place a
# sample, so it moves once every N samples.

# --- arithmetic at each place, the field moving once every N samples
# expect: 0
# expect at 3: 0
# expect at 4: 1
# expect at 8: 2
$x = array(4)
$x = $x + 1
$x(0.25)

# --- a later line at the place sees what was stored
# expect at 2: 10
$a = array(2)
$b = array(2)
$a = $a + 1
$b = $a * 10
$b(0)

# --- a number is everywhere
# expect at 4: 7
$x = array(4)
$x = 7
$x(0.5)

# --- two slopes: how much a place's neighbours stand above it
# expect at 4: 2, -1
$x = array(4, i => if i == 1 then 1 else 0)
$y = array(4)
$x = $x
$y = -Δ$x
[$y(0.25), $y(0)]

# --- read from outside, between places
# expect: 0.5
$x = array(4, i => i)
$x = $x
$x(0.125)

# --- ... and round past the last
# expect: 1.5
$x = array(4, i => i)
$x = $x
$x(0.875)

# --- a push from outside lands as the field reaches that place
# expect: 0
# expect at 4: 1
$v = array(4)
$v = $v
$v[0.5] += if t < dt then 1 else 0
$v(0.5)

# --- pushes add
# expect at 4: 3
$v = array(4)
$v = $v
$v[0.5] += if t < dt then 1 else 0
$v[0.5] += if t < dt then 2 else 0
$v(0.5)

# --- a field of values: turned at each place
# expect at 2: 0, 1
# expect at 4: -1, 0
$z = array(2, (1, 0))
$z = $z * (0, 1)
$z(0)

# --- squeeze: a bump along the line, the slope of its convergence 2 there, and no twist
# expect at 4: 2, 0
$d = array(4, n => if n == 1 then ((0, 1), (0, 0)) else ((0, 0), (0, 0)))
$p = array(4, ((0, 0), (0, 0)))
$d = $d
$p = ∇(convergence($d))
let ((_, along), (across, _)) = $p(0.25)
[along, across]

# --- twist: a bump across the line, the curl of its curl 2 there, and no squeeze
# expect at 4: 0, 2
$d = array(4, n => if n == 1 then ((0, 0), (1, 0)) else ((0, 0), (0, 0)))
$p = array(4, ((0, 0), (0, 0)))
$d = $d
$p = curl(curl($d))
let ((_, along), (across, _)) = $p(0.25)
[along, across]

# --- a field in a play is the file's
# expect at 4: 2
$x = array(4)
play a:
  $x = $x + 2
  0
$x(0) + a * 0

# --- an array never assigned bare stays data, indexed by whole places
# expect: 3
$f = array(4, n => n)
$f[3]

# --- a ring: the engine picks its places from its period, the patch never says
# expect: 110
$x = ring(period = 1)
$x = $x
len($x)

# --- a ring's period has to be known when the patch compiles
# error: a ring's period has to be known
$x = ring(period = 1 + t)
$x = $x
$x(0)

# --- `$x'` is its rate, a round: 1 a round is 1 after a round, whatever its places
# expect at 47999: 1
$x = ring(period = 1)
$x' = 1
floor($x(0) + 0.02)

# --- ... so on a ring of twice the period, a second is half a round
# expect at 47999: 0
$x = ring(period = 2)
$x' = 1
floor($x(0) + 0.02)

# --- a ring's line has no time: dt
# error: `dt` in a ring's line
$x = ring(period = 1)
$x' = dt
$x(0)

# --- ... nor t
# error: `t` in a ring's line
$x = ring(period = 1)
$x' = sin(t)
$x(0)

# --- `+=` on a ring is its rate, said as one
# error: `+=` on a ring
$x = ring(period = 1)
$x += 1
$x(0)

# --- ... and so is `*=`
# error: `*=` on a ring
$x = ring(period = 1)
$x *= 0.9
$x(0)

# --- a rate is said, not read
# error: is a law's left side
$x = ring(period = 1)
$x' = 1
$x'

# --- one prime
# error: one prime
$x = ring(period = 1)
$x'' = 1
$x(0)

# --- a rate is of a ring's field: not an array's
# error: a rate is of state or a ring's field
$x = array(4)
$x' = 1
$x[0]

# --- one law a field
# error: one law a field
$x = ring(period = 1)
$x' = 1
$x' = 2
$x(0)

# --- a field's law belongs in the file's lines
# error: not in a def
$x = ring(period = 1)
def f(a):
  $x' = a
  a
f(1)

# --- on an array assigned bare, `+=` is a step's worth, as the size is in the patch
# expect at 4: 1
$x = array(4)
$x += 1
$x(0)

# --- a ring of values starts as it says
# expect: 3, 4
$z = ring(period = 1, start = (3, 4))
$z = $z
$z(0)

# --- a source is added to a ring's rate at a point
# expect at 47999: 1
$x = ring(period = 1)
$x' = (if t < 0.5 then 2 else 0) * δ(0.5)
ceil(max(0, $x(0.5)) * 0.0001)

# --- ... and a source is taken away the same way
# expect at 47999: 0
$x = ring(period = 1)
$x' = (if t < 0.5 then 2 else 0) * δ(0.5) - (if t < 0.5 then 2 else 0) * δ(0.5)
$x(0.5)

# --- a push on a ring is a change to its rate
# error: a push on a ring is a change to its rate
$x = ring(period = 1)
$x' = 0
$x[0.5] += 1
$x(0)

# --- ... whichever way it's said
# error: a push on a ring is a change to its rate
$x = ring(period = 1)
$x' = 0
$x[0.5] = 1
$x(0)

# --- a source is a term of its law, not a line of its own
# error: a source is a term of the law now
$x = ring(period = 1)
$x' = 0
$x'[0.5] += 1
$x(0)

# --- ... said any other way, too
# error: a source is a term of the law now
$x = ring(period = 1)
$x' = 0
$x'[0.5] = 1
$x(0)

# --- a field is a function of place: called, not indexed
# error: a field is a function of place
$x = ring(period = 1)
$x' = 0
$x[0.5]

# --- ... and an array is indexed, not called
# error: is no field
$a = [1, 2]
$a(0)

# --- ∇ is of a field, not of its value at a point
# error: are of a field
$v = ring(period = 1)
$i = ring(period = 1)
$v' = -∇$i(0.5)
$i' = -∇$v
$v(0)

# --- δ is a source: it stands in a law
# error: δ is a source
$x = ring(period = 1)
$x' = 0
δ(0.5)

# --- ... multiplying a term of it
# error: δ multiplies a term of the law
$x = ring(period = 1)
$x' = sin(δ(0.5))
$x(0)

# --- ... at one place to a term
# error: one δ to a term
$x = ring(period = 1)
$x' = δ(0.5) * δ(0.6)
$x(0)

# --- ... on a field: plain state is one number
# error: δ is a place on a field
$r = 0
$r' = 1 * δ(0.5)
$r

# --- a source taken away is a force pushing the other way
# expect until 4800: 0
$x = ring(period = 1)
$y = ring(period = 1)
$x' = 0 - (if t < 0.001 then 1000 else 0) * δ(0.5)
$y' = (if t < 0.001 then -1000 else 0) * δ(0.5)
$x(0.5) - $y(0.5)

# --- a push on an array's field adds too
# error: a push adds
$x = array(4)
$x = $x
$x[0.5] = 1
$x(0)

# --- a shaped source: a Gaussian of area 1, so a blow of area 1 stands 1 / (w sqrt(TAU)) high
# expect at 2000: 7
$x = ring(period = 1)
$x' = (if t < 0.001 then 1000 else 0) * δ(0.5, 0.05)
floor($x(0.5))

# --- ... a blow far shorter than a sweep lands whole, all the way across it
# expect at 2000: 4
$x = ring(period = 1)
$x' = (if t < dt then 48000 else 0) * δ(0.5, 0.05)
floor($x(0.55))

# --- ... and nothing lands far from it
# expect at 2000: 0
$x = ring(period = 1)
$x' = (if t < 0.001 then 1000 else 0) * δ(0.5, 0.05)
$x(0.1)

# --- it wraps: a bump on the join shows on both sides
# expect at 2000: 7
$x = ring(period = 1)
$x' = (if t < 0.001 then 1000 else 0) * δ(0, 0.05)
floor($x(0))

# --- `-=` takes away
# expect at 2000: 0
$x = ring(period = 1)
$x' = (if t < 0.001 then 1000 else 0) * δ(0.5, 0.05) - (if t < 0.001 then 1000 else 0) * δ(0.5, 0.05)
$x(0.5)

# --- width 0 is the point: it lands as `$x'[p]` does, off a place as on one
# expect at 2000: 1
$x = ring(period = 1)
$y = ring(period = 1)
$x' = (if t < 0.001 then 1000 else 0) * δ(0.503, 0)
$y' = (if t < 0.001 then 1000 else 0) * δ(0.503)
if abs($x(0.5) - $y(0.5)) < 0.000001 and $x(0.5) > 10 then 1 else 0

# --- very wide it is flat all round, with the same blow
# expect at 2000: 1
$x = ring(period = 1)
$x' = (if t < 0.00051 then 1920 else 0) * δ(0.5, 2)
if abs($x(0.1) - 1) < 0.0001 and abs($x(0.5) - 1) < 0.0001 then 1 else 0

# --- where the copies give way to the series, nothing shows
