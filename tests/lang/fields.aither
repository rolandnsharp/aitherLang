# --- a slope with a name is the words, in every law
# expect at 12000: 1
$x = line(period = 1, ends = fixed)
$v = line(period = 1, ends = fixed)
$y = line(period = 1, ends = fixed)
$w = line(period = 1, ends = fixed)
let pull = slope(slope($x))
