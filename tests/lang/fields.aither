$x' = $v
$w' = slope(slope($y))
$y' = $w
$v'[gauss(0.25, 0.03)] += if t < 0.001 then 1000 else 0
$w'[gauss(0.25, 0.03)] += if t < 0.001 then 1000 else 0
if $v[0.75] == $w[0.75] and abs($v[0.75]) > 1 then 1 else 0

