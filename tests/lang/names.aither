# Names: what a name means where, and errors that say where they are.

# --- an error names the file and line it is on
# error: notDefinedYet (<inline>:5)
# comment line 1
# comment line 2
let foo = 1.0
# comment line 4
let bar = notDefinedYet * foo
foo + bar

# --- a local named like a stdlib def is a value, not that def
# expect: 0.5
play t:
  let swell = 0.5
  ease(swell)
t

# --- a stdlib def passed as a function still works
# expect at 100: -0.07416666666667
play t:
  osc(saw, 220)
t

# --- a play's let can't take another play's name
# error: play block
play bass:
  sin(TAU * phasor(55)) * 0.3
play bagpipes:
  let bass = osc(saw, 55.0)
  bass
bass + bagpipes

# --- nor a play's name declared after it
# error: play block
play bagpipes:
  let bass = osc(saw, 55.0)
  bass
play bass:
  sin(TAU * phasor(55)) * 0.3
bass + bagpipes

# --- nor as state
# error: play block
play bass:
  sin(TAU * phasor(55)) * 0.3
play other:
  $bass = 0.0
  $bass = $bass + 0.01
  $bass
bass + other

# --- a local with its own name is fine
play bass:
  sin(TAU * phasor(55)) * 0.3
play lead:
  let note = 440.0
  sin(TAU * phasor(note)) * 0.3
bass + lead

# --- a play-local table feeds wave
# expect: 220
play pipes:
  let pipeNotes = [220.0, 246.94, 277.18, 293.66]
  wave(1.0, pipeNotes)
pipes

# --- two plays, one local name, two tables
# expect: 440
play a:
  let notes = [110.0, 220.0, 330.0]
  wave(1.0, notes)
play b:
  let notes = [330.0, 440.0, 550.0]
  wave(1.0, notes)
a + b

# --- wave's table holds numbers fixed when it compiles
# error: numeric literal
let tempo = 120.0
play t:
  let notes = [tempo, tempo * 2, tempo * 3]
  wave(1.0, notes)

# --- the choir from the live set compiles (a local swell beside stdlib's swell)
let tempo = 120.0
let celloNotes = [110.0, 146.83, 164.81, 220.0]
play cello:
  let f = wave(tempo / 16, celloNotes)
  sin(TAU * phasor(f)) * 0.3
play choir:
  let cFreq = wave(tempo / 32, celloNotes) * 2.0
  let vib   = 1 + sin(TAU * 0.5) * 0.012
  let saws  = osc(saw, cFreq * vib) + osc(saw, cFreq * vib * 1.005) * 0.5
  let air   = noise() * 0.04
  let raw   = (saws + air) * 0.3
  let f1    = (raw |> bpf(800, 0.5)) * 1.0
  let f2    = (raw |> bpf(1400, 0.55)) * 0.7
  let f3    = (raw |> bpf(2800, 0.6)) * 0.4
  let swell = (1 + sin(TAU * 0.06)) * 0.5
  let env   = ease(swell) * 0.6 + 0.4
  let s = (f1 + f2 + f3) * env |> gain(0.15)
  pan(s, sin(TAU * 0.07) * 0.6)
cello + choir
