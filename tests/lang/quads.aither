# Pairs of pairs (notes/nested-pair-2026-11-05.md): Hamilton's quaternions,
# a pair whose sides are pairs, [[w, x], [y, z]] = w + x i + y j + z k.
# turn, conj, unturn by his product; amplitude his tensor, phase his
# angle, axis his axis; everything else side by side. The expected values
# are from the definitions, worked out apart from aither.

# --- Hamilton's units: ij = k
# expect: 0, 1
let i = [[0, 1], [0, 0]]
let j = [[0, 0], [1, 0]]
let [[w, x], [y, z]] = turn(i, j)
[w + x + y, z]

# --- and ji = -k: the one product in aither where order matters
# expect: 0, -1
let i = [[0, 1], [0, 0]]
let j = [[0, 0], [1, 0]]
let [[w, x], [y, z]] = turn(j, i)
[w + x + y, z]

# --- i i = -1
# expect: -1, 0
let i = [[0, 1], [0, 0]]
let [[w, x], [y, z]] = turn(i, i)
[w, x + y + z]

# --- the product of two: (1 + 2i + 3j + 4k)(0.5 - i + 0.25j + 2k), scalar and i
# expect: -6.25, 5
let q = [[1, 2], [3, 4]]
let r = [[0.5, -1], [0.25, 2]]
let [[w, x], [y, z]] = turn(q, r)
[w, x]

# --- ... j and k
# expect: -6.25, 7.5
let q = [[1, 2], [3, 4]]
let r = [[0.5, -1], [0.25, 2]]
let [[w, x], [y, z]] = turn(q, r)
[y, z]

# --- unturn: q over r, q conj(r) over the size of r squared
# expect: 1.3647058823529412, -0.5647058823529412
let q = [[1, 2], [3, 4]]
let r = [[0.5, -1], [0.25, 2]]
let [[w, x], [y, z]] = unturn(q, r)
[w, x]

# --- unturn undoes turn
# expect: 3, 4
let q = [[1, 2], [3, 4]]
let r = [[0.5, -1], [0.25, 2]]
let [[w, x], [y, z]] = unturn(turn(q, r), r)
[y, z]

# --- conj: the vector part negated (Hamilton's K)
# expect: -2, -3
let [[w, x], [y, z]] = conj([[1, 2], [3, 4]])
[x, y]

# --- amplitude: the tensor, all four
# expect: 5.477225575051661
amplitude([[1, 2], [3, 4]])

# --- phase: Hamilton's angle; axis: his axis, a unit vector
# expect: 0.4, 1
let q = [[cos(0.4), 0], [0, sin(0.4)]]
let [[_, ax], [ay, az]] = axis(q)
[phase(q), az + ax + ay]

# --- a rotation applied, q v conj(q): i turned by twice the angle about k
# expect: 0.6967067093471655, 0.7173560908995228
let q = [[cos(0.4), 0], [0, sin(0.4)]]
let i = [[0, 1], [0, 0]]
let [[_, x], [y, _]] = turn(turn(q, i), conj(q))
[x, y]

# --- indexing gives a half, a pair
# expect: 3, 4
let q = [[1, 2], [3, 4]]
q[1]

# --- side by side: + between two, * by a number
# expect: 3.25, 4
let q = [[1, 2], [3, 4]]
let r = [[0.5, -1], [0.25, 2]]
let [[_, _], [y, _]] = q + r
let [[_, x], [_, _]] = q * 2
[y, x]

# --- a def takes and gives one whole
# expect: 6, 8
def twice(v): v + v
let [[_, _], [y, z]] = twice([[1, 2], [3, 4]])
[y, z]

# --- an if chooses between two
# expect: 1, 4
let q = if t >= 0 then [[1, 2], [3, 4]] else [[0, 0], [0, 0]]
let [[w, _], [_, z]] = q
[w, z]

# --- sum adds them
# expect: 6, 0
let s = sum(3, n => [[n, 0], [0, 0]])
let [[w, x], [_, _]] = s
[w, x]

# --- a file-level one read by two plays
# expect: 1, 4
let q = [[1, 2], [3, 4]]
play a:
  let [[w, _], [_, _]] = q
  w
play b:
  let [[_, _], [_, z]] = q
  z
[a[0], b[0]]

# --- pairs nest once: a pair of pairs of pairs is the octonions, and their product doesn't associate
# error: a pair of pairs of pairs
[[[1, 2], [3, 4]], [[1, 2], [3, 4]]]

# --- a pair and a pair of pairs in + is a stand-in error, naming both and saying it can change
# error: `+` between `q`, a pair of pairs, and `[1, 2]`, a pair
let q = [[1, 2], [3, 4]]
let [[w, _], [_, _]] = q + [1, 2]
[w, w]

# --- the pipe carries a pair: a patch ending in a pair of pairs is a stand-in error
# error: the patch ends in a pair of pairs
[[1, 2], [3, 4]]

# --- turn between a pair of pairs and a pair
# error: turn is given `[[1, 2], [3, 4]]`, a pair of pairs, and `[1, 2]`, a pair
let [[w, _], [_, _]] = turn([[1, 2], [3, 4]], [1, 2])
[w, w]

# --- a filter runs once a number, each its own state: the same as four filters
# expect until 2000: 0, 0
let q = [[sin(TAU * 300 * t), 2], [3, sin(TAU * 50 * t)]]
let [[w, _], [_, z]] = lp1(q, 100)
[w - lp1(sin(TAU * 300 * t), 100), z - lp1(sin(TAU * 50 * t), 100)]

# --- a def given a pair, giving a pair a side, gives a pair of pairs: a doublet as one value
# expect until 2000: 0, 0
let strike = impulse(10)
let [a, b] = dho(strike, [440, 443], 0.01)
[amplitude(a - dho(strike, 440, 0.01)), amplitude(b - dho(strike, 443, 0.01))]

# --- a def that takes numbers, given a pair of pairs, runs once a number
# expect until 2000: 0, 0
let strike = impulse(10)
let [[_, x], [_, z]] = resonator([[strike, strike], [strike, strike * 2]], 300, 4)
[x - resonator(strike, 300, 4), z - resonator(strike * 2, 300, 4)]

# --- state in a def: a rotation kept, turned by another each sample
# expect: 0.99500416527802582, 0.099833416646828155
# expect at 9: 0.54030230586813977, 0.8414709848078965
def keep_turning(r):
  $q = [[1, 0], [0, 0]]
  $q = turn($q, r)
  $q
let [[w, _], [_, z]] = keep_turning([[cos(0.1), 0], [0, sin(0.1)]])
[w, z]

# --- state at the file's level, the same
# expect: 0.99500416527802582, 0.099833416646828155
# expect at 9: 0.54030230586813977, 0.8414709848078965
$q = [[1, 0], [0, 0]]
$q = turn($q, [[cos(0.1), 0], [0, sin(0.1)]])
let [[w, _], [_, z]] = $q
[w, z]

# --- a number put in it fills all four, as it scales all four
# expect: 0.5, 0.5
$q = [[1, 2], [3, 4]]
$q = 0.5
let [[w, _], [_, z]] = $q
[w, z]

# --- a state keeps its first value's shape: a pair of pairs isn't given a pair
# error: is a pair of pairs, and is given a pair
$q = [[1, 0], [0, 0]]
$q = [1, 2]
let [[w, _], [_, _]] = $q
[w, w]

# --- ... nor a pair a pair of pairs
# error: is given a pair of pairs
def f(x):
  $z = [0, 0]
  $z = [[x, 0], [0, 0]]
  $z
f(1)

# --- a filter given a pair of pairs and a pair is a stand-in error, naming them
# error: lp1 is given `[[1, 2], [3, 4]]`, a pair of pairs, and `[100, 200]`, a pair
let [[w, _], [_, _]] = lp1([[1, 2], [3, 4]], [100, 200])
[w, w]

# --- a def that makes a pair from a number, given a pair of pairs, would make a pair of pairs of pairs
# error: pair of pairs of pairs
let [[w, _], [_, _]] = dho(1, [[440, 441], [442, 443]], 0.1)
[w, w]

# --- half of one isn't assigned by index yet
# error: can't be assigned by index yet
$q = [[1, 0], [0, 0]]
$q[0] = [0, 1]
let [[w, _], [_, _]] = $q
[w, w]

# --- a field of rotations: a state array of them, each turned by its own
# expect: 0.98006657784124163, 0.19866933079506122
# expect at 4: 0.54030230586813977, 0.8414709848078965
$f = array(3, [[1, 0], [0, 0]])
each(3, i => $f[i] = turn($f[i], [[cos(0.1 * (i + 1)), 0], [0, sin(0.1 * (i + 1))]]))
let [[w, _], [_, z]] = $f[1]
[w, z]

# --- made by a rule, read by an index known only when it runs
# expect: 3, 30
let a = array(4, i => [[i, 0], [0, i * 10]])
let [[w, _], [_, z]] = a[floor(t * 0 + 3.5)]
[w, z]

# --- a scratch array of them, stored into, and 0 past its end
# expect: 7, 0
let a = array(2, [[0, 0], [0, 0]])
a[1] = [[7, 0], [0, 0]]
let [[w, _], [_, _]] = a[1]
let [[v, _], [_, _]] = a[2]
[w, v]

# --- an array of pairs isn't given a pair of pairs
# error: holds pairs, and is given a pair of pairs
$f = array(2, [0, 0])
$f[0] = [[1, 0], [0, 0]]
$f[0]

# --- nor an array of pairs of pairs a pair
# error: holds pairs of pairs, and is given a pair
$f = array(2, [[0, 0], [0, 0]])
$f[0] = [1, 2]
let [[w, _], [_, _]] = $f[0]
[w, w]

# --- where one number is needed, a pair of pairs says so
# error: needs one number but gets a pair of pairs
let q = [[1, 2], [3, 4]]
if q then 1 else 0

# --- the stdlib has Hamilton's units: i j = k, j k = i, k i = j
# expect: 1, 1
let [[_, _], [_, z]] = turn(i, j)
let [[_, x], [_, _]] = turn(j, k)
[z, x]

# --- ... and k i = j, i j k = -1
# expect: 1, -1
let [[_, _], [y, _]] = turn(k, i)
let [[w, _], [_, _]] = turn(turn(i, j), k)
[y, w]

# --- a patch's own i, j or k comes first: a let, state, a lambda's parameter
# expect: 5, 9
let i = 5
$k = 1
[i, sum(3, j => j) + $k * 3]

# --- ... and a lambda's or a play's own leaves the stdlib's for the rest of the file
# expect: 6, 1
play p:
  let i = 2
  i * 3
let [[_, _], [_, z]] = turn(i, j)
[p[0] + sum(3, k => 0), z]

# --- state in a play is the file's, so it takes the name too
# expect: 4
play p:
  $j = 4
  $j
p[0]

# --- about: a rotation by an angle about a direction; apply turns a direction by it
# expect: 0.69670670934716539, 0.71735609089952279
let [[_, x], [y, _]] = apply(about(k, 0.8), i)
[x, y]

# --- rotations compose right first: a quarter about k (i to j), then a quarter about i (j to k)
# expect: 0, 1
let [[_, _], [y, z]] = apply(turn(about(i, PI / 2), about(k, PI / 2)), i)
[y, z]

# --- ... and the other way round: about i first (i stays), then about k (i to j)
# expect: 1, 0
let [[_, _], [y, z]] = apply(turn(about(k, PI / 2), about(i, PI / 2)), i)
[y, z]

# --- hopf: the way a spinor points, from the pole k; turned a quarter about i, k goes to -j
# expect: -1, 0
let [[_, _], [y, z]] = hopf(about(i, PI / 2))
[y, z]

# --- the double cover: a spinor turned all the way round is negated, and points the same way
# expect: -1, 1
let s = about(i, TAU)
let [[w, _], [_, _]] = s
let [[_, _], [_, z]] = hopf(s)
[w, z]

# --- the units are constants, so a def sees them, as it sees PI
# expect: 0.69670670934716539, 0.71735609089952279
def spun(a): apply(about(k, a), i)
let [[_, x], [y, _]] = spun(0.8)
[x, y]

# --- a def that takes numbers names the arguments it would run on, and their shapes
# error: resonator takes numbers, and is given signal = `[[1, 2], [3, 4]]`, a pair of pairs, and freq = `[300, 301]`, a pair
let [[w, _], [_, _]] = resonator([[1, 2], [3, 4]], [300, 301], 4)
[w, w]

# --- where one number is needed, the error quotes what it got
# error: the condition needs one number but gets a pair of pairs, `q`
let q = [[1, 2], [3, 4]]
if q then 1 else 0

# --- the output's error quotes the expression
# error: the patch ends in a pair of pairs, `turn(q, i) * 0.5`
let q = about(k, 0.3)
turn(q, i) * 0.5

# --- a sum names the term that doesn't fit
# error: term 3 (n = 3) is a number
let s = sum(3, n => if n < 3 then [[n, 0], [0, 0]] else n)
let [[w, _], [_, _]] = s
[w, w]

# --- state read in one play before another writes it: all four numbers start as written
# expect: 3, 4
$q = [[1, 2], [3, 4]]
play a:
  let [[_, _], [y, z]] = $q
  [y, z]
play b:
  $q = $q * 2
  0
a + b * 0
