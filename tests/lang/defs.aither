# Defs and lambdas: parameters, defaults, named arguments, sum and each.

# --- a table argument, two lengths at two call sites
# expect: 0.21
def total(t):
  sum(len(t), i => t[i - 1])
let a = [1.0, 2.0, 3.0]
let b = [10.0, 20.0, 30.0, 40.0, 50.0]
total(a) * 0.01 + total(b) * 0.001

# --- a literal array at the call, and a local array worked out as it runs
# expect: 0.1
def total(t):
  sum(len(t), i => t[i - 1])
play p:
  let x = 0.5
  let r = [x, x * 2, x * 3]
  total([1.0, 2.0, 4.0]) * 0.01 + total(r) * 0.01
p

# --- a def sizes its work by its argument and writes into the caller's state array
# expect at 9: 0.000125
def shift(f, x):
  let n = len(f)
  each(n - 1, j => f[n - 1 - j] = f[n - 2 - j])
  f[0] = x
  f[n - 1]
play p:
  $line = array(4)
  shift($line, t)
p

# --- defaults, positional and named
# expect: 0.04707
def knob(a, k = 2, m = TAU / TAU + 1):
  a * k * m
knob(1) * 0.01 + knob(1, 3) * 0.001 + knob(1, m = 5) * 0.0001 + knob(1, 7, m = 1) * 0.00001

# --- a missing argument
# error: missing 'k'
def f(a, k): a * k
f(1)

# --- a name the def doesn't have
# error: no parameter 'z'
def f(a, k = 1): a * k
f(1, z = 2)

# --- positional arguments come first
# error: before named
def f(a, k = 1): a * k
f(k = 2, 1)

# --- a default can't name a variable
# error: can't use the name
let g = 2
def f(a, k = g): a * k
f(1)

# --- a one-argument builtin takes its argument by position
# error: by position
sin(x = 1)

# --- a builtin's arguments by name compile to the positional call
# expect until 24000: 0
let x = noise() * discharge(impulse(3), 40)
reverb(x, 2, 0.3) - reverb(x, wet = 0.3, rt60 = 2)

# --- the pipe fills the first, signal
# expect until 24000: 0
let x = noise() * discharge(impulse(3), 40)
(x |> reverb(2, 0.3)) - (x |> reverb(rt60 = 2, wet = 0.3))

# --- named filter arguments
# expect until 24000: 0
let x = noise() * discharge(impulse(3), 40)
lpf(x, 800, 0.5) - lpf(x, res = 0.5, cut = 800)

# --- named delay arguments
# expect until 24000: 0
let x = noise() * discharge(impulse(3), 40)
fbdelay(x, 0.25, 1, 0.6) - fbdelay(x, fb = 0.6, time = 0.25, max_time = 1)

# --- a stdlib def's arguments by name
# expect until 24000: 0
let f = impulse(2) * 40000000
dho(f, 440, 0.01) - dho(damp = 0.01, freq = 440, force = f)

# --- wave by name
# expect until 24000: 0
wave(2, [0.1, 0.2, 0.3]) - wave(arr = [0.1, 0.2, 0.3], freq = 2)

# --- phasor and clamp by name
# expect until 24000: 0
clamp(phasor(3) * 2 - 1, -0.5, 0.5) - clamp(phasor(freq = 3) * 2 - 1, h = 0.5, l = -0.5)

# --- a builtin says what it takes
# error: no parameter 'mix' (it takes signal, rt60, wet)
reverb(0, 2, mix = 0.3)

# --- a builtin's missing argument
# error: missing 'rt60'
reverb(0, wet = 0.3)

# --- an argument given twice
# error: given twice
reverb(0, 2, 0.3, rt60 = 1)

# --- a def's parameter shadows a top-level def of the same name (stdlib's inharmonic calls its ratio)
def ratio(n, k): n * k
inharmonic(220, stiff_string, soft_decay, 6) * 0.1 + ratio(1, 0)

# --- sum with a constant body
# expect: 5
sum(5, n => 1.0)

# --- sum counts from 1
# expect: 55
sum(10, n => n)

# --- a lambda sees the lets around it
# expect: 70
let f = 7.0
sum(4, n => f * n)

# --- a lambda sees its def's parameters
# expect: 60
def scaled_sum(base):
  sum(3, n => base * n)
scaled_sum(10.0)

# --- a def parameter given a number is a compile-time count
# expect: 5
def fixed_count(amount):
  sum(amount, n => 1.0)
fixed_count(5)

# --- so is a let of a number
# expect: 8
let H = 8
sum(H, n => 1.0)

# --- each iteration of sum is its own phasor
# expect at 100: -2.2372457999617863
sum(3, n => sin(TAU * phasor(440.0 * n)))

# --- nested sums see the outer index
# expect: 18
sum(3, n => sum(2, m => n * m))

# --- a lambda isn't a value
# error: lambda
let f = n => n * 2
f

# --- sum's count must be known when it compiles
# error: literal
$counter = 3
sum($counter, n => n)

# --- sum takes a lambda, not a def
# error: lambda
def ident_fn(n): n
sum(5, ident_fn)

# --- sum takes two arguments
# error: sum
sum(3)

# --- a two-argument lambda through a def
# expect: 7
def f(g): g(3, 4)
f((a, b) => a + b)

# --- its arguments land in order
# expect: 13
def f(g): g(3, 5)
f((a, b) => a + b * 2)

# --- a lambda body with lets
# expect: 25
def f(g): g(2, 3)
f((a, b) =>
  let s = a + b
  s * s)

# --- parentheses still group
# expect: 20
(2 + 3) * 4

# --- (n) => is n =>
# expect: 21
def f(g): g(7)
f((n) => n * 3)

# --- sum's lambda takes one parameter
# error: one parameter
sum(4, (a, b) => a + b)

# --- a lambda given too few arguments
# error: takes 2 args, got 1
def call1(f): f(2)
call1((a, b) => a * b)

# --- a lambda given more arguments ignores the rest
# expect: 6
def call3(f): f(2, 3, 4)
call3((a, b) => a * b)

# --- a lambda passed on through two defs
# expect: 30
def inner(h): h(10, 20)
def outer(h): inner(h)
outer((a, b) => a + b)

# --- a def sees only its arguments, not the file's lets
# error: sees only its arguments, and 'k' is the file's
let k = 0.25
def f(x): x + k
f(0)

# --- nor the caller's: a name it wasn't given is unknown, whoever calls it
# error: unknown identifier: k
def f(x): x + k
play a:
  let k = 100
  f(0)
a

# --- a constant table is seen everywhere, like TAU
# expect: 3
let table = [1, 2, 3]
def third(x): table[2] * x
third(1)

# --- a lambda sees the names where it was written, not inside the def that calls it
# expect: 5
def apply(g, x):
  let k = 100
  g(x)
play a:
  let k = 4
  apply(x => x + k, 1)
a
